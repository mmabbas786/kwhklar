---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  items: FaqItem[];
}

const { title = 'Häufig gestellte Fragen (FAQ)', items } = Astro.props;
---

{items && items.length > 0 && (
  <section class="my-10">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">{title}</h2>
    <div class="mt-5 space-y-3">
      {items.map((item) => (
        <details class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-5 shadow-2xs transition-all open:border-emerald-400 dark:open:border-emerald-500/40">
          <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-slate-900 dark:text-white group-open:text-emerald-700 dark:group-open:text-emerald-400 text-sm sm:text-base">
            <span>{item.question}</span>
            <span class="ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 transition-transform group-open:rotate-180 group-open:bg-emerald-100 dark:group-open:bg-emerald-950/80 group-open:text-emerald-700 dark:group-open:text-emerald-400">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-3.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed pt-3 border-t border-slate-100 dark:border-slate-800">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
)}
