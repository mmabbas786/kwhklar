---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';
import { languages } from '../../i18n/languages';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const currentYear = new Date().getFullYear();
const homeHref = currentLang === 'de' ? '/' : `/${currentLang}`;
const langInfo = languages[currentLang];
---

<footer class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-slate-900 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-5">
      <!-- Col 1: Brand & Mission -->
      <div class="col-span-2 md:col-span-1 space-y-4">
        <a href={homeHref} class="flex items-center gap-2.5">
          <img
            src="/icon.png"
            alt="kWhKlar Logo"
            width="36"
            height="36"
            class="h-9 w-9 rounded-xl object-contain shadow-xs"
            loading="lazy"
          />
          <span class="text-xl font-bold text-white tracking-tight">kWh<span class="text-emerald-400">Klar</span></span>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed">
          {t('footer.disclaimer')}
        </p>
        <p class="text-[11px] text-slate-500">
          {langInfo.flag} {langInfo.nativeName} ({currentLang})
        </p>
      </div>

      <!-- Col 2: Rechner -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">Rechner</h3>
        <ul class="mt-4 space-y-2 text-xs">
          <li><a href="/stromkosten-rechner" class="hover:text-emerald-400 transition">Stromkostenrechner</a></li>
          <li><a href="/stromverbrauch-rechner" class="hover:text-emerald-400 transition">Stromverbrauch-Rechner</a></li>
          <li><a href="/kwh-rechner" class="hover:text-emerald-400 transition">kWh in Euro Rechner</a></li>
          <li><a href="/watt-rechner" class="hover:text-emerald-400 transition">Watt in kWh Rechner</a></li>
          <li><a href="/stromkosten-pro-stunde" class="hover:text-emerald-400 transition">Kosten pro Stunde</a></li>
          <li><a href="/stromkosten-pro-tag" class="hover:text-emerald-400 transition">Kosten pro Tag</a></li>
          <li><a href="/stromkosten-pro-woche" class="hover:text-emerald-400 transition">Kosten pro Woche</a></li>
          <li><a href="/stromkosten-pro-monat" class="hover:text-emerald-400 transition">Kosten pro Monat</a></li>
          <li><a href="/stromkosten-pro-jahr" class="hover:text-emerald-400 transition">Kosten pro Jahr</a></li>
        </ul>
      </div>

      <!-- Col 3: Geräte -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">Beliebte Geräte</h3>
        <ul class="mt-4 space-y-2 text-xs">
          <li><a href="/geraete" class="hover:text-emerald-400 transition font-medium text-emerald-400">Alle 25+ Geräte</a></li>
          <li><a href="/geraete/kuehlschrank" class="hover:text-emerald-400 transition">Kühlschrank</a></li>
          <li><a href="/geraete/waschmaschine" class="hover:text-emerald-400 transition">Waschmaschine</a></li>
          <li><a href="/geraete/trockner" class="hover:text-emerald-400 transition">Wäschetrockner</a></li>
          <li><a href="/geraete/gaming-pc" class="hover:text-emerald-400 transition">Gaming-PC</a></li>
          <li><a href="/geraete/fernseher" class="hover:text-emerald-400 transition">Fernseher</a></li>
          <li><a href="/geraete/klimaanlage" class="hover:text-emerald-400 transition">Klimaanlage</a></li>
        </ul>
      </div>

      <!-- Col 4: Haushalt & Wissen -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">Haushalt & Wissen</h3>
        <ul class="mt-4 space-y-2 text-xs">
          <li><a href="/durchschnittlicher-stromverbrauch" class="hover:text-emerald-400 transition">Durchschnittsverbrauch</a></li>
          <li><a href="/stromverbrauch-1-person" class="hover:text-emerald-400 transition">1 Person (Single)</a></li>
          <li><a href="/stromverbrauch-2-personen" class="hover:text-emerald-400 transition">2 Personen (Paar)</a></li>
          <li><a href="/stromverbrauch-4-personen" class="hover:text-emerald-400 transition">4 Personen (Familie)</a></li>
          <li><a href="/stromverbrauch-senken" class="hover:text-emerald-400 transition">Stromverbrauch senken</a></li>
          <li><a href="/strompreis" class="hover:text-emerald-400 transition">Strompreis Deutschland</a></li>
          <li><a href="/stromrechnung" class="hover:text-emerald-400 transition">Stromrechnung verstehen</a></li>
          <li><a href="/strom-sparen" class="hover:text-emerald-400 transition">Strom sparen Tipps</a></li>
          <li><a href="/waermepumpe/stromverbrauch" class="hover:text-emerald-400 transition">Wärmepumpe</a></li>
          <li><a href="/e-auto/stromkosten" class="hover:text-emerald-400 transition">E-Auto Ladekosten</a></li>
        </ul>
      </div>

      <!-- Col 5: Transparenz & Rechtliches -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">Info & Recht</h3>
        <ul class="mt-4 space-y-2 text-xs">
          <li><a href={getLocalizedPath('/ueber-uns', currentLang)} class="hover:text-emerald-400 transition">{t('footer.about')}</a></li>
          <li><a href={getLocalizedPath('/quellen-methodik', currentLang)} class="hover:text-emerald-400 transition">{t('footer.sources')}</a></li>
          <li><a href={getLocalizedPath('/kontakt', currentLang)} class="hover:text-emerald-400 transition">{t('footer.contact')}</a></li>
          <li><a href={getLocalizedPath('/impressum', currentLang)} class="hover:text-emerald-400 transition">{t('footer.imprint')}</a></li>
          <li><a href={getLocalizedPath('/datenschutz', currentLang)} class="hover:text-emerald-400 transition">{t('footer.privacy')}</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom line -->
    <div class="mt-12 border-t border-slate-800 pt-6 text-center text-xs text-slate-500">
      <p>© {currentYear} kWhKlar.de — Alle Angaben sind sorgfältig recherchierte Richtwerte und Berechnungen.</p>
    </div>
  </div>
</footer>
