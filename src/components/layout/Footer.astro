---
import { footerNav } from '../../data/navigation';
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-slate-900 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-5">
      <!-- Col 1: Brand & Mission -->
      <div class="col-span-2 md:col-span-1 space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <img
            src="/icon.png"
            alt="kWhKlar Logo"
            width="36"
            height="36"
            class="h-9 w-9 rounded-xl object-contain shadow-xs"
            loading="lazy"
          />
          <span class="text-xl font-bold text-white tracking-tight">kWh<span class="text-emerald-400">Klar</span></span>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed">
          Kostenlose, transparente und werbefreie Rechner für Stromkosten, Stromverbrauch und Energieeffizienz im deutschen Haushalt.
        </p>
        <p class="text-[11px] text-slate-500">
          🇩🇪 Deutschland (DE)
        </p>
      </div>

      <!-- Col 2: Rechner -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">Rechner</h3>
        <ul class="mt-4 space-y-2 text-xs">
          {footerNav.calculators.map((item) => (
            <li><a href={item.href} class="hover:text-emerald-400 transition">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Geräte -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">Beliebte Geräte</h3>
        <ul class="mt-4 space-y-2 text-xs">
          {footerNav.appliances.map((item) => (
            <li><a href={item.href} class="hover:text-emerald-400 transition">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Haushalt & Ratgeber -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">Haushalt & Ratgeber</h3>
        <ul class="mt-4 space-y-2 text-xs">
          {footerNav.household.slice(0, 4).map((item) => (
            <li><a href={item.href} class="hover:text-emerald-400 transition">{item.label}</a></li>
          ))}
          {footerNav.topics.slice(0, 4).map((item) => (
            <li><a href={item.href} class="hover:text-emerald-400 transition">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 5: Über uns & Rechtliches -->
      <div class="col-span-2 md:col-span-1">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">Rechtliches & Info</h3>
        <ul class="mt-4 space-y-2 text-xs">
          {footerNav.legal.map((item) => (
            <li><a href={item.href} class="hover:text-emerald-400 transition">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 border-t border-slate-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} kWhKlar.de — Alle Angaben ohne Gewähr. Berechnungen basieren auf typischen Richtwerten (BNetzA, BDEW, Destatis).</p>
      <div class="flex items-center gap-6">
        <a href="/impressum" class="hover:text-slate-400 transition">Impressum</a>
        <a href="/datenschutz" class="hover:text-slate-400 transition">Datenschutz</a>
        <a href="/kontakt" class="hover:text-slate-400 transition">Kontakt</a>
      </div>
    </div>
  </div>
</footer>
