---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';
import { languages } from '../../i18n/languages';
import { getLocalizedAppliance } from '../../i18n/appliances';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const currentYear = new Date().getFullYear();
const homeHref = currentLang === 'de' ? '/' : `/${currentLang}`;
const langInfo = languages[currentLang];

const fridgeName = getLocalizedAppliance('kuehlschrank', currentLang)?.name || 'Kühlschrank';
const washerName = getLocalizedAppliance('waschmaschine', currentLang)?.name || 'Waschmaschine';
const dryerName = getLocalizedAppliance('trockner', currentLang)?.name || 'Wäschetrockner';
const gamingPcName = getLocalizedAppliance('gaming-pc', currentLang)?.name || 'Gaming-PC';
const tvName = getLocalizedAppliance('fernseher', currentLang)?.name || 'Fernseher';
const acName = getLocalizedAppliance('klimaanlage', currentLang)?.name || 'Klimaanlage';
---

<footer class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-slate-900 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-5">
      <!-- Col 1: Brand & Mission -->
      <div class="col-span-2 md:col-span-1 space-y-4">
        <a href={homeHref} class="flex items-center gap-2.5">
          <img
            src="/icon.png"
            alt="kWhKlar Logo"
            width="36"
            height="36"
            class="h-9 w-9 rounded-xl object-contain shadow-xs"
            loading="lazy"
          />
          <span class="text-xl font-bold text-white tracking-tight">kWh<span class="text-emerald-400">Klar</span></span>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed">
          {t('footer.disclaimer')}
        </p>
        <p class="text-[11px] text-slate-500">
          {langInfo.flag} {langInfo.nativeName} ({currentLang})
        </p>
      </div>

      <!-- Col 2: Rechner -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">{t('footer.calculators') || 'Rechner'}</h3>
        <ul class="mt-4 space-y-2 text-xs">
          <li><a href={getLocalizedPath('/stromkosten-rechner', currentLang)} class="hover:text-emerald-400 transition">{t('cat.cost.title') || 'Stromkostenrechner'}</a></li>
          <li><a href={getLocalizedPath('/kwh-rechner', currentLang)} class="hover:text-emerald-400 transition">{t('cat.kwh.title') || 'kWh in Euro'}</a></li>
          <li><a href={getLocalizedPath('/watt-rechner', currentLang)} class="hover:text-emerald-400 transition">{t('cat.watt.title') || 'Watt in kWh'}</a></li>
          <li><a href={getLocalizedPath('/stromverbrauch-rechner', currentLang)} class="hover:text-emerald-400 transition">{t('cat.cost.title')}</a></li>
          <li><a href={getLocalizedPath('/stromkosten-pro-stunde', currentLang)} class="hover:text-emerald-400 transition">{currentLang === 'en' ? 'Cost per Hour' : currentLang === 'es' ? 'Coste por hora' : currentLang === 'ja' ? '1時間あたりの電気代' : currentLang === 'fr' ? 'Coût par heure' : currentLang === 'pt' ? 'Custo por hora' : currentLang === 'ko' ? '시간당 전기요금' : currentLang === 'it' ? 'Costo all\'ora' : 'Kosten pro Stunde'}</a></li>
          <li><a href={getLocalizedPath('/stromkosten-pro-tag', currentLang)} class="hover:text-emerald-400 transition">{currentLang === 'en' ? 'Cost per Day' : currentLang === 'es' ? 'Coste por día' : currentLang === 'ja' ? '1日あたりの電気代' : currentLang === 'fr' ? 'Coût par jour' : currentLang === 'pt' ? 'Custo por dia' : currentLang === 'ko' ? '하루 전기요금' : currentLang === 'it' ? 'Costo al giorno' : 'Kosten pro Tag'}</a></li>
          <li><a href={getLocalizedPath('/stromkosten-pro-monat', currentLang)} class="hover:text-emerald-400 transition">{currentLang === 'en' ? 'Cost per Month' : currentLang === 'es' ? 'Coste por mes' : currentLang === 'ja' ? '月額電気代' : currentLang === 'fr' ? 'Coût par mois' : currentLang === 'pt' ? 'Custo por mês' : currentLang === 'ko' ? '월간 전기요금' : currentLang === 'it' ? 'Costo al mese' : 'Kosten pro Monat'}</a></li>
          <li><a href={getLocalizedPath('/stromkosten-pro-jahr', currentLang)} class="hover:text-emerald-400 transition">{currentLang === 'en' ? 'Cost per Year' : currentLang === 'es' ? 'Coste por año' : currentLang === 'ja' ? '年間電気代' : currentLang === 'fr' ? 'Coût par an' : currentLang === 'pt' ? 'Custo por ano' : currentLang === 'ko' ? '연간 전기요금' : currentLang === 'it' ? 'Costo all\'anno' : 'Kosten pro Jahr'}</a></li>
        </ul>
      </div>

      <!-- Col 3: Geräte -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">{t('footer.appliances') || 'Beliebte Geräte'}</h3>
        <ul class="mt-4 space-y-2 text-xs">
          <li><a href={getLocalizedPath('/geraete', currentLang)} class="hover:text-emerald-400 transition font-medium text-emerald-400">{t('appliances.view_all') || 'Alle 25+ Geräte'}</a></li>
          <li><a href={getLocalizedPath('/geraete/kuehlschrank', currentLang)} class="hover:text-emerald-400 transition">{fridgeName}</a></li>
          <li><a href={getLocalizedPath('/geraete/waschmaschine', currentLang)} class="hover:text-emerald-400 transition">{washerName}</a></li>
          <li><a href={getLocalizedPath('/geraete/trockner', currentLang)} class="hover:text-emerald-400 transition">{dryerName}</a></li>
          <li><a href={getLocalizedPath('/geraete/gaming-pc', currentLang)} class="hover:text-emerald-400 transition">{gamingPcName}</a></li>
          <li><a href={getLocalizedPath('/geraete/fernseher', currentLang)} class="hover:text-emerald-400 transition">{tvName}</a></li>
          <li><a href={getLocalizedPath('/geraete/klimaanlage', currentLang)} class="hover:text-emerald-400 transition">{acName}</a></li>
        </ul>
      </div>

      <!-- Col 4: Haushalt & Wissen -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">{t('footer.household') || 'Haushalt & Wissen'}</h3>
        <ul class="mt-4 space-y-2 text-xs">
          <li><a href={getLocalizedPath('/stromverbrauch-haushalt', currentLang)} class="hover:text-emerald-400 transition">{t('cat.house.title') || 'Haushalt'}</a></li>
          <li><a href={getLocalizedPath('/stromverbrauch-1-person', currentLang)} class="hover:text-emerald-400 transition">{currentLang === 'en' ? '1 Person (Single)' : currentLang === 'es' ? '1 Persona (Individual)' : currentLang === 'ja' ? '一人暮らし' : currentLang === 'fr' ? '1 Personne (Célibataire)' : currentLang === 'pt' ? '1 Pessoa' : currentLang === 'ko' ? '1인 가구' : currentLang === 'it' ? '1 Persona' : '1 Person (Single)'}</a></li>
          <li><a href={getLocalizedPath('/stromverbrauch-2-personen', currentLang)} class="hover:text-emerald-400 transition">{currentLang === 'en' ? '2 Persons (Couple)' : currentLang === 'es' ? '2 Personas (Pareja)' : currentLang === 'ja' ? '2人世帯' : currentLang === 'fr' ? '2 Personnes (Couple)' : currentLang === 'pt' ? '2 Pessoas' : currentLang === 'ko' ? '2인 가구' : currentLang === 'it' ? '2 Persone' : '2 Personen (Paar)'}</a></li>
          <li><a href={getLocalizedPath('/stromverbrauch-4-personen', currentLang)} class="hover:text-emerald-400 transition">{currentLang === 'en' ? '4 Persons (Family)' : currentLang === 'es' ? '4 Personas (Familia)' : currentLang === 'ja' ? '4人世帯' : currentLang === 'fr' ? '4 Personnes (Famille)' : currentLang === 'pt' ? '4 Pessoas' : currentLang === 'ko' ? '4인 가구' : currentLang === 'it' ? '4 Persone' : '4 Personen (Familie)'}</a></li>
          <li><a href={getLocalizedPath('/strompreis', currentLang)} class="hover:text-emerald-400 transition">{t('nav.price')}</a></li>
          <li><a href={getLocalizedPath('/stromrechnung', currentLang)} class="hover:text-emerald-400 transition">{t('nav.bill')}</a></li>
          <li><a href={getLocalizedPath('/strom-sparen', currentLang)} class="hover:text-emerald-400 transition">{t('nav.saving')}</a></li>
          <li><a href={getLocalizedPath('/standby-strom', currentLang)} class="hover:text-emerald-400 transition">{currentLang === 'en' ? 'Standby Power' : currentLang === 'es' ? 'Consumo en espera' : currentLang === 'ja' ? '待機電力' : currentLang === 'fr' ? 'Consommation de veille' : currentLang === 'pt' ? 'Consumo em standby' : currentLang === 'ko' ? '대기전력 절약' : currentLang === 'it' ? 'Consumi in standby' : 'Standby-Strom'}</a></li>
        </ul>
      </div>

      <!-- Col 5: Transparenz & Rechtliches -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">{t('footer.legal') || 'Info & Recht'}</h3>
        <ul class="mt-4 space-y-2 text-xs">
          <li><a href={getLocalizedPath('/ueber-uns', currentLang)} class="hover:text-emerald-400 transition">{t('footer.about')}</a></li>
          <li><a href={getLocalizedPath('/quellen-methodik', currentLang)} class="hover:text-emerald-400 transition">{t('footer.sources')}</a></li>
          <li><a href={getLocalizedPath('/kontakt', currentLang)} class="hover:text-emerald-400 transition">{t('footer.contact')}</a></li>
          <li><a href={getLocalizedPath('/impressum', currentLang)} class="hover:text-emerald-400 transition">{t('footer.imprint')}</a></li>
          <li><a href={getLocalizedPath('/datenschutz', currentLang)} class="hover:text-emerald-400 transition">{t('footer.privacy')}</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom line -->
    <div class="mt-12 border-t border-slate-800 pt-6 text-center text-xs text-slate-500">
      <p>© {currentYear} kWhKlar.de — All calculations are based on transparent physical formulas and official statistical reference values.</p>
    </div>
  </div>
</footer>
