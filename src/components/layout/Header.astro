---
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const homeHref = currentLang === 'de' ? '/' : `/${currentLang}`;

const navItems = [
  { label: t('nav.calculators'), href: getLocalizedPath('/stromkosten-rechner', currentLang) },
  { label: t('nav.appliances'), href: getLocalizedPath('/geraete', currentLang) },
  { label: t('nav.household'), href: getLocalizedPath('/stromverbrauch-haushalt', currentLang) },
  { label: t('nav.price'), href: getLocalizedPath('/strompreis', currentLang) },
  { label: t('nav.bill'), href: getLocalizedPath('/stromrechnung', currentLang) },
  { label: t('nav.saving'), href: getLocalizedPath('/strom-sparen', currentLang) },
];
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href={homeHref} class="flex items-center gap-2.5 text-slate-900 transition-opacity hover:opacity-90">
      <img
        src="/icon.png"
        alt="kWhKlar Logo"
        width="38"
        height="38"
        class="h-9 w-9 rounded-xl object-contain shadow-xs"
        loading="eager"
      />
      <div class="flex flex-col">
        <span class="text-xl font-bold tracking-tight text-slate-900 leading-none">kWh<span class="text-emerald-600">Klar</span></span>
        <span class="text-[10px] font-medium text-slate-500 uppercase tracking-wider">{t('brand.tagline')}</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-emerald-700"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Actions, Language & Theme Toggle -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Language Picker Dropdown -->
      <LanguagePicker />

      <!-- Modern Aesthetic Theme Switch (Pixel-Perfect Contained Pill) -->
      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle-switch relative inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full transition-colors duration-250 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
        aria-label="Farbschema wechseln"
        title="Farbschema wechseln (Dunkel / Hell)"
      >
        <!-- Sliding Knob -->
        <span class="theme-toggle-knob flex h-5 w-5 items-center justify-center rounded-full shadow-sm transition-transform duration-250 ease-out">
          <!-- Sun Icon (shown in light mode) -->
          <svg class="sun-icon h-3 w-3 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
          </svg>
          <!-- Moon Icon (shown in dark mode) -->
          <svg class="moon-icon hidden h-3 w-3 text-indigo-300" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
          </svg>
        </span>
      </button>

      <a
        href={getLocalizedPath('/stromkosten-rechner', currentLang)}
        class="hidden sm:inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
      >
        {t('nav.cta')}
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex md:hidden items-center justify-center rounded-xl p-2 text-slate-700 hover:bg-slate-100 focus:outline-none"
        aria-label="Hauptmenü öffnen"
        aria-expanded="false"
      >
        <svg id="menu-open-icon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-close-icon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 bg-white px-4 pt-2 pb-6 space-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block rounded-lg px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-50 hover:text-emerald-600"
      >
        {item.label}
      </a>
    ))}
    <div class="pt-4 border-t border-slate-100">
      <a
        href={getLocalizedPath('/stromkosten-rechner', currentLang)}
        class="block w-full text-center rounded-lg bg-emerald-600 px-4 py-2.5 text-base font-semibold text-white shadow-sm hover:bg-emerald-700"
      >
        {t('nav.cta')}
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function initHeaderInteractions() {
    document.addEventListener('click', function (e) {
      // Theme Toggle Click
      var themeBtn = e.target.closest('#theme-toggle');
      if (themeBtn) {
        var isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
          try { sessionStorage.setItem('theme', 'light'); } catch (err) {}
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
          try { sessionStorage.setItem('theme', 'dark'); } catch (err) {}
        }
        return;
      }

      // Mobile Menu Toggle Click
      var mobileBtn = e.target.closest('#mobile-menu-btn');
      if (mobileBtn) {
        var menu = document.getElementById('mobile-menu');
        var openIcon = document.getElementById('menu-open-icon');
        var closeIcon = document.getElementById('menu-close-icon');
        if (menu && openIcon && closeIcon) {
          var isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
          mobileBtn.setAttribute('aria-expanded', String(!isExpanded));
          menu.classList.toggle('hidden');
          openIcon.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');
        }
      }
    });
  })();
</script>
