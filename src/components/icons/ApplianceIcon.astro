---
interface Props {
  name: string;
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { name, class: className = '', size = 'md' } = Astro.props;

const sizeClasses = {
  sm: 'h-4 w-4',
  md: 'h-6 w-6',
  lg: 'h-8 w-8',
  xl: 'h-10 w-10',
};

const iconClass = `${sizeClasses[size]} ${className}`;
const cleanName = (name || '').toLowerCase().trim();
---

{cleanName === 'calculator' || cleanName === 'cost' || cleanName === 'euro' || cleanName === 'stromkosten-rechner' ? (
  <!-- Calculator -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="4" y="2" width="16" height="20" rx="3" />
    <rect x="7" y="5" width="10" height="3.5" rx="1" fill="currentColor" fill-opacity="0.15" />
    <circle cx="8" cy="12" r="1" fill="currentColor" />
    <circle cx="12" cy="12" r="1" fill="currentColor" />
    <circle cx="16" cy="12" r="1" fill="currentColor" />
    <circle cx="8" cy="15.5" r="1" fill="currentColor" />
    <circle cx="12" cy="15.5" r="1" fill="currentColor" />
    <circle cx="16" cy="15.5" r="1" fill="currentColor" />
    <circle cx="8" cy="19" r="1" fill="currentColor" />
    <rect x="11.5" y="18" width="5" height="2" rx="0.5" fill="currentColor" />
  </svg>
) : cleanName === 'kwh' || cleanName === 'bolt' || cleanName === 'energy' || cleanName === 'kwh-rechner' ? (
  <!-- Lightning Bolt Energy -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
  </svg>
) : cleanName === 'watt' || cleanName === 'gauge' || cleanName === 'power' || cleanName === 'watt-rechner' ? (
  <!-- Power Gauge / Meter -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 10-9-9c0 2.2.8 4.2 2.1 5.8L12 12" />
    <circle cx="12" cy="12" r="2" fill="currentColor" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 12l4.5-4.5M8 6h.01M16 6h.01M19 12h.01" />
  </svg>
) : cleanName === 'household' || cleanName === 'house' || cleanName === 'home' || cleanName === 'stromverbrauch-haushalt' ? (
  <!-- House -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 10.5L12 3l9 7.5V20a1.5 1.5 0 01-1.5 1.5H4.5A1.5 1.5 0 013 20v-9.5z" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 21v-7a1 1 0 011-1h4a1 1 0 011 1v7" />
  </svg>
) : cleanName === 'kuehlschrank' || cleanName === 'fridge' ? (
  <!-- Refrigerator -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="5" y="2" width="14" height="20" rx="2.5" />
    <line x1="5" y1="9" x2="19" y2="9" />
    <line x1="8" y1="5.5" x2="8" y2="7.5" stroke-linecap="round" stroke-width="2" />
    <line x1="8" y1="12" x2="8" y2="15" stroke-linecap="round" stroke-width="2" />
  </svg>
) : cleanName === 'waschmaschine' || cleanName === 'washer' ? (
  <!-- Washing Machine -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="4" y="2" width="16" height="20" rx="2.5" />
    <circle cx="12" cy="13" r="4.5" />
    <circle cx="12" cy="13" r="2.5" fill="currentColor" fill-opacity="0.15" />
    <circle cx="7" cy="5.5" r="1" fill="currentColor" />
    <line x1="12" y1="5.5" x2="17" y2="5.5" stroke-linecap="round" />
  </svg>
) : cleanName === 'trockner' || cleanName === 'dryer' ? (
  <!-- Tumble Dryer -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="4" y="2" width="16" height="20" rx="2.5" />
    <circle cx="12" cy="13" r="4.5" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M10 12c.5-1 1.5-1 2 0s1.5 1 2 0" />
    <circle cx="7" cy="5.5" r="1" fill="currentColor" />
    <circle cx="10" cy="5.5" r="1" fill="currentColor" />
    <line x1="14" y1="5.5" x2="17" y2="5.5" stroke-linecap="round" />
  </svg>
) : cleanName === 'geschirrspueler' || cleanName === 'dishwasher' ? (
  <!-- Dishwasher -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="4" y="2" width="16" height="20" rx="2.5" />
    <line x1="4" y1="7" x2="20" y2="7" />
    <circle cx="7" cy="4.5" r="0.8" fill="currentColor" />
    <circle cx="10" cy="4.5" r="0.8" fill="currentColor" />
    <circle cx="17" cy="4.5" r="1" />
    <path stroke-linecap="round" d="M7 11h10M7 15h10M8 18.5h8" />
  </svg>
) : cleanName === 'backofen' || cleanName === 'oven' ? (
  <!-- Oven -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="3" y="3" width="18" height="18" rx="2.5" />
    <line x1="3" y1="8" x2="21" y2="8" />
    <circle cx="6.5" cy="5.5" r="1" fill="currentColor" />
    <circle cx="12" cy="5.5" r="1" fill="currentColor" />
    <circle cx="17.5" cy="5.5" r="1" fill="currentColor" />
    <rect x="6" y="10.5" width="12" height="8" rx="1.5" stroke-dasharray="2 1" />
    <line x1="8" y1="14.5" x2="16" y2="14.5" stroke-linecap="round" />
  </svg>
) : cleanName === 'herd' || cleanName === 'induction' || cleanName === 'stove' ? (
  <!-- Induction Hob / Stove -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="3" y="4" width="18" height="16" rx="2.5" />
    <circle cx="8" cy="9.5" r="2.5" />
    <circle cx="16" cy="9.5" r="2.5" />
    <circle cx="8" cy="15" r="1.8" />
    <circle cx="16" cy="15" r="1.8" />
    <circle cx="12" cy="17.5" r="0.8" fill="currentColor" />
  </svg>
) : cleanName === 'wasserkocher' || cleanName === 'kettle' ? (
  <!-- Electric Kettle -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 8h10l1.5 10a1.5 1.5 0 01-1.5 1.5H6A1.5 1.5 0 014.5 18L6 8z" />
    <path stroke-linecap="round" d="M16 10h2.5a2 2 0 012 2v2a2 2 0 01-2 2H16" />
    <path stroke-linecap="round" d="M9 4c0 1.5 2 2 2 3.5M13 4c0 1.5 2 2 2 3.5" stroke-dasharray="1 1" />
    <line x1="3" y1="21" x2="19" y2="21" stroke-linecap="round" />
  </svg>
) : cleanName === 'kaffeemaschine' || cleanName === 'coffee' ? (
  <!-- Coffee Machine -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 3h14v4a2 2 0 01-2 2H7a2 2 0 01-2-2V3z" />
    <path stroke-linecap="round" d="M6 9v11a1 1 0 001 1h10a1 1 0 001-1V9" />
    <rect x="9" y="14" width="6" height="5" rx="1" />
    <path stroke-linecap="round" d="M15 15.5h1.5a1 1 0 011 1v1a1 1 0 01-1 1H15" />
    <line x1="12" y1="9" x2="12" y2="12" stroke-linecap="round" />
  </svg>
) : cleanName === 'fernseher' || cleanName === 'tv' ? (
  <!-- Smart TV -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="3" y="4" width="18" height="13" rx="2" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M8 20h8M12 17v3" />
  </svg>
) : cleanName === 'gamingpc' || cleanName === 'gaming-pc' ? (
  <!-- Gaming PC Tower -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="5" y="2" width="14" height="20" rx="2" />
    <circle cx="12" cy="7" r="2.5" stroke-dasharray="2 1" />
    <circle cx="12" cy="13" r="2.5" stroke-dasharray="2 1" />
    <line x1="8" y1="18" x2="16" y2="18" stroke-linecap="round" />
    <circle cx="12" cy="3.5" r="0.6" fill="currentColor" />
  </svg>
) : cleanName === 'pc' ? (
  <!-- Desktop Computer -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="3" y="3" width="13" height="11" rx="1.5" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17h5M9.5 14v3" />
    <rect x="18" y="5" width="4" height="14" rx="1" />
    <line x1="19.5" y1="8" x2="20.5" y2="8" stroke-linecap="round" />
  </svg>
) : cleanName === 'laptop' ? (
  <!-- Laptop -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="5" y="4" width="14" height="10" rx="1.5" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M2 17.5h20a1 1 0 01-1 1H3a1 1 0 01-1-1z" />
    <line x1="10" y1="17.5" x2="14" y2="17.5" stroke-linecap="round" stroke-width="2" />
  </svg>
) : cleanName === 'monitor' ? (
  <!-- Computer Monitor -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="2" y="3" width="20" height="13" rx="2" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v4M8 20h8" />
  </svg>
) : cleanName === 'ps5' || cleanName === 'xbox' || cleanName === 'console' ? (
  <!-- Game Console Controller -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 11h12l1 7a2 2 0 01-2 2h-1l-2-4H10l-2 4H7a2 2 0 01-2-2l1-7z" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 11a3 3 0 013-3h6a3 3 0 013 3" />
    <circle cx="8.5" cy="13.5" r="1" fill="currentColor" />
    <circle cx="15.5" cy="13.5" r="1" fill="currentColor" />
  </svg>
) : cleanName === 'klimaanlage' || cleanName === 'ac' ? (
  <!-- Air Conditioner -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="3" y="4" width="18" height="8" rx="2" />
    <line x1="6" y1="8" x2="18" y2="8" stroke-linecap="round" stroke-dasharray="3 2" />
    <circle cx="17.5" cy="6" r="0.7" fill="currentColor" />
    <path stroke-linecap="round" d="M6 16c1.5 1 2.5 1 4 0s2.5-1 4 0 2.5 1 4 0M7 19c1.5 1 2.5 1 4 0s2.5-1 4 0" />
  </svg>
) : cleanName === 'ventilator' || cleanName === 'fan' ? (
  <!-- Pedestal Fan -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <circle cx="12" cy="8.5" r="6" />
    <circle cx="12" cy="8.5" r="1.5" fill="currentColor" />
    <path stroke-linecap="round" d="M12 2.5c2 2 2 4 0 6s-2 4 0 6M6 8.5c2-2 4-2 6 0s4 2 6 0" />
    <line x1="12" y1="14.5" x2="12" y2="21" />
    <line x1="8" y1="21" x2="16" y2="21" stroke-linecap="round" />
  </svg>
) : cleanName === 'heizluefter' || cleanName === 'heater' ? (
  <!-- Fan Heater -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="4" y="3" width="16" height="16" rx="3" />
    <circle cx="12" cy="11" r="5" />
    <path stroke-linecap="round" d="M10 9c.5-1 1.5-1 2 0s1.5 1 2 0M10 13c.5-1 1.5-1 2 0s1.5 1 2 0" />
    <line x1="8" y1="21" x2="16" y2="21" stroke-linecap="round" />
  </svg>
) : cleanName === 'luftentfeuchter' || cleanName === 'dehumidifier' ? (
  <!-- Dehumidifier with Water Drop -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="5" y="2" width="14" height="20" rx="3" />
    <line x1="8" y1="6" x2="16" y2="6" stroke-linecap="round" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 11c-1.5 2-2.5 3-2.5 4.5a2.5 2.5 0 005 0c0-1.5-1-2.5-2.5-4.5z" fill="currentColor" fill-opacity="0.2" />
  </svg>
) : cleanName === 'aquarium' ? (
  <!-- Aquarium Fish Tank -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path stroke-linecap="round" d="M3 11c3 1 6-1 9 0s6 1 9 0" stroke-dasharray="2 1" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M13 14c2-1 3 0 4-1-1 2-2 2-4 1z" fill="currentColor" />
  </svg>
) : cleanName === 'pool' ? (
  <!-- Swimming Pool -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" d="M7 3v8M11 3v8M7 6h4M7 9h4" />
    <path stroke-linecap="round" d="M3 15c2.5 1 4.5-1 7 0s4.5 1 7 0 3-1 4 0M3 19c2.5 1 4.5-1 7 0s4.5 1 7 0 3-1 4 0" />
  </svg>
) : cleanName === 'whirlpool' || cleanName === 'hottub' ? (
  <!-- Hot Tub Jacuzzi -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18v5a4 4 0 01-4 4H7a4 4 0 01-4-4v-5z" />
    <path stroke-linecap="round" d="M7 6c0 1.5 1.5 2 1.5 3M12 4c0 1.5 1.5 2 1.5 3M16.5 6c0 1.5 1.5 2 1.5 3" />
  </svg>
) : cleanName === '3d-drucker' || cleanName === '3dprinter' ? (
  <!-- 3D Printer -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="4" y="3" width="16" height="18" rx="2" />
    <line x1="4" y1="9" x2="20" y2="9" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m-2 0h4l-2 2z" fill="currentColor" />
    <rect x="8" y="16" width="8" height="3" rx="0.5" fill="currentColor" fill-opacity="0.2" />
  </svg>
) : cleanName === 'nas' ? (
  <!-- NAS Storage -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="4" y="4" width="16" height="16" rx="2" />
    <rect x="7" y="7" width="4" height="10" rx="1" stroke-dasharray="2 1" />
    <rect x="13" y="7" width="4" height="10" rx="1" stroke-dasharray="2 1" />
    <circle cx="9" cy="18.5" r="0.6" fill="currentColor" />
    <circle cx="15" cy="18.5" r="0.6" fill="currentColor" />
  </svg>
) : cleanName === 'server' ? (
  <!-- Rack Server -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="3" y="3" width="18" height="5.5" rx="1" />
    <rect x="3" y="9.5" width="18" height="5.5" rx="1" />
    <rect x="3" y="16" width="18" height="5.5" rx="1" />
    <circle cx="6" cy="5.7" r="0.8" fill="currentColor" />
    <circle cx="6" cy="12.2" r="0.8" fill="currentColor" />
    <circle cx="6" cy="18.7" r="0.8" fill="currentColor" />
    <line x1="14" y1="5.7" x2="18" y2="5.7" stroke-linecap="round" />
    <line x1="14" y1="12.2" x2="18" y2="12.2" stroke-linecap="round" />
    <line x1="14" y1="18.7" x2="18" y2="18.7" stroke-linecap="round" />
  </svg>
) : (
  <!-- Default Fallback Energy Bolt -->
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
  </svg>
)}
