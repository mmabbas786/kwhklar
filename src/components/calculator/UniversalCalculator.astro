---
import { formatEuro, formatKwh } from '../../lib/formatters';

interface Props {
  defaultWatt?: number;
  defaultHours?: number;
  defaultPriceCt?: number;
  defaultDaysPerWeek?: number;
  title?: string;
  subtitle?: string;
  applianceName?: string;
  showPresets?: boolean;
}

const {
  defaultWatt = 1000,
  defaultHours = 1,
  defaultPriceCt = 35.0,
  defaultDaysPerWeek = 7,
  title = 'Live Stromkostenrechner',
  subtitle = 'Berechne Stromverbrauch (kWh) und Stromkosten (€) präzise für jede Nutzungsdauer.',
  applianceName,
  showPresets = true,
} = Astro.props;

const initialKwhDay = (defaultWatt * defaultHours) / 1000;
const initialCostDay = initialKwhDay * (defaultPriceCt / 100);
const initialKwhYear = initialKwhDay * ((defaultDaysPerWeek / 7) * 365);
const initialCostYear = initialKwhYear * (defaultPriceCt / 100);
const initialCostMonth = initialCostYear / 12;
---

<div class="calculator-container mx-auto my-8 max-w-4xl rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/95 p-6 sm:p-8 shadow-md dark:shadow-2xl dark:shadow-emerald-950/20">
  <!-- Header -->
  <div class="mb-6">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
        {title}
      </h2>
      <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 dark:bg-emerald-950/80 px-3 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Live-Berechnung
      </span>
    </div>
    <p class="mt-1.5 text-sm text-slate-600 dark:text-slate-300">
      {subtitle}
      {applianceName && <span class="block text-xs text-emerald-600 dark:text-emerald-400 mt-1 font-medium">Berechnung abgestimmt auf: {applianceName}</span>}
    </p>
  </div>

  <!-- Presets -->
  {showPresets && (
    <div class="mb-6 pb-6 border-b border-slate-100 dark:border-slate-800">
      <span class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider block mb-2">
        Schnellwahl / Typische Leistung:
      </span>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="preset-btn rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-emerald-400 dark:hover:border-emerald-500 hover:bg-emerald-50 dark:hover:bg-slate-700 hover:text-emerald-800 dark:hover:text-emerald-300 transition cursor-pointer" data-watt="60" data-hours="6">💡 60 W (Beleuchtung)</button>
        <button type="button" class="preset-btn rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-emerald-400 dark:hover:border-emerald-500 hover:bg-emerald-50 dark:hover:bg-slate-700 hover:text-emerald-800 dark:hover:text-emerald-300 transition cursor-pointer" data-watt="120" data-hours="4">📺 120 W (Fernseher)</button>
        <button type="button" class="preset-btn rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-emerald-400 dark:hover:border-emerald-500 hover:bg-emerald-50 dark:hover:bg-slate-700 hover:text-emerald-800 dark:hover:text-emerald-300 transition cursor-pointer" data-watt="400" data-hours="3">🎮 400 W (Gaming-PC)</button>
        <button type="button" class="preset-btn rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-emerald-400 dark:hover:border-emerald-500 hover:bg-emerald-50 dark:hover:bg-slate-700 hover:text-emerald-800 dark:hover:text-emerald-300 transition cursor-pointer" data-watt="1000" data-hours="1">⚡ 1.000 W (1 kW)</button>
        <button type="button" class="preset-btn rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-emerald-400 dark:hover:border-emerald-500 hover:bg-emerald-50 dark:hover:bg-slate-700 hover:text-emerald-800 dark:hover:text-emerald-300 transition cursor-pointer" data-watt="2000" data-hours="1">🧺 2.000 W (Waschmaschine)</button>
      </div>
    </div>
  )}

  <div class="grid gap-8 lg:grid-cols-12 items-start">
    <!-- Input Column -->
    <div class="space-y-6 lg:col-span-7">
      <!-- Watt Input -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="calc-watt" class="text-sm font-semibold text-slate-900 dark:text-white">
            Leistung des Geräts
          </label>
          <span id="watt-kw-preview" class="text-xs font-mono font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded-md">
            {(defaultWatt / 1000).toFixed(2)} kW
          </span>
        </div>
        <div class="relative rounded-2xl shadow-xs">
          <input
            type="number"
            id="calc-watt"
            min="1"
            max="50000"
            step="1"
            value={defaultWatt}
            class="block w-full rounded-2xl border border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/80 px-4 py-3 text-slate-900 dark:text-white text-base font-semibold focus:border-emerald-500 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring-3 focus:ring-emerald-500/20 transition pr-16"
          />
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
            <span class="text-xs font-medium text-slate-500 dark:text-slate-400">Watt</span>
          </div>
        </div>
        <input
          type="range"
          id="calc-watt-slider"
          min="10"
          max="3500"
          step="10"
          value={defaultWatt <= 3500 ? defaultWatt : 3500}
          class="mt-2 w-full accent-emerald-600 cursor-pointer h-1.5 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none"
        />
      </div>

      <!-- Hours Input -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="calc-hours" class="text-sm font-semibold text-slate-900 dark:text-white">
            Nutzungsdauer pro Tag
          </label>
          <span id="hours-display" class="text-xs font-mono font-medium text-slate-600 dark:text-slate-300">
            {defaultHours} h/Tag
          </span>
        </div>
        <div class="relative rounded-2xl shadow-xs">
          <input
            type="number"
            id="calc-hours"
            min="0.1"
            max="24"
            step="0.1"
            value={defaultHours}
            class="block w-full rounded-2xl border border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/80 px-4 py-3 text-slate-900 dark:text-white text-base font-semibold focus:border-emerald-500 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring-3 focus:ring-emerald-500/20 transition pr-20"
          />
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
            <span class="text-xs font-medium text-slate-500 dark:text-slate-400">h/Tag</span>
          </div>
        </div>
        <input
          type="range"
          id="calc-hours-slider"
          min="0.1"
          max="24"
          step="0.1"
          value={defaultHours}
          class="mt-2 w-full accent-emerald-600 cursor-pointer h-1.5 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none"
        />
      </div>

      <!-- Price Input -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="calc-price" class="text-sm font-semibold text-slate-900 dark:text-white">
            Strompreis (Arbeitspreis)
          </label>
          <span class="text-xs text-slate-500 dark:text-slate-400">
            Referenz: 35 ct/kWh
          </span>
        </div>
        <div class="relative rounded-2xl shadow-xs">
          <input
            type="number"
            id="calc-price"
            min="1"
            max="150"
            step="0.1"
            value={defaultPriceCt}
            class="block w-full rounded-2xl border border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/80 px-4 py-3 text-slate-900 dark:text-white text-base font-semibold focus:border-emerald-500 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring-3 focus:ring-emerald-500/20 transition pr-20"
          />
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
            <span class="text-xs font-medium text-slate-500 dark:text-slate-400">ct/kWh</span>
          </div>
        </div>
        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">
          Tipp: Den genauen Arbeitspreis findest du auf deiner letzten Stromrechnung.
        </p>
      </div>

      <!-- Advanced Options Accordion -->
      <details class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 p-4 transition">
        <summary class="flex cursor-pointer items-center justify-between text-xs font-semibold text-slate-700 dark:text-slate-300 group-open:text-emerald-600 dark:group-open:text-emerald-400">
          <span>Erweiterte Optionen (Tage/Woche & Grundpreis)</span>
          <svg class="h-4 w-4 transition transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="mt-4 space-y-4 pt-3 border-t border-slate-200/60 dark:border-slate-700/60 text-xs">
          <div>
            <label for="calc-days-week" class="block font-medium text-slate-700 dark:text-slate-300 mb-1">
              Nutzungstage pro Woche:
            </label>
            <select
              id="calc-days-week"
              class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-slate-900 dark:text-white"
            >
              <option value="7" selected={defaultDaysPerWeek === 7}>Täglich (7 Tage / Woche)</option>
              <option value="5" selected={defaultDaysPerWeek === 5}>Werktags (5 Tage / Woche)</option>
              <option value="3" selected={defaultDaysPerWeek === 3}>3 Tage / Woche</option>
              <option value="2" selected={defaultDaysPerWeek === 2}>Wochenende (2 Tage / Woche)</option>
              <option value="1" selected={defaultDaysPerWeek === 1}>1 Tag / Woche</option>
            </select>
          </div>
          <div>
            <label for="calc-base-fee" class="block font-medium text-slate-700 dark:text-slate-300 mb-1">
              Monatlicher Grundpreis (optional):
            </label>
            <div class="relative">
              <input
                type="number"
                id="calc-base-fee"
                min="0"
                max="50"
                step="0.5"
                value="0"
                placeholder="0.00"
                class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-slate-900 dark:text-white pr-12"
              />
              <span class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400">€/Monat</span>
            </div>
          </div>
        </div>
      </details>

      <!-- Action Buttons -->
      <div class="flex gap-3 pt-2">
        <button
          type="button"
          id="btn-reset"
          class="flex-1 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition cursor-pointer"
        >
          Zurücksetzen
        </button>
        <button
          type="button"
          id="btn-copy"
          class="flex-1 rounded-xl bg-slate-800 dark:bg-slate-700 px-4 py-2.5 text-xs font-semibold text-white hover:bg-slate-700 dark:hover:bg-slate-600 transition flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span id="copy-btn-text">Ergebnis kopieren</span>
        </button>
      </div>
    </div>

    <!-- Output / Result Column -->
    <div class="lg:col-span-5 rounded-2xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-6 text-white shadow-xl border border-slate-800 flex flex-col justify-between h-full">
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-slate-700/60">
          <span class="text-xs font-medium uppercase tracking-wider text-slate-400">Berechnungsergebnis</span>
          <span id="calc-summary-badge" class="text-[11px] font-mono text-emerald-400 bg-emerald-950/80 border border-emerald-800/60 px-2 py-0.5 rounded-full">
            {defaultWatt} W • {defaultHours} h/Tag
          </span>
        </div>

        <!-- Primary Highlight: Month & Year -->
        <div class="my-6 space-y-4">
          <div class="bg-slate-800/80 rounded-2xl p-4 border border-slate-700/50">
            <span class="text-xs text-slate-400 block mb-1">Monatliche Stromkosten</span>
            <div class="flex items-baseline justify-between">
              <span id="res-cost-month" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                {formatEuro(initialCostMonth)}
              </span>
              <span id="res-kwh-month" class="text-xs font-mono text-emerald-400">
                {formatKwh(initialKwhYear / 12)} / Monat
              </span>
            </div>
          </div>

          <div class="bg-slate-800/80 rounded-2xl p-4 border border-slate-700/50">
            <span class="text-xs text-slate-400 block mb-1">Jährliche Stromkosten</span>
            <div class="flex items-baseline justify-between">
              <span id="res-cost-year" class="text-2xl sm:text-3xl font-bold text-emerald-400 tracking-tight">
                {formatEuro(initialCostYear)}
              </span>
              <span id="res-kwh-year" class="text-xs font-mono text-slate-300">
                {formatKwh(initialKwhYear)} / Jahr
              </span>
            </div>
          </div>
        </div>

        <!-- Secondary Breakdown Grid -->
        <div class="grid grid-cols-3 gap-2 text-center pt-2 border-t border-slate-700/60">
          <div class="p-2.5 rounded-xl bg-slate-800/40">
            <span class="text-[10px] text-slate-400 block uppercase">Pro Stunde</span>
            <span id="res-cost-hour" class="text-sm font-bold text-white block mt-0.5">
              {formatEuro(initialCostDay / (defaultHours || 1))}
            </span>
            <span id="res-kwh-hour" class="text-[10px] font-mono text-slate-400 block">
              {(defaultWatt / 1000).toFixed(3)} kWh
            </span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-800/40">
            <span class="text-[10px] text-slate-400 block uppercase">Pro Tag</span>
            <span id="res-cost-day" class="text-sm font-bold text-white block mt-0.5">
              {formatEuro(initialCostDay)}
            </span>
            <span id="res-kwh-day" class="text-[10px] font-mono text-slate-400 block">
              {formatKwh(initialKwhDay)}
            </span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-800/40">
            <span class="text-[10px] text-slate-400 block uppercase">Pro Woche</span>
            <span id="res-cost-week" class="text-sm font-bold text-white block mt-0.5">
              {formatEuro(initialCostYear / 52.1429)}
            </span>
            <span id="res-kwh-week" class="text-[10px] font-mono text-slate-400 block">
              {formatKwh(initialKwhYear / 52.1429)}
            </span>
          </div>
        </div>
      </div>

      <!-- Formula Footnote -->
      <div class="mt-6 pt-4 border-t border-slate-700/60 text-[11px] text-slate-400 leading-relaxed">
        <span class="font-semibold text-slate-300">Formel:</span>
        <code class="bg-slate-800 px-1.5 py-0.5 rounded text-emerald-300 font-mono">kWh = Watt × Stunden ÷ 1.000</code> &nbsp;•&nbsp;
        <code class="bg-slate-800 px-1.5 py-0.5 rounded text-emerald-300 font-mono">Kosten = kWh × Arbeitspreis</code>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function initCalculator() {
    const wattInput = document.getElementById('calc-watt');
    const wattSlider = document.getElementById('calc-watt-slider');
    const hoursInput = document.getElementById('calc-hours');
    const hoursSlider = document.getElementById('calc-hours-slider');
    const priceInput = document.getElementById('calc-price');
    const daysSelect = document.getElementById('calc-days-week');
    const baseFeeInput = document.getElementById('calc-base-fee');

    const resCostMonth = document.getElementById('res-cost-month');
    const resKwhMonth = document.getElementById('res-kwh-month');
    const resCostYear = document.getElementById('res-cost-year');
    const resKwhYear = document.getElementById('res-kwh-year');
    const resCostHour = document.getElementById('res-cost-hour');
    const resKwhHour = document.getElementById('res-kwh-hour');
    const resCostDay = document.getElementById('res-cost-day');
    const resKwhDay = document.getElementById('res-kwh-day');
    const resCostWeek = document.getElementById('res-cost-week');
    const resKwhWeek = document.getElementById('res-kwh-week');
    const summaryBadge = document.getElementById('calc-summary-badge');
    const wattKwPreview = document.getElementById('watt-kw-preview');
    const hoursDisplay = document.getElementById('hours-display');

    const resetBtn = document.getElementById('btn-reset');
    const copyBtn = document.getElementById('btn-copy');
    const copyBtnText = document.getElementById('copy-btn-text');

    if (!wattInput || !hoursInput || !priceInput) return;

    function formatGermanEuro(num) {
      return new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(num);
    }

    function formatGermanKwh(num) {
      return new Intl.NumberFormat('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 2 }).format(num) + ' kWh';
    }

    function recalculate() {
      const watt = Math.max(0, parseFloat(wattInput.value) || 0);
      const hours = Math.min(24, Math.max(0, parseFloat(hoursInput.value) || 0));
      const priceCt = Math.max(0, parseFloat(priceInput.value) || 0);
      const priceEuro = priceCt / 100;
      const daysPerWeek = parseFloat(daysSelect ? daysSelect.value : '7') || 7;
      const baseFeeMonth = parseFloat(baseFeeInput ? baseFeeInput.value : '0') || 0;

      if (wattKwPreview) wattKwPreview.textContent = (watt / 1000).toFixed(2) + ' kW';
      if (hoursDisplay) hoursDisplay.textContent = hours + ' h/Tag';
      if (summaryBadge) summaryBadge.textContent = watt + ' W • ' + hours + ' h/Tag';

      const kwhHour = watt / 1000;
      const costHour = kwhHour * priceEuro;

      const kwhDay = kwhHour * hours;
      const costDay = kwhDay * priceEuro;

      const kwhWeek = kwhDay * daysPerWeek;
      const costWeek = kwhWeek * priceEuro;

      const kwhYear = kwhDay * (daysPerWeek / 7) * 365;
      const costYear = (kwhYear * priceEuro) + (baseFeeMonth * 12);
      const costMonth = costYear / 12;
      const kwhMonth = kwhYear / 12;

      if (resCostMonth) resCostMonth.textContent = formatGermanEuro(costMonth);
      if (resKwhMonth) resKwhMonth.textContent = formatGermanKwh(kwhMonth) + ' / Monat';
      if (resCostYear) resCostYear.textContent = formatGermanEuro(costYear);
      if (resKwhYear) resKwhYear.textContent = formatGermanKwh(kwhYear) + ' / Jahr';

      if (resCostHour) resCostHour.textContent = formatGermanEuro(costHour);
      if (resKwhHour) resKwhHour.textContent = (watt / 1000).toFixed(3) + ' kWh';
      if (resCostDay) resCostDay.textContent = formatGermanEuro(costDay);
      if (resKwhDay) resKwhDay.textContent = formatGermanKwh(kwhDay);
      if (resCostWeek) resCostWeek.textContent = formatGermanEuro(costWeek);
      if (resKwhWeek) resKwhWeek.textContent = formatGermanKwh(kwhWeek);
    }

    // Event listeners
    wattInput.addEventListener('input', () => {
      if (wattSlider) wattSlider.value = Math.min(3500, parseFloat(wattInput.value) || 0);
      recalculate();
    });

    if (wattSlider) {
      wattSlider.addEventListener('input', () => {
        wattInput.value = wattSlider.value;
        recalculate();
      });
    }

    hoursInput.addEventListener('input', () => {
      if (hoursSlider) hoursSlider.value = hoursInput.value;
      recalculate();
    });

    if (hoursSlider) {
      hoursSlider.addEventListener('input', () => {
        hoursInput.value = hoursSlider.value;
        recalculate();
      });
    }

    priceInput.addEventListener('input', recalculate);
    if (daysSelect) daysSelect.addEventListener('change', recalculate);
    if (baseFeeInput) baseFeeInput.addEventListener('input', recalculate);

    // Presets
    document.querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const w = target.getAttribute('data-watt');
        const h = target.getAttribute('data-hours');
        if (w) {
          wattInput.value = w;
          if (wattSlider) wattSlider.value = Math.min(3500, parseFloat(w));
        }
        if (h) {
          hoursInput.value = h;
          if (hoursSlider) hoursSlider.value = h;
        }
        recalculate();
      });
    });

    // Reset button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        wattInput.value = '1000';
        if (wattSlider) wattSlider.value = '1000';
        hoursInput.value = '1';
        if (hoursSlider) hoursSlider.value = '1';
        priceInput.value = '35.0';
        if (daysSelect) daysSelect.value = '7';
        if (baseFeeInput) baseFeeInput.value = '0';
        recalculate();
      });
    }

    // Copy button
    if (copyBtn && copyBtnText) {
      copyBtn.addEventListener('click', () => {
        const watt = wattInput.value;
        const hours = hoursInput.value;
        const price = priceInput.value;
        const monthCost = resCostMonth ? resCostMonth.textContent : '';
        const yearCost = resCostYear ? resCostYear.textContent : '';

        const textToCopy = `kWhKlar Stromkosten-Berechnung:\nLeistung: ${watt} W\nNutzung: ${hours} h/Tag\nStrompreis: ${price} ct/kWh\nKosten pro Monat: ${monthCost}\nKosten pro Jahr: ${yearCost}\nBerechnet auf https://kwhklar.de/stromkosten-rechner`;

        navigator.clipboard.writeText(textToCopy).then(() => {
          const original = copyBtnText.textContent;
          copyBtnText.textContent = 'Kopiert!';
          setTimeout(() => {
            copyBtnText.textContent = original;
          }, 2000);
        });
      });
    }

    recalculate();
  }

  // Support for both initial load and client transitions
  document.addEventListener('astro:page-load', initCalculator);
  if (document.readyState !== 'loading') {
    initCalculator();
  } else {
    document.addEventListener('DOMContentLoaded', initCalculator);
  }
</script>
