---
import { formatEuro, formatKwh } from '../../lib/formatters';
import { type SupportedLanguage, languages } from '../../i18n/languages';

interface Props {
  defaultWatt?: number;
  defaultHours?: number;
  defaultPriceCt?: number;
  defaultDaysPerWeek?: number;
  title?: string;
  subtitle?: string;
  applianceName?: string;
  showPresets?: boolean;
  lang?: SupportedLanguage;
}

const {
  defaultWatt = 1000,
  defaultHours = 1,
  defaultPriceCt = 35.0,
  defaultDaysPerWeek = 7,
  title,
  subtitle,
  applianceName,
  showPresets = true,
  lang = 'de',
} = Astro.props;

