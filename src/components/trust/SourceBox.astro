---
import { sources, type Source } from '../../data/sources';

interface Props {
  sourceIds?: string[];
  note?: string;
}

const { sourceIds = ['bnetza', 'bdew', 'stromspiegel'], note } = Astro.props;

const activeSources: Source[] = sourceIds
  .map((id) => sources[id])
  .filter((s): s is Source => Boolean(s));
---

<div class="my-8 rounded-2xl border border-slate-200 bg-slate-50/80 p-5 text-slate-700">
  <div class="flex items-center gap-2 mb-3">
    <div class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">
      ✓
    </div>
    <h3 class="text-sm font-semibold text-slate-900 tracking-tight">Transparenz & Quellenangabe</h3>
  </div>

  <p class="text-xs text-slate-600 leading-relaxed">
    {note || 'Die Berechnungsgrundlagen, Verbrauchswerte und Strompreis-Referenzen auf dieser Seite basieren auf validierten Daten offizieller Stellen:'}
  </p>

  <ul class="mt-3 divide-y divide-slate-200/60 text-xs">
    {activeSources.map((source) => (
      <li class="py-2 first:pt-0 last:pb-0 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
        <div>
          <span class="font-medium text-slate-800">{source.name}</span>
          <span class="text-slate-500 text-[11px] block">{source.publisher} (Stand: {source.accessedAt})</span>
        </div>
        <a
          href={source.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center text-emerald-700 hover:text-emerald-800 hover:underline font-medium text-[11px]"
        >
          <span>Quelle öffnen</span>
          <svg class="ml-0.5 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </li>
    ))}
  </ul>

  <div class="mt-4 pt-3 border-t border-slate-200 text-[11px] text-slate-500 flex flex-wrap items-center justify-between gap-2">
    <span>Ausführliche Formeln & Methodik:</span>
    <a href="/quellen-methodik" class="font-medium text-emerald-600 hover:underline">
      Zur Quellen- & Methodikseite →
    </a>
  </div>
</div>
