---
import { sources, type Source } from '../../data/sources';
import type { SupportedLanguage } from '../../i18n/languages';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';

interface Props {
  sourceIds?: string[];
  note?: string;
  lang?: SupportedLanguage;
}

const { sourceIds = ['bnetza', 'bdew', 'stromspiegel'], note, lang = 'de' } = Astro.props;
const t = useTranslations(lang);

const activeSources: Source[] = sourceIds
  .map((id) => sources[id])
  .filter((s): s is Source => Boolean(s));
---

<div class="my-8 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900/60 p-5 text-slate-700 dark:text-slate-300 shadow-2xs">
  <div class="flex items-center gap-2 mb-3">
    <div class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 text-xs font-bold border border-emerald-500/20">
      ✓
    </div>
    <h3 class="text-sm font-semibold text-slate-900 dark:text-white tracking-tight">{t('source.title') || 'Transparenz & Quellenangabe'}</h3>
  </div>

  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
    {note || 'Die Berechnungsgrundlagen, Verbrauchswerte und Strompreis-Referenzen auf dieser Seite basieren auf validierten Daten offizieller Stellen:'}
  </p>

  <ul class="mt-3 divide-y divide-slate-200/60 dark:divide-slate-800 text-xs">
    {activeSources.map((source) => (
      <li class="py-2.5 first:pt-0 last:pb-0 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
        <div>
          <span class="font-medium text-slate-800 dark:text-slate-200">{source.name}</span>
          <span class="text-slate-500 dark:text-slate-400 text-[11px] block">{source.publisher}</span>
        </div>
        <a
          href={source.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center text-emerald-700 dark:text-emerald-400 hover:text-emerald-800 dark:hover:text-emerald-300 hover:underline font-medium text-[11px] transition"
        >
          <span>{t('source.open') || 'Quelle öffnen'}</span>
          <svg class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </li>
    ))}
  </ul>

  <div class="mt-4 pt-3.5 border-t border-slate-200 dark:border-slate-800 text-[11px] text-slate-500 dark:text-slate-400 flex flex-wrap items-center justify-between gap-2">
    <span>{t('source.methodology') || 'Ausführliche Formeln & Methodik:'}</span>
    <a href={getLocalizedPath('/quellen-methodik', lang)} class="font-medium text-emerald-600 dark:text-emerald-400 hover:underline">
      {t('source.methodology_cta') || 'Zur Quellen- & Methodikseite →'}
    </a>
  </div>
</div>
