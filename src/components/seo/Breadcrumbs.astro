---
interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6 flex">
  <ol class="inline-flex items-center space-x-1 text-xs text-slate-500 md:space-x-2">
    <li class="inline-flex items-center">
      <a href="/" class="inline-flex items-center text-slate-500 hover:text-emerald-600 transition">
        <svg class="mr-1.5 h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
        </svg>
        Startseite
      </a>
    </li>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center">
          <svg class="h-3.5 w-3.5 text-slate-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
          </svg>
          {isLast ? (
            <span class="ml-1 md:ml-2 font-medium text-slate-700 truncate max-w-[200px] sm:max-w-none" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.path} class="ml-1 md:ml-2 text-slate-500 hover:text-emerald-600 transition">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
