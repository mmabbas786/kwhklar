---
interface LinkItem {
  title: string;
  href: string;
  description?: string;
  badge?: string;
}

interface Props {
  title?: string;
  links: LinkItem[];
}

const { title = 'Passende Rechner & Ratgeber', links } = Astro.props;
---

<section class="my-10 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
  <h2 class="text-lg font-bold text-slate-900 tracking-tight">{title}</h2>
  <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {links.map((link) => (
      <a
        href={link.href}
        class="group flex flex-col justify-between rounded-xl border border-slate-100 bg-slate-50/70 p-4 transition-all hover:border-emerald-300 hover:bg-emerald-50/40 hover:shadow-xs"
      >
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="font-semibold text-sm text-slate-900 group-hover:text-emerald-700 transition">
              {link.title}
            </span>
            {link.badge && (
              <span class="inline-flex rounded-md bg-emerald-100 px-1.5 py-0.5 text-[10px] font-medium text-emerald-800">
                {link.badge}
              </span>
            )}
          </div>
          {link.description && (
            <p class="mt-1 text-xs text-slate-500 line-clamp-2">{link.description}</p>
          )}
        </div>
        <div class="mt-3 flex items-center text-xs font-medium text-emerald-600 group-hover:text-emerald-700">
          <span>Jetzt berechnen</span>
          <svg class="ml-1 h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>
