---
import type { SupportedLanguage } from '../../i18n/languages';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';

interface LinkItem {
  title: string;
  href: string;
  description?: string;
  badge?: string;
}

interface Props {
  title?: string;
  links: LinkItem[];
  lang?: SupportedLanguage;
}

const { title, links, lang = 'de' } = Astro.props;
const t = useTranslations(lang);
const sectionTitle = title || t('related.title') || 'Passende Rechner & Ratgeber';
const ctaLabel = t('related.cta') || 'Jetzt berechnen';
---

<section class="my-10 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-6 shadow-xs">
  <h2 class="text-lg font-bold text-slate-900 dark:text-white tracking-tight">{sectionTitle}</h2>
  <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {links.map((link) => (
      <a
        href={lang === 'de' ? link.href : getLocalizedPath(link.href, lang)}
        class="group flex flex-col justify-between rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/60 p-4 transition-all hover:border-emerald-300 dark:hover:border-emerald-500 hover:bg-emerald-50/40 dark:hover:bg-emerald-950/20 hover:shadow-xs"
      >
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="font-semibold text-sm text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition">
              {link.title}
            </span>
            {link.badge && (
              <span class="inline-flex rounded-md bg-emerald-100 dark:bg-emerald-950/80 px-1.5 py-0.5 text-[10px] font-medium text-emerald-800 dark:text-emerald-300 border border-emerald-500/20">
                {link.badge}
              </span>
            )}
          </div>
          {link.description && (
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400 line-clamp-2">{link.description}</p>
          )}
        </div>
        <div class="mt-3 flex items-center text-xs font-medium text-emerald-600 dark:text-emerald-400 group-hover:text-emerald-700 dark:group-hover:text-emerald-300">
          <span>{ctaLabel}</span>
          <svg class="ml-1 h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>
