---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversalCalculator from '../components/calculator/UniversalCalculator.astro';
import ApplianceCard from '../components/cards/ApplianceCard.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import ApplianceIcon from '../components/icons/ApplianceIcon.astro';
import { appliances } from '../data/appliances';
import { householdBenchmarks } from '../data/household-benchmarks';
import { electricityPriceData } from '../data/electricity-price';
import { formatEuro, formatKwh } from '../lib/formatters';

const popularAppliances = [
  appliances['kuehlschrank'],
  appliances['waschmaschine'],
  appliances['trockner'],
  appliances['geschirrspueler'],
  appliances['gaming-pc'],
  appliances['fernseher'],
];

const homeFaqs = [
  {
    question: 'Wie berechnet man die Stromkosten aus Watt und Stunden?',
    answer:
      'Die Formel lautet: Kosten (€) = (Leistung in Watt × Nutzungsdauer in Stunden ÷ 1.000) × Strompreis (€/kWh). Beispiel: Ein 2.000-Watt-Gerät, das 2 Stunden läuft, verbraucht (2.000 × 2 ÷ 1.000) = 4 kWh. Bei 35 ct/kWh kostet das 1,40 €.',
  },
  {
    question: 'Was ist der Unterschied zwischen Watt (W) und Kilowattstunde (kWh)?',
    answer:
      'Watt (W) bzw. Kilowatt (kW = 1.000 W) ist die physikalische Leistung – also wie viel Energie ein Gerät in jedem Augenblick benötigt. Die Kilowattstunde (kWh) ist die geleistete Arbeit bzw. der tatsächliche Gesamtverbrauch über einen Zeitraum.',
  },
  {
    question: 'Wie hoch ist der durchschnittliche Stromverbrauch eines Haushalts in Deutschland?',
    answer:
      'Laut Stromspiegel 2024/2025 verbraucht ein 1-Personen-Haushalt in der Wohnung ca. 1.300–1.500 kWh/Jahr, ein 2-Personen-Haushalt ca. 2.100–2.500 kWh/Jahr und eine 4-köpfige Familie ca. 3.000–4.000 kWh/Jahr (ohne elektrische Warmwasserbereitung).',
  },
  {
    question: 'Wie viel kostet 1 kWh Strom in Deutschland aktuell?',
    answer:
      'Der durchschnittliche Haushaltsstrompreis in Deutschland liegt 2026 bei ca. 35 bis 37 Cent pro Kilowattstunde (Arbeitspreis für Neukunden oft bei 28–32 ct/kWh, in der Grundversorgung bei 40–44 ct/kWh).',
  },
  {
    question: 'Welche Geräte verbrauchen im Haushalt am meisten Strom?',
    answer:
      'Zu den größten Stromverbrauchern gehören alte Kühl- und Gefriergeräte, Wäschetrockner ohne Wärmepumpe, elektrische Durchlauferhitzer, Heizlüfter sowie Hochleistungs-Gaming-PCs bei langer täglicher Nutzung.',
  },
];
---

<BaseLayout
  title="Stromkostenrechner & Stromverbrauch einfach berechnen | kWhKlar"
  description="Berechne deine Stromkosten und den Stromverbrauch für Geräte und Haushalte schnell und exakt. Mit transparenten Formeln und aktuellen Strompreisen."
  canonical="https://kwhklar.de"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-emerald-50/70 via-slate-50 to-slate-50 dark:from-slate-950 dark:via-slate-900/90 dark:to-slate-950 pt-10 pb-8 sm:pt-16 sm:pb-12 border-b border-slate-200/70 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-4 mb-8">
        <div class="inline-flex items-center gap-2 rounded-full bg-emerald-100/90 dark:bg-emerald-950/80 px-3.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 shadow-2xs">
          <span>⚡ Unabhängig & Transparent • Aktuelle Richtwerte 2026</span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl">
          Stromkosten & Energieverbrauch <span class="text-emerald-600 dark:text-emerald-400">einfach berechnen</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto">
          Ermittle in Sekunden, wie viel Strom deine Elektrogeräte verbrauchen und was dich der Betrieb pro Stunde, Tag, Monat und Jahr tatsächlich kostet.
        </p>
      </div>

      <!-- Hero Calculator Island -->
      <UniversalCalculator
        defaultWatt={1000}
        defaultHours={1}
        defaultPriceCt={35.0}
        title="Live Stromkostenrechner"
        subtitle="Gib die Wattzahl deines Geräts und die tägliche Nutzungsdauer ein:"
      />
    </div>
  </section>

  <!-- Popular Calculation Categories -->
  <section class="py-14 bg-white dark:bg-slate-900 border-b border-slate-200/70 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight sm:text-3xl">
          Die wichtigsten Rechner im Überblick
        </h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          Wähle den passenden Rechner für deine Fragestellung:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <a href="/stromkosten-rechner" class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col justify-between dark:bg-slate-800/80 dark:border-slate-700 transition group">
          <div>
            <div class="h-11 w-11 rounded-xl bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 flex items-center justify-center mb-4 border border-emerald-500/20 group-hover:bg-emerald-500 group-hover:text-white transition-all">
              <ApplianceIcon name="calculator" class="h-6 w-6" />
            </div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition">Stromkostenrechner</h3>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Berechne die Gesamtkosten aus Watt, Nutzungsdauer und Strompreis für jedes Elektrogerät.
            </p>
          </div>
          <span class="mt-5 text-xs font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5 group-hover:text-emerald-700 dark:group-hover:text-emerald-300">Zum Rechner →</span>
        </a>

        <a href="/kwh-rechner" class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col justify-between dark:bg-slate-800/80 dark:border-slate-700 transition group">
          <div>
            <div class="h-11 w-11 rounded-xl bg-blue-100 dark:bg-blue-950/80 text-blue-700 dark:text-blue-400 flex items-center justify-center mb-4 border border-blue-500/20 group-hover:bg-blue-500 group-hover:text-white transition-all">
              <ApplianceIcon name="kwh" class="h-6 w-6" />
            </div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">kWh in Euro Rechner</h3>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Kilowattstunden direkt in Euro umrechnen oder Kosten für 100, 500, 1.000 kWh ermitteln.
            </p>
          </div>
          <span class="mt-5 text-xs font-semibold text-blue-600 dark:text-blue-400 flex items-center gap-1.5 group-hover:text-blue-700 dark:group-hover:text-blue-300">Zum Rechner →</span>
        </a>

        <a href="/watt-rechner" class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col justify-between dark:bg-slate-800/80 dark:border-slate-700 transition group">
          <div>
            <div class="h-11 w-11 rounded-xl bg-amber-100 dark:bg-amber-950/80 text-amber-700 dark:text-amber-400 flex items-center justify-center mb-4 border border-amber-500/20 group-hover:bg-amber-500 group-hover:text-white transition-all">
              <ApplianceIcon name="watt" class="h-6 w-6" />
            </div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base group-hover:text-amber-600 dark:group-hover:text-amber-400 transition">Watt in kWh Rechner</h3>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Leistung von Watt in Kilowattstunden und laufende Betriebskosten umrechnen.
            </p>
          </div>
          <span class="mt-5 text-xs font-semibold text-amber-600 dark:text-amber-400 flex items-center gap-1.5 group-hover:text-amber-700 dark:group-hover:text-amber-300">Zum Rechner →</span>
        </a>

        <a href="/stromverbrauch-haushalt" class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col justify-between dark:bg-slate-800/80 dark:border-slate-700 transition group">
          <div>
            <div class="h-11 w-11 rounded-xl bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-400 flex items-center justify-center mb-4 border border-purple-500/20 group-hover:bg-purple-500 group-hover:text-white transition-all">
              <ApplianceIcon name="household" class="h-6 w-6" />
            </div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base group-hover:text-purple-600 dark:group-hover:text-purple-400 transition">Haushaltsstrom-Rechner</h3>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Vergleiche deinen Jahresverbrauch mit typischen 1- bis 5-Personen-Haushalten in Deutschland.
            </p>
          </div>
          <span class="mt-5 text-xs font-semibold text-purple-600 dark:text-purple-400 flex items-center gap-1.5 group-hover:text-purple-700 dark:group-hover:text-purple-300">Zum Rechner →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Popular Appliances Section -->
  <section class="py-14 bg-slate-50 dark:bg-slate-950 border-b border-slate-200/70 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">Verbrauch im Detail</span>
          <h2 class="mt-1 text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
            Beliebte Haushaltsgeräte
          </h2>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
            Finde heraus, was typische Geräte pro Jahr an Strom verbrauchen und kosten.
          </p>
        </div>
        <a
          href="/geraete"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2 text-xs font-semibold text-slate-800 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 hover:border-emerald-400 transition"
        >
          Alle 25+ Geräte ansehen →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {popularAppliances.map((appliance) => (
          <ApplianceCard appliance={appliance} />
        ))}
      </div>
    </div>
  </section>

  <!-- Household Benchmarks Section -->
  <section class="py-14 bg-white dark:bg-slate-900 border-b border-slate-200/70 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">Bundesweite Richtwerte</span>
        <h2 class="mt-1 text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Stromverbrauch nach Haushaltsgröße
        </h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          Wie hoch ist der normale Stromverbrauch in Deutschland? Offizielle Vergleichswerte laut Stromspiegel:
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/90 shadow-2xs">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold border-b border-slate-200 dark:border-slate-800">
            <tr>
              <th class="p-4">Haushaltsgröße</th>
              <th class="p-4">Wohnung (ohne Warmwasser)</th>
              <th class="p-4">Wohnung (mit Warmwasser)</th>
              <th class="p-4">Einfamilienhaus</th>
              <th class="p-4 text-right">Monatliche Kosten (ca.)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-600 dark:text-slate-400">
            {Object.values(householdBenchmarks).map((bm) => (
              <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/50 transition">
                <td class="p-4 font-semibold text-slate-900 dark:text-white">
                  <a href={`/stromverbrauch-${bm.persons}-person${bm.persons > 1 ? 'en' : ''}`} class="text-emerald-700 dark:text-emerald-400 hover:underline">
                    {bm.label}
                  </a>
                </td>
                <td class="p-4">{formatKwh(bm.apartmentWithoutWarmWaterKwh, 0)}/Jahr</td>
                <td class="p-4 text-amber-700 dark:text-amber-400 font-medium">{formatKwh(bm.apartmentWithWarmWaterKwh, 0)}/Jahr</td>
                <td class="p-4">{formatKwh(bm.houseWithoutWarmWaterKwh, 0)}/Jahr</td>
                <td class="p-4 text-right font-bold text-slate-900 dark:text-white">{formatEuro(bm.typicalMonthlyCostEuro)}/Monat</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400">
        <span>* Berechnet mit 35 ct/kWh Arbeitspreis + 12,50 € monatlichem Grundpreis.</span>
        <a href="/durchschnittlicher-stromverbrauch" class="text-emerald-700 dark:text-emerald-400 font-semibold hover:underline">
          Ausführlichen Durchschnittsverbrauch ansehen →
        </a>
      </div>
    </div>
  </section>

  <!-- Electricity Price Reference & Formula Guide -->
  <section class="py-14 bg-slate-50 dark:bg-slate-950 border-b border-slate-200/70 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 space-y-4">
          <span class="badge-emerald text-xs">Transparenz & Datenbasis</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
            Wie setzen sich Stromkosten zusammen?
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Auf deiner Stromrechnung zahlst du zwei Hauptbestandteile: den verbrauchsabhängigen <strong>Arbeitspreis (in ct/kWh)</strong> für jede bezogene Kilowattstunde und den festen <strong>Grundpreis (in €/Monat)</strong> für Zähler, Netznutzung und Abrechnung.
          </p>
          <div class="space-y-3 pt-2">
            {electricityPriceData.priceComposition.map((comp) => (
              <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3.5 shadow-2xs">
                <div class="flex items-center justify-between text-xs font-semibold text-slate-900 dark:text-white">
                  <span>{comp.category}</span>
                  <span class="text-emerald-700 dark:text-emerald-400">{comp.sharePercent.toFixed(1)} % ({comp.valueCtPerKwh.toFixed(2).replace('.', ',')} ct)</span>
                </div>
                <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{comp.description}</p>
              </div>
            ))}
          </div>
          <div class="pt-2">
            <a href="/strompreis-zusammensetzung" class="text-xs font-semibold text-emerald-700 dark:text-emerald-400 hover:underline">
              Mehr zur Strompreis-Zusammensetzung erfahren →
            </a>
          </div>
        </div>

        <div class="lg:col-span-6 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-xs space-y-5">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Stromkosten selbst berechnen in 3 Schritten</h3>
          
          <div class="space-y-4 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-400 font-bold text-xs">1</span>
              <div>
                <strong class="text-slate-900 dark:text-white block font-semibold">Leistung in Watt ermitteln</strong>
                Schau auf das Typenschild deines Geräts (z.B. „1500 W“).
              </div>
            </div>

            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-400 font-bold text-xs">2</span>
              <div>
                <strong class="text-slate-900 dark:text-white block font-semibold">Watt in kWh umrechnen</strong>
                Multipliziere die Watt mit den Betriebsstunden und teile durch 1.000:
                <code class="mt-1 block bg-slate-100 dark:bg-slate-800 p-2 rounded text-slate-800 dark:text-slate-200 font-mono text-xs">
                  1.500 W × 2 Std. ÷ 1.000 = 3,0 kWh
                </code>
              </div>
            </div>

            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-400 font-bold text-xs">3</span>
              <div>
                <strong class="text-slate-900 dark:text-white block font-semibold">Mit dem Strompreis multiplizieren</strong>
                Multipliziere die kWh mit deinem Arbeitspreis (z.B. 0,35 €):
                <code class="mt-1 block bg-slate-100 dark:bg-slate-800 p-2 rounded text-slate-800 dark:text-slate-200 font-mono text-xs">
                  3,0 kWh × 0,35 € = 1,05 € pro Tag
                </code>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sources & Methodology Box -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
    <SourceBox
      sourceIds={['bnetza', 'bdew', 'destatis', 'stromspiegel']}
      note="Alle auf kWhKlar bereitgestellten Berechnungen und Referenzwerte basieren auf offiziellen Erhebungen der Bundesnetzagentur, des Statistischen Bundesamtes und der Stromspiegel-Initiative."
    />
  </div>

  <!-- FAQ Section -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
    <FaqSection items={homeFaqs} />
  </div>
</BaseLayout>
