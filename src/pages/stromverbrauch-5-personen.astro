---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversalCalculator from '../components/calculator/UniversalCalculator.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { householdBenchmarks } from '../data/household-benchmarks';
import { formatKwh } from '../lib/formatters';

const data = householdBenchmarks[5];

const faqs = [
  {
    question: 'Wie viel Strom verbraucht eine 5-köpfige Großfamilie?',
    answer: 'Ein 5-Personen-Haushalt verbraucht ca. 3.600 bis 5.200 kWh in einer Wohnung bzw. 4.800 bis 6.300 kWh im Einfamilienhaus. Die monatlichen Kosten liegen bei 35 ct/kWh zwischen ca. 120 und 195 Euro.',
  },
];

const related = [
  { title: '4-Personen-Haushalt', href: '/stromverbrauch-4-personen', description: 'Richtwerte für 4 Personen.' },
  { title: 'Stromverbrauch Einfamilienhaus', href: '/stromverbrauch-einfamilienhaus', description: 'Verbrauch im Eigenheim.' },
  { title: 'Balkonkraftwerk Ersparnis', href: '/balkonkraftwerk/stromkosten-sparen', description: 'Grundlast im großen Haushalt senken.' },
];
---

<BaseLayout
  title="Stromverbrauch 5 Personen: Richtwerte & Kosten für Großfamilien | kWhKlar"
  description="Wie viel Strom verbraucht ein 5-Personen-Haushalt? Offizielle Richtwerte (3.600–5.200 kWh), Kostenvergleich und Sparmöglichkeiten für große Haushalte."
  canonical="https://kwhklar.de/stromverbrauch-5-personen"
  breadcrumbs={[
    { name: 'Haushalt', path: '/stromverbrauch-haushalt' },
    { name: '5 Personen', path: '/stromverbrauch-5-personen' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Haushalt', path: '/stromverbrauch-haushalt' },
        { name: '5 Personen (Großfamilie)', path: '/stromverbrauch-5-personen' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Großhaushalt Benchmark</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Stromverbrauch für 5 Personen (Großfamilie)
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        {data.description}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-10">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
        <span class="text-xs text-slate-500 font-medium">Wohnung (ohne Warmwasser)</span>
        <div class="mt-2 text-2xl font-bold text-slate-900">{formatKwh(data.apartmentWithoutWarmWaterKwh, 0)}</div>
        <span class="text-xs text-slate-400 mt-1 block">ca. 115–125 € / Monat</span>
      </div>

      <div class="rounded-2xl border border-amber-200 bg-amber-50/50 p-5 shadow-xs">
        <span class="text-xs text-amber-800 font-medium">Wohnung (mit Warmwasser elektrisch)</span>
        <div class="mt-2 text-2xl font-bold text-amber-950">{formatKwh(data.apartmentWithWarmWaterKwh, 0)}</div>
        <span class="text-xs text-amber-700 mt-1 block">ca. 160–180 € / Monat</span>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
        <span class="text-xs text-slate-500 font-medium">Einfamilienhaus</span>
        <div class="mt-2 text-2xl font-bold text-slate-900">{formatKwh(data.houseWithoutWarmWaterKwh, 0)}</div>
        <span class="text-xs text-slate-400 mt-1 block">ca. 150–170 € / Monat</span>
      </div>
    </div>

    <UniversalCalculator
      defaultWatt={550}
      defaultHours={24}
      defaultPriceCt={35.0}
      title="5-Personen Verbrauchsrechner"
      subtitle="Ermittle deine Stromkosten bei individuellem Verbrauch:"
    />

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['stromspiegel', 'bdew']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
