---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ApplianceCard from '../../components/cards/ApplianceCard.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import { appliances } from '../../data/appliances';

const applianceList = Object.values(appliances);

const categories = [
  'Küche',
  'Haushalt & Reinigung',
  'Unterhaltung & Büro',
  'Klima & Heizen',
  'Hobby & Spezial',
] as const;

const categorizedAppliances = categories.map((cat) => ({
  category: cat,
  items: applianceList.filter((a) => a.category === cat),
}));
---

<BaseLayout
  title="Stromverbrauch von Haushaltsgeräten: Übersicht & Rechner | kWhKlar"
  description="Übersicht über den Stromverbrauch von mehr als 25 Haushalts- und Elektrogeräten: Kühlschrank, Waschmaschine, Gaming-PC, Fernseher und mehr."
  canonical="https://kwhklar.de/geraete"
  breadcrumbs={[{ name: 'Geräte Übersicht', path: '/geraete' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Geräte Übersicht', path: '/geraete' }]} />

    <div class="max-w-3xl mb-10">
      <span class="badge-emerald text-xs mb-2">Geräte-Verzeichnis</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Stromverbrauch von Haushaltsgeräten im Überblick
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        Erfahre genau, wie viel Leistung (Watt) typische Geräte aufnehmen, wie viele Kilowattstunden sie pro Jahr verbrauchen und mit welchen Stromkosten du rechnen musst.
      </p>
    </div>

    <!-- Category Sections -->
    <div class="space-y-12">
      {categorizedAppliances.map(({ category, items }) => (
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 p-6 sm:p-8">
          <div class="mb-6 flex items-center justify-between">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">{category}</h2>
              <span class="text-xs text-slate-500 dark:text-slate-400">{items.length} Geräte erfasst</span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {items.map((appliance) => (
              <ApplianceCard appliance={appliance} lang="de" />
            ))}
          </div>
        </section>
      ))}
    </div>

    <SourceBox sourceIds={['bnetza', 'uba', 'stromspiegel']} />
  </div>
</BaseLayout>
