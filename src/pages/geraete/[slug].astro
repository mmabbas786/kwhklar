---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UniversalCalculator from '../../components/calculator/UniversalCalculator.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../components/seo/RelatedLinks.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';
import { appliances, type Appliance } from '../../data/appliances';
import { formatEuro, formatKwh, formatWatt } from '../../lib/formatters';
import { getCalculatorSchema, getFaqSchema } from '../../lib/structured-data';

import ApplianceIcon from '../../components/icons/ApplianceIcon.astro';

export function getStaticPaths() {
  return Object.values(appliances).map((appliance) => ({
    params: { slug: appliance.slug },
    props: { appliance },
  }));
}

interface Props {
  appliance: Appliance;
}

const { appliance } = Astro.props;

const calcSchema = getCalculatorSchema(
  `${appliance.name} Stromkosten berechnen`,
  `Berechne den Stromverbrauch und die jährlichen Stromkosten für ${appliance.name} bei aktuellem Strompreis.`,
  `/geraete/${appliance.slug}`
);

const faqSchema = getFaqSchema(appliance.faq);
const pageSchemas = faqSchema ? [calcSchema, faqSchema] : [calcSchema];

const relatedApplianceObjects = appliance.relatedDevices
  .map((slug) => appliances[slug])
  .filter((a): a is Appliance => Boolean(a));

const relatedCalcLinks = appliance.relatedCalculators.map((path) => ({
  title: path === '/stromkosten-rechner' ? 'Allgemeiner Stromkostenrechner' : path === '/watt-rechner' ? 'Watt in kWh Rechner' : path === '/kwh-rechner' ? 'kWh in Euro Rechner' : 'Stundenkosten-Rechner',
  href: path,
  description: 'Berechne Stromkosten flexibel nach deinen eigenen Werten.',
}));

// Comparison table metrics
const efficientKwh = Math.round(appliance.typicalAnnualKwh * 0.7);
const efficientCost = +(efficientKwh * 0.35).toFixed(2);
const typicalKwh = appliance.typicalAnnualKwh;
const typicalCost = appliance.annualCostEuro;
const oldKwh = Math.round(appliance.typicalAnnualKwh * 1.6);
const oldCost = +(oldKwh * 0.35).toFixed(2);
---

<BaseLayout
  title={`${appliance.name} Stromkosten & Stromverbrauch berechnen | kWhKlar`}
  description={`Wie viel Strom verbraucht ein ${appliance.name}? Typische Leistung (${appliance.wattageMin}–${appliance.wattageMax} W), Jahreskosten (${formatEuro(appliance.annualCostEuro)}) und interaktiver Rechner.`}
  canonical={`https://kwhklar.de/geraete/${appliance.slug}`}
  jsonLd={pageSchemas}
  breadcrumbs={[
    { name: 'Geräte', path: '/geraete' },
    { name: appliance.name, path: `/geraete/${appliance.slug}` },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Geräte', path: '/geraete' },
        { name: appliance.name, path: `/geraete/${appliance.slug}` },
      ]}
    />

    <!-- Header & Direct Answer -->
    <div class="max-w-4xl mb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="badge-emerald text-xs">{appliance.category}</span>
        <span class="text-xs text-slate-400">•</span>
        <span class="text-xs text-slate-500 font-medium">Ø {formatWatt(appliance.typicalWattage)} Leistung</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-3.5">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-2xs">
          <ApplianceIcon name={appliance.slug} class="h-7 w-7" />
        </span>
        <span>{appliance.name} Stromkosten berechnen</span>
      </h1>

      <!-- Direct Answer Box -->
      <div class="mt-5 rounded-2xl bg-emerald-50/80 dark:bg-emerald-950/30 border border-emerald-200/80 dark:border-emerald-800/60 p-5 text-slate-800 dark:text-slate-200 leading-relaxed shadow-2xs">
        <strong class="font-bold text-emerald-950 dark:text-emerald-300 block text-base mb-1">Direkte Antwort auf einen Blick:</strong>
        <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
          {appliance.shortDescription}
        </p>
      </div>
    </div>

    <!-- Pre-filled Interactive Calculator -->
    <UniversalCalculator
      defaultWatt={appliance.calculationDefaults.watt}
      defaultHours={appliance.calculationDefaults.hoursPerDay}
      defaultPriceCt={35.0}
      title={`${appliance.name} Rechner`}
      subtitle={`Voreingestellt mit den typischen Werten für ${appliance.name}. Du kannst Leistung, Nutzungsdauer und Strompreis individuell anpassen:`}
      applianceName={appliance.name}
      showPresets={false}
    />

    <!-- Editorial Deep-Dive Content -->
    <div class="my-12 grid grid-cols-1 lg:grid-cols-12 gap-8">
      <article class="lg:col-span-8 space-y-8">
        
        <!-- Section: Formula & Worked Example -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Formel: So berechnest du die Stromkosten für {appliance.name}
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            Die Berechnung der Stromkosten für <strong>{appliance.name}</strong> erfolgt in zwei einfachen Schritten: Zuerst wird die elektrische Leistung (Watt) mit der Nutzungsdauer multipliziert, um den Energieverbrauch in Kilowattstunden (kWh) zu erhalten. Anschließend wird das Ergebnis mit dem Arbeitspreis deines Stromtarifs multipliziert.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-5">
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700">
              <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 block mb-1">1. Energieverbrauch (kWh)</span>
              <code class="text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">
                kWh = (Watt × Stunden) ÷ 1.000
              </code>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700">
              <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 block mb-1">2. Stromkosten (€)</span>
              <code class="text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">
                Kosten = kWh × Strompreis (€/kWh)
              </code>
            </div>
          </div>

          <div class="rounded-2xl bg-slate-50 dark:bg-slate-800/40 p-4 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-700 dark:text-slate-300 space-y-2">
            <strong class="font-semibold text-slate-900 dark:text-white block">Konkretes Rechenbeispiel für {appliance.name}:</strong>
            <p>
              Gehen wir von einer typischen Leistungsaufnahme von <strong>{formatWatt(appliance.typicalWattage)}</strong>, einer täglichen Nutzungsdauer und einem Standard-Referenzstrompreis von <strong>0,35 €/kWh (35 ct/kWh)</strong> aus:
            </p>
            <ul class="list-disc pl-5 space-y-1 text-slate-600 dark:text-slate-400">
              <li>Verbrauch pro Stunde: {appliance.typicalWattage} W × 1 h ÷ 1.000 = <strong>{+(appliance.typicalWattage / 1000).toFixed(3)} kWh</strong></li>
              <li>Kosten pro Betriebsstunde: {+(appliance.typicalWattage / 1000).toFixed(3)} kWh × 0,35 € = <strong>{formatEuro((appliance.typicalWattage / 1000) * 0.35)}</strong> (ca. {+((appliance.typicalWattage / 1000) * 35).toFixed(1)} Cent)</li>
              <li>Jahresverbrauch ({appliance.usageContext}): ca. <strong>{formatKwh(appliance.typicalAnnualKwh, 0)}</strong></li>
              <li>Jährliche Gesamtstromkosten: {formatKwh(appliance.typicalAnnualKwh, 0)} × 0,35 € = <strong>{formatEuro(appliance.annualCostEuro)}</strong></li>
            </ul>
          </div>
        </section>

        <!-- Section: Consumption Range & Nuances -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Typischer Stromverbrauch & Leistungsaufnahme
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            Die elektrische Nennleistung von <strong>{appliance.name}</strong> liegt je nach Modell typischerweise zwischen <strong>{formatWatt(appliance.wattageMin)}</strong> und <strong>{formatWatt(appliance.wattageMax)}</strong>. Der tatsächliche Stromverbrauch unterscheidet sich jedoch oft deutlich von der reinen Nennleistung auf dem Typenschild:
          </p>

          <div class="rounded-2xl bg-amber-50/70 dark:bg-amber-950/30 p-4 border border-amber-200/80 dark:border-amber-800/60 text-xs sm:text-sm text-amber-950 dark:text-amber-200 mb-6">
            <strong class="font-bold block mb-1">Betriebsweise, Taktung & Reallast:</strong>
            {appliance.dutyCycleExplanation}
          </div>

          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">Faktoren, die den Stromverbrauch beeinflussen:</h3>
          <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
            {appliance.factors.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>

        <!-- Section: Comparison Table (Effizienzklassen / Generationen) -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Vergleich: Was verbraucht {appliance.name} nach Effizienzklasse?
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            Die folgende Übersicht vergleicht ein modernes, hocheffizientes Neugerät mit dem aktuellen Durchschnitt und einem älteren Altgerät im Haushalt (Basis: 35 ct/kWh):
          </p>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs sm:text-sm border-collapse">
              <thead>
                <tr class="border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400">
                  <th class="py-3 px-3 font-semibold">Geräte-Kategorie</th>
                  <th class="py-3 px-3 font-semibold">Jahresverbrauch (kWh)</th>
                  <th class="py-3 px-3 font-semibold">Monatskosten (€)</th>
                  <th class="py-3 px-3 font-semibold">Jahreskosten (€)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
                <tr class="bg-emerald-50/40 dark:bg-emerald-950/20">
                  <td class="py-3 px-3 font-medium text-emerald-800 dark:text-emerald-300">Hocheffizientes Neugerät (Klasse A/B)</td>
                  <td class="py-3 px-3 font-bold">{formatKwh(efficientKwh, 0)}</td>
                  <td class="py-3 px-3">{formatEuro(efficientCost / 12)}</td>
                  <td class="py-3 px-3 font-bold text-emerald-600 dark:text-emerald-400">{formatEuro(efficientCost)}</td>
                </tr>
                <tr>
                  <td class="py-3 px-3 font-medium text-slate-900 dark:text-white">Durchschnittliches Standardgerät</td>
                  <td class="py-3 px-3 font-bold">{formatKwh(typicalKwh, 0)}</td>
                  <td class="py-3 px-3">{formatEuro(typicalCost / 12)}</td>
                  <td class="py-3 px-3 font-bold text-slate-900 dark:text-white">{formatEuro(typicalCost)}</td>
                </tr>
                <tr class="bg-slate-50/60 dark:bg-slate-800/30">
                  <td class="py-3 px-3 font-medium text-slate-600 dark:text-slate-400">Älteres Modell (&gt; 10 Jahre)</td>
                  <td class="py-3 px-3 font-bold text-amber-700 dark:text-amber-400">{formatKwh(oldKwh, 0)}</td>
                  <td class="py-3 px-3">{formatEuro(oldCost / 12)}</td>
                  <td class="py-3 px-3 font-bold text-amber-700 dark:text-amber-400">{formatEuro(oldCost)}</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-slate-400 dark:text-slate-500 mt-3">
            * Berechnungsbasis: 35,0 ct/kWh Arbeitspreis ohne Grundgebühr. Reale Werte hängen von individueller Nutzungsfrequenz ab.
          </p>
        </section>

        <!-- Section: Measurement Advice -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-3">
            So misst du den echten Verbrauch deines {appliance.name}
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            {appliance.measurementTips}
          </p>
          <div class="rounded-xl bg-slate-50 dark:bg-slate-800/50 p-4 border border-slate-200 dark:border-slate-700 text-xs text-slate-700 dark:text-slate-300">
            <strong class="font-semibold text-slate-900 dark:text-white block mb-1">Praxistipp für die Strommessung:</strong>
            Ein digitales Energiekostenmessgerät für die Steckdose (bereits ab ca. 10–15 € erhältlich) zeigt dir nicht nur die aktuelle Wattzahl in Echtzeit, sondern summiert auch die verbrauchten Kilowattstunden über Tage oder Wochen auf.
          </div>
        </section>

        <!-- Section: Practical Savings Advice -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Stromspartipps für {appliance.name}
          </h2>
          <div class="space-y-3">
            {appliance.savingAdvice.map((tip, idx) => (
              <div class="flex gap-3 rounded-2xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-800/40 p-4 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-200 dark:bg-emerald-800 text-emerald-900 dark:text-emerald-100 font-bold text-xs">
                  {idx + 1}
                </span>
                <span>{tip}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- FAQ -->
        {appliance.faq && appliance.faq.length > 0 && (
          <FaqSection items={appliance.faq} />
        )}
      </article>

      <!-- Sidebar: Quick Facts & Related -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-900 p-6 text-white shadow-md">
          <h3 class="font-bold text-emerald-400 text-sm uppercase tracking-wider mb-4">
            Steckbrief: {appliance.name}
          </h3>
          <dl class="divide-y divide-slate-800 text-xs space-y-2.5">
            <div class="pt-2 flex justify-between">
              <dt class="text-slate-400">Typische Leistung</dt>
              <dd class="font-semibold text-white">{formatWatt(appliance.typicalWattage)}</dd>
            </div>
            <div class="pt-2 flex justify-between">
              <dt class="text-slate-400">Leistungsspanne</dt>
              <dd class="font-semibold text-white">{appliance.wattageMin} – {appliance.wattageMax} W</dd>
            </div>
            <div class="pt-2 flex justify-between">
              <dt class="text-slate-400">Jahresverbrauch (Ø)</dt>
              <dd class="font-semibold text-white">{formatKwh(appliance.typicalAnnualKwh, 0)}</dd>
            </div>
            <div class="pt-2 flex justify-between">
              <dt class="text-slate-400">Jahreskosten (Ø @ 35 ct)</dt>
              <dd class="font-bold text-emerald-400">{formatEuro(appliance.annualCostEuro)}</dd>
            </div>
            <div class="pt-2 flex justify-between">
              <dt class="text-slate-400">Monatskosten (Ø)</dt>
              <dd class="font-semibold text-white">{formatEuro(appliance.annualCostEuro / 12)}</dd>
            </div>
            <div class="pt-2 flex justify-between">
              <dt class="text-slate-400">Nutzungsannahme</dt>
              <dd class="font-medium text-slate-300 text-right max-w-[160px]">{appliance.usageContext}</dd>
            </div>
          </dl>
        </div>

        {relatedApplianceObjects.length > 0 && (
          <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
            <h3 class="font-bold text-slate-900 dark:text-white text-sm mb-4">Ähnliche Geräte</h3>
            <div class="space-y-3">
              {relatedApplianceObjects.map((rel) => (
                <a
                  href={`/geraete/${rel.slug}`}
                  class="flex items-center justify-between rounded-xl border border-slate-100 dark:border-slate-800 p-3 hover:bg-emerald-50/50 dark:hover:bg-emerald-950/20 hover:border-emerald-300 dark:hover:border-emerald-800 transition group"
                >
                  <div class="flex items-center gap-2">
                    <span class="text-lg">{rel.icon}</span>
                    <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 group-hover:text-emerald-700 dark:group-hover:text-emerald-400">{rel.name}</span>
                  </div>
                  <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">{formatEuro(rel.annualCostEuro)}/J.</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>

    <RelatedLinks links={relatedCalcLinks} />
    <SourceBox sourceIds={appliance.sourceIds} />
  </div>
</BaseLayout>
