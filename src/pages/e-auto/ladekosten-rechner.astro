---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../components/seo/RelatedLinks.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';
import { calculateElectricCar } from '../../lib/calculators';
import { formatEuro, formatKwh } from '../../lib/formatters';
import { getCalculatorSchema } from '../../lib/structured-data';

const schema = getCalculatorSchema(
  'E-Auto Ladekosten Rechner',
  'Berechne die Ladekosten und Stromkosten für dein Elektroauto pro 100 km, pro Ladung und pro Jahr inklusive Ladeverlusten.',
  '/e-auto/ladekosten-rechner'
);

const defaultRes = calculateElectricCar({
  kwhPer100Km: 18.0,
  kmPerYear: 15000,
  electricityPriceCtPerKwh: 35.0,
  chargingLossPercent: 10,
});

const faqs = [
  {
    question: 'Wie hoch sind die Ladeverluste beim Elektroauto?',
    answer: 'Beim Laden an der heimischen 11-kW-Wallbox entstehen typischerweise ca. 6 bis 10 % Ladeverluste (Wärmeentwicklung in Ladeelektronik und Kabeln). Beim langsamen Laden an der 230V-Haushaltssteckdose (Schuko) können die Verluste 12 bis 20 % betragen.',
  },
  {
    question: 'Was kostet das Laden eines E-Autos für 100 km zu Hause?',
    answer: 'Bei einem Durchschnittsverbrauch von 18 kWh/100 km (zzgl. 10 % Ladeverluste = 19,8 kWh ab Zähler) und einem Strompreis von 35 ct/kWh kostet das Fahren von 100 km ca. 6,93 Euro.',
  },
];

const related = [
  { title: 'E-Auto Stromkosten', href: '/e-auto/stromkosten', description: 'Kosten im Jahresvergleich.' },
  { title: 'Kosten pro 100 km', href: '/e-auto/kosten-pro-100-km', description: 'Vergleich zu Benzin & Diesel.' },
  { title: 'Dynamische Stromtarife', href: '/dynamische-stromtarife', description: 'Nachts günstig laden.' },
];
---

<BaseLayout
  title="E-Auto Ladekosten Rechner: Stromkosten pro 100 km & Jahr | kWhKlar"
  description="Berechne die Ladekosten deines Elektroautos: Stromkosten pro 100 km, monatliche Ladekosten und Jahreskosten inklusive Ladeverlusten."
  canonical="https://kwhklar.de/e-auto/ladekosten-rechner"
  jsonLd={schema}
  breadcrumbs={[
    { name: 'E-Auto', path: '/e-auto/stromkosten' },
    { name: 'Ladekosten Rechner', path: '/e-auto/ladekosten-rechner' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'E-Auto', path: '/e-auto/stromkosten' },
        { name: 'Ladekosten Rechner', path: '/e-auto/ladekosten-rechner' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Elektromobilität Rechner</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        E-Auto Ladekosten & Stromkosten berechnen
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Ermittle deine echten Ladekosten an der heimischen Wallbox oder an öffentlichen Ladesäulen inklusive Ladeverlusten.
      </p>
    </div>

    <!-- Interactive EV Calculator -->
    <div class="my-8 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-md max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-slate-900">Eckdaten deines E-Autos</h2>

          <div>
            <label for="ev-consumption" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
              Verbrauch (kWh / 100 km laut Bordcomputer)
            </label>
            <input
              type="number"
              id="ev-consumption"
              value="18.0"
              min="10"
              max="35"
              step="0.5"
              class="w-full rounded-xl border border-slate-200 p-3 text-base font-bold text-slate-900"
            />
            <span class="text-[11px] text-slate-500 mt-1 block">Kleinwagen: 14–16 kWh • Mittelklasse: 17–20 kWh • SUV: 21–26 kWh</span>
          </div>

          <div>
            <label for="ev-km" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
              Jährliche Fahrleistung (Kilometer)
            </label>
            <input
              type="number"
              id="ev-km"
              value="15000"
              min="1000"
              step="1000"
              class="w-full rounded-xl border border-slate-200 p-3 text-base font-bold text-slate-900"
            />
          </div>

          <div>
            <label for="ev-price" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
              Strompreis (ct/kWh)
            </label>
            <input
              type="number"
              id="ev-price"
              value="35.0"
              min="10"
              step="0.5"
              class="w-full rounded-xl border border-slate-200 p-3 text-base font-bold text-slate-900"
            />
            <span class="text-[11px] text-slate-500 mt-1 block">Haushaltsstrom: ca. 35 ct • Schnelllader (HPC): oft 55–79 ct/kWh</span>
          </div>

          <div>
            <label for="ev-loss" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
              Geschätzte Ladeverluste (%)
            </label>
            <input
              type="number"
              id="ev-loss"
              value="10"
              min="0"
              max="30"
              step="1"
              class="w-full rounded-xl border border-slate-200 p-3 text-base font-bold text-slate-900"
            />
          </div>
        </div>

        <div class="rounded-2xl bg-gradient-to-br from-slate-900 to-slate-800 p-6 text-white space-y-5">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Kosten pro 100 km</span>
            <div class="text-3xl sm:text-4xl font-extrabold text-emerald-400 tracking-tight mt-1" id="ev-res-cost-100">
              {formatEuro(defaultRes.costPer100Km)}
            </div>
            <span class="text-xs text-slate-400 mt-1 block" id="ev-res-eff-kwh">
              ca. {defaultRes.effectiveKwhPer100Km} kWh ab Zähler pro 100 km
            </span>
          </div>

          <div class="pt-4 border-t border-slate-700">
            <span class="text-xs font-bold uppercase tracking-wider text-white">Jährliche Ladekosten</span>
            <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mt-1" id="ev-res-cost-year">
              {formatEuro(defaultRes.annualCostEuro)}
            </div>
            <span class="text-xs text-slate-400 mt-1 block" id="ev-res-month">
              ca. {formatEuro(defaultRes.monthlyCostEuro)} / Monat ({formatKwh(defaultRes.annualKwh, 0)} Strom / Jahr)
            </span>
          </div>
        </div>
      </div>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'uba', 'bdew']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>

<script>
  function initEvCalc() {
    const consIn = document.getElementById('ev-consumption') as HTMLInputElement | null;
    const kmIn = document.getElementById('ev-km') as HTMLInputElement | null;
    const priceIn = document.getElementById('ev-price') as HTMLInputElement | null;
    const lossIn = document.getElementById('ev-loss') as HTMLInputElement | null;

    const res100 = document.getElementById('ev-res-cost-100');
    const resEff = document.getElementById('ev-res-eff-kwh');
    const resYear = document.getElementById('ev-res-cost-year');
    const resMonth = document.getElementById('ev-res-month');

    if (!consIn || !kmIn || !priceIn || !lossIn || !res100 || !resYear) return;

    function update() {
      const cons = Math.max(0, parseFloat(consIn?.value || '0') || 0);
      const km = Math.max(0, parseFloat(kmIn?.value || '0') || 0);
      const priceCt = Math.max(0, parseFloat(priceIn?.value || '0') || 0);
      const loss = Math.max(0, parseFloat(lossIn?.value || '0') || 0);

      const effKwh100 = cons * (1 + loss / 100);
      const cost100 = effKwh100 * (priceCt / 100);
      const annualKwh = (km / 100) * effKwh100;
      const annualCost = annualKwh * (priceCt / 100);

      const fmt = (v: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(v);

      if (res100) res100.textContent = fmt(cost100);
      if (resEff) resEff.textContent = `ca. ${effKwh100.toFixed(2).replace('.', ',')} kWh ab Zähler pro 100 km`;
      if (resYear) resYear.textContent = fmt(annualCost);
      if (resMonth) resMonth.textContent = `ca. ${fmt(annualCost / 12)} / Monat (${Math.round(annualKwh).toLocaleString('de-DE')} kWh Strom / Jahr)`;
    }

    [consIn, kmIn, priceIn, lossIn].forEach((el) => el.addEventListener('input', update));
    update();
  }

  document.addEventListener('DOMContentLoaded', initEvCalc);
  initEvCalc();
</script>
