---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../components/seo/RelatedLinks.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';

const faqs = [
  {
    question: 'Ist ein E-Auto auf 100 km günstiger als ein Benziner oder Diesel?',
    answer: 'Ja, beim Laden an der heimischen Wallbox (ca. 6,50 bis 7,00 € pro 100 km bei 35 ct/kWh) ist das E-Auto deutlich günstiger als ein vergleichbarer Benziner (ca. 7 Liter × 1,75 € = 12,25 €) oder Diesel (ca. 5,5 Liter × 1,65 € = 9,08 €).',
  },
];

const related = [
  { title: 'Ladekosten Rechner', href: '/e-auto/ladekosten-rechner', description: 'Rechner für E-Autos.' },
  { title: 'E-Auto Stromkosten', href: '/e-auto/stromkosten', description: 'Jahresgesamtkosten.' },
  { title: 'PV Eigenverbrauch', href: '/photovoltaik/eigenverbrauch-rechner', description: 'Solarstrom für 8–10 ct/kWh nutzen.' },
];
---

<BaseLayout
  title="E-Auto Kosten pro 100 km: Vergleich mit Benzin & Diesel | kWhKlar"
  description="Was kostet ein Elektroauto auf 100 km? Echte Verbrauchswerte, Stromkosten an Wallbox & Ladesäule im direkten Vergleich zu Benzin- und Dieselfahrzeugen."
  canonical="https://kwhklar.de/e-auto/kosten-pro-100-km"
  breadcrumbs={[
    { name: 'E-Auto', path: '/e-auto/stromkosten' },
    { name: 'Kosten pro 100 km', path: '/e-auto/kosten-pro-100-km' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'E-Auto', path: '/e-auto/stromkosten' },
        { name: 'Kosten pro 100 km', path: '/e-auto/kosten-pro-100-km' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-blue text-xs mb-2">Kraftstoff- & Stromvergleich</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        E-Auto Kosten pro 100 km im Vergleich
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Was kostet die Fahrt über 100 Kilometer mit dem Elektroauto im Vergleich zu Verbrennerfahrzeugen?
      </p>
    </div>

    <!-- Comparison Matrix -->
    <div class="my-8 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Vergleich: 100 km Fahrtkosten (Mittelklasse-Pkw)</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="p-3">Antrieb / Ladeart</th>
              <th class="p-3">Verbrauch pro 100 km</th>
              <th class="p-3">Energiepreis</th>
              <th class="p-3 text-right">Kosten / 100 km</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-600">
            <tr class="bg-emerald-50/50">
              <td class="p-3 font-semibold text-emerald-950">E-Auto (eigene PV-Anlage)</td>
              <td class="p-3">19,8 kWh (inkl. Verlust)</td>
              <td class="p-3">10 ct/kWh (Gestehungskosten)</td>
              <td class="p-3 text-right font-bold text-emerald-700">1,98 €</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-slate-900">E-Auto (Wallbox zu Hause)</td>
              <td class="p-3">19,8 kWh (inkl. Verlust)</td>
              <td class="p-3">35 ct/kWh (Haushaltstarif)</td>
              <td class="p-3 text-right font-bold text-slate-900">6,93 €</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-slate-900">Diesel-Pkw</td>
              <td class="p-3">5,5 Liter Diesel</td>
              <td class="p-3">1,65 € / Liter</td>
              <td class="p-3 text-right font-bold text-slate-900">9,08 €</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-slate-900">Benzin-Pkw (E10)</td>
              <td class="p-3">7,0 Liter Super E10</td>
              <td class="p-3">1,75 € / Liter</td>
              <td class="p-3 text-right font-bold text-slate-900">12,25 €</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-slate-900">E-Auto (HPC-Schnelllader Autobahn)</td>
              <td class="p-3">22,0 kWh (Autobahntempo)</td>
              <td class="p-3">65 ct/kWh (DC-Lader)</td>
              <td class="p-3 text-right font-bold text-amber-700">14,30 €</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'uba', 'destatis']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
