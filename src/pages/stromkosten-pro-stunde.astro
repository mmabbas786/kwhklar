---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversalCalculator from '../components/calculator/UniversalCalculator.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { getCalculatorSchema } from '../lib/structured-data';

const schema = getCalculatorSchema(
  'Stromkosten pro Stunde',
  'Berechne die genauen Stromkosten für 1 Betriebsstunde für beliebige Elektrogeräte von 10 Watt bis 3.000 Watt.',
  '/stromkosten-pro-stunde'
);

const faqs = [
  {
    question: 'Was kostet 1.000 Watt pro Stunde an Strom?',
    answer: '1.000 Watt (1 Kilowatt) verbrauchen in einer Stunde genau 1 kWh Strom. Bei einem Strompreis von 35 ct/kWh kostet eine Stunde Betrieb exakt 35 Cent.',
  },
  {
    question: 'Was kostet 2.000 Watt pro Stunde?',
    answer: '2.000 Watt verbrauchen pro Stunde 2 kWh. Das kostet bei 35 ct/kWh genau 70 Cent pro Stunde.',
  },
];

const related = [
  { title: 'Stromkosten pro Tag', href: '/stromkosten-pro-tag', description: 'Kosten für 24 Stunden oder tägliche Nutzung.' },
  { title: 'Stromkosten pro Monat', href: '/stromkosten-pro-monat', description: 'Monatliche Belastung ermitteln.' },
  { title: 'Watt in kWh Rechner', href: '/watt-rechner', description: 'Leistung präzise umrechnen.' },
];
---

<BaseLayout
  title="Stromkosten pro Stunde berechnen: Was kostet 1 Betriebsstunde? | kWhKlar"
  description="Berechne die Stromkosten pro Stunde für beliebige Wattstärken von 50W bis 3.000W. Mit anschaulicher Tabelle für typische Haushaltsgeräte."
  canonical="https://kwhklar.de/stromkosten-pro-stunde"
  jsonLd={schema}
  breadcrumbs={[{ name: 'Stromkosten pro Stunde', path: '/stromkosten-pro-stunde' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Stromkosten pro Stunde', path: '/stromkosten-pro-stunde' }]} />

    <div class="max-w-3xl mb-6">
      <span class="badge-blue text-xs mb-2">Stundenkosten</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Stromkosten pro Stunde: Was kostet eine Betriebsstunde Strom?
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Erfahre auf einen Blick, wie viel Strom ein Gerät pro Betriebsstunde verbraucht und was dich eine Stunde Betrieb kostet.
      </p>
    </div>

    <UniversalCalculator
      defaultWatt={1000}
      defaultHours={1}
      defaultPriceCt={35.0}
      title="Stundenkosten-Rechner"
      subtitle="Gib die Leistung in Watt ein, um die Kosten für 1 Betriebsstunde zu sehen:"
    />

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'bdew']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
