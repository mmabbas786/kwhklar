---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversalCalculator from '../components/calculator/UniversalCalculator.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { getCalculatorSchema, getFaqSchema } from '../lib/structured-data';

const faqs = [
  {
    question: "Wie viel kostet 100 Watt pro Stunde an Strom?",
    answer: "Ein 100-Watt-Gerät (wie ein Fernseher oder Laptop-Setup) verbraucht in einer Stunde genau 0,1 kWh Strom. Bei einem Strompreis von 35 ct/kWh kostet eine Stunde Betrieb exakt 0,035 € (3,5 Cent)."
  },
  {
    question: "Was verbraucht ein Gerät mit 1.000 Watt in der Stunde?",
    answer: "Ein 1.000-Watt-Gerät (1 kW, z. B. ein kleiner Staubsauger oder Wasserkocher) verbraucht in einer vollen Betriebsstunde exakt 1,0 kWh Strom. Bei 35 ct/kWh kostet eine Stunde genau 35 Cent."
  },
  {
    question: "Was kostet 500 Watt in der Stunde?",
    answer: "Ein 500-Watt-Gerät verbraucht 0,5 kWh pro Stunde. Bei einem Arbeitspreis von 35 ct/kWh entspricht das Stromkosten von exakt 17,5 Cent (0,175 €) pro Betriebsstunde."
  },
  {
    question: "Was kostet 1 Stunde mit 2.000 Watt (z. B. Heizlüfter)?",
    answer: "Ein 2.000-Watt-Gerät zieht 2,0 kWh pro Stunde aus der Steckdose. Das kostet bei 35 ct/kWh genau 0,70 € (70 Cent) pro Stunde."
  },
  {
    question: "Was kostet 3.000 Watt Strom pro Stunde?",
    answer: "3.000 Watt entsprechen 3,0 kWh pro Stunde. Bei 35 ct/kWh kostet eine Stunde Betrieb genau 1,05 €."
  },
  {
    question: "Was kostet 1 Stunde Fernsehen an Strom?",
    answer: "Ein moderner 55-Zoll-LED-Fernseher verbraucht ca. 80 bis 100 Watt. Eine Stunde Fernsehen kostet bei 35 ct/kWh ca. 2,8 bis 3,5 Cent."
  },
  {
    question: "Was kostet 1 Stunde Backofen bei 200 Grad?",
    answer: "Ein Backofen bei 200 °C Umluft verbraucht durch die Thermostattaktung im Schnitt ca. 0,85 bis 1,0 kWh pro Stunde. Das entspricht Stromkosten von ca. 30 bis 35 Cent pro Stunde."
  },
  {
    question: "Wie berechnet man die Stromkosten pro Stunde aus der Wattzahl?",
    answer: "Formel: (Leistung in Watt ÷ 1.000) × Strompreis in €/kWh = Kosten pro Stunde. Beispiel: 1.500 W ÷ 1.000 × 0,35 € = 0,525 € (52,5 Cent pro Stunde)."
  },
  {
    question: "Was kostet 1 Stunde Gaming am PC?",
    answer: "Ein Gaming-PC mit Monitor zieht unter Last ca. 350 bis 450 Watt (ca. 0,35 bis 0,45 kWh/h). Das kostet ca. 12 bis 16 Cent pro Stunde."
  },
  {
    question: "Was kostet 1 Stunde Klimaanlage an Strom?",
    answer: "Ein sparsames Inverter-Split-Klimagerät (ca. 500–700 W) kostet rund 18 bis 25 Cent pro Stunde. Ein mobiles Monoblock-Klimagerät (1.200 W) kostet ca. 42 Cent pro Stunde."
  }
];

const calcSchema = getCalculatorSchema(
  'Stromkosten pro Stunde Rechner',
  'Berechne die genauen Stromkosten für 1 Betriebsstunde für beliebige Elektrogeräte von 10 Watt bis 3.000 Watt.',
  '/stromkosten-pro-stunde'
);
const faqSchema = getFaqSchema(faqs);
const pageSchemas = faqSchema ? [calcSchema, faqSchema] : [calcSchema];

const related = [
  { title: 'Stromkosten pro Tag', href: '/stromkosten-pro-tag', description: 'Tageskosten & 24h-Dauerbetrieb.' },
  { title: 'Stromkosten pro Monat', href: '/stromkosten-pro-monat', description: 'Monatskosten & Abschläge berechnen.' },
  { title: 'Watt in kWh Rechner', href: '/watt-rechner', description: 'Watt präzise in kWh umrechnen.' },
  { title: 'Stromkostenrechner', href: '/stromkosten-rechner', description: 'Universeller Kostenrechner.' },
];
---

<BaseLayout
  title="Stromkosten pro Stunde berechnen: Was kostet 1 Betriebsstunde? | kWhKlar"
  description="Berechne die Stromkosten pro Stunde für beliebige Wattstärken von 10 W bis 3.000 W. Mit Tabelle für 100W, 500W, 1000W, 2000W & 3000W."
  canonical="https://kwhklar.de/stromkosten-pro-stunde"
  jsonLd={pageSchemas}
  breadcrumbs={[{ name: 'Stromkosten pro Stunde', path: '/stromkosten-pro-stunde' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Stromkosten pro Stunde', path: '/stromkosten-pro-stunde' }]} />

    <div class="max-w-4xl mb-8">
      <span class="badge-blue text-xs mb-2">Stundenkosten</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Stromkosten pro Stunde: Was kostet eine Betriebsstunde?
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Erfahre auf einen Blick, wie viel Strom ein Elektrogerät pro Stunde verbraucht und welche Kosten für eine Betriebsstunde bei deinem Stromtarif anfallen.
      </p>
    </div>

    <!-- Live Universal Calculator -->
    <UniversalCalculator
      defaultWatt={1000}
      defaultHours={1}
      defaultPriceCt={35.0}
      title="Stundenkosten-Rechner"
      subtitle="Gib die Leistung in Watt ein, um die Kosten für 1 Betriebsstunde zu sehen:"
    />

    <!-- Main Content Depth -->
    <div class="my-12 grid grid-cols-1 lg:grid-cols-12 gap-8">
      <article class="lg:col-span-8 space-y-10">
        
        <!-- Section: Formula & Table -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Die Stundenkosten-Formel
          </h2>
          <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6">
            Die Berechnung der Kosten für 1 Stunde ist denkbar einfach: Die Wattzahl wird durch 1.000 geteilt und mit dem Strompreis multipliziert:
          </p>

          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 font-mono text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400 mb-6">
            Kosten pro Stunde (€) = (Leistung in Watt ÷ 1.000) × Strompreis (€/kWh)
          </div>

          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
            Vergleichstabelle: Stromkosten pro Stunde von 10 W bis 3.000 W
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs sm:text-sm border-collapse">
              <thead>
                <tr class="border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400">
                  <th class="py-2.5 px-3 font-semibold">Leistung</th>
                  <th class="py-2.5 px-3 font-semibold">Typisches Gerät</th>
                  <th class="py-2.5 px-3 font-semibold">kWh in 1h</th>
                  <th class="py-2.5 px-3 font-semibold text-right">Kosten / 1h (@ 35 ct)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">10 W</td><td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">LED-Lampe, Router</td><td class="py-2.5 px-3">0,01 kWh</td><td class="py-2.5 px-3 text-right font-semibold">0,35 ct</td></tr>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30"><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">50 W</td><td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">Laptop, Standventilator</td><td class="py-2.5 px-3">0,05 kWh</td><td class="py-2.5 px-3 text-right font-semibold">1,75 ct</td></tr>
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">100 W</td><td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">55" TV, Office-Monitor</td><td class="py-2.5 px-3">0,10 kWh</td><td class="py-2.5 px-3 text-right font-semibold">3,50 ct</td></tr>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30"><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">250 W</td><td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">Luftentfeuchter, Aquarium</td><td class="py-2.5 px-3">0,25 kWh</td><td class="py-2.5 px-3 text-right font-semibold">8,75 ct</td></tr>
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">500 W</td><td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">Gaming-PC unter Last, Sandfilter</td><td class="py-2.5 px-3">0,50 kWh</td><td class="py-2.5 px-3 text-right font-semibold">17,50 ct</td></tr>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30"><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">800 W</td><td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">Wärmepumpentrockner, Mikrowelle</td><td class="py-2.5 px-3">0,80 kWh</td><td class="py-2.5 px-3 text-right font-semibold">28,00 ct</td></tr>
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">1.000 W</td><td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">Staubsauger, mobiles Klimagerät</td><td class="py-2.5 px-3">1,00 kWh</td><td class="py-2.5 px-3 text-right font-semibold">35,00 ct</td></tr>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30"><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">1.500 W</td><td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">Kaffeevollautomat, Föhn</td><td class="py-2.5 px-3">1,50 kWh</td><td class="py-2.5 px-3 text-right font-semibold">52,50 ct</td></tr>
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">2.000 W</td><td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">Heizlüfter, Waschmaschine (Heizen)</td><td class="py-2.5 px-3">2,00 kWh</td><td class="py-2.5 px-3 text-right font-bold text-amber-700 dark:text-amber-400">70,00 ct</td></tr>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30"><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">2.500 W</td><td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">Kondenstrockner, Wasserkocher</td><td class="py-2.5 px-3">2,50 kWh</td><td class="py-2.5 px-3 text-right font-bold text-amber-700 dark:text-amber-400">87,50 ct</td></tr>
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">3.000 W</td><td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">Backofen, Bauheizer, Herdplatte</td><td class="py-2.5 px-3">3,00 kWh</td><td class="py-2.5 px-3 text-right font-bold text-amber-700 dark:text-amber-400">1,05 €</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- FAQ Section -->
        <FaqSection items={faqs} />
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-900 p-6 text-white shadow-md">
          <h3 class="font-bold text-emerald-400 text-sm uppercase tracking-wider mb-3">
            Faustregel Stundenkosten
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Bei 35 ct/kWh kostet jedes 100-Watt-Gerät genau <strong>3,5 Cent pro Stunde</strong>.
          </p>
          <ul class="text-xs space-y-2 text-slate-300">
            <li>100 W = 3,5 ct/h</li>
            <li>500 W = 17,5 ct/h</li>
            <li>1.000 W = 35 ct/h</li>
            <li>2.000 W = 70 ct/h</li>
          </ul>
        </div>

        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
          <h3 class="font-bold text-slate-900 dark:text-white text-sm mb-4">Weitere Zeiträume</h3>
          <ul class="space-y-2 text-xs">
            <li><a href="/stromkosten-pro-tag" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromkosten pro Tag</a></li>
            <li><a href="/stromkosten-pro-woche" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromkosten pro Woche</a></li>
            <li><a href="/stromkosten-pro-monat" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromkosten pro Monat</a></li>
            <li><a href="/stromkosten-pro-jahr" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromkosten pro Jahr</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'bdew']} />
  </div>
</BaseLayout>
