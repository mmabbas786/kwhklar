---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { getCalculatorSchema } from '../lib/structured-data';
import { calculatorFaqs } from '../data/calculator-faqs';

const schema = getCalculatorSchema(
  'kWh Rechner',
  'Rechne beliebige Kilowattstunden (kWh) direkt in Euro um bei aktuellem Strompreis.',
  '/kwh-rechner'
);

const faqs = calculatorFaqs['kwh-rechner'] || [];

const related = [
  { title: 'Watt in kWh Rechner', href: '/watt-rechner', description: 'Leistung in Kilowattstunden umrechnen.' },
  { title: 'Stromkostenrechner', href: '/stromkosten-rechner', description: 'Kosten aus Watt & Stunden berechnen.' },
  { title: 'Strompreis pro kWh', href: '/strompreis-pro-kwh', description: 'Aktuelle Strompreise in Deutschland.' },
];
---

<BaseLayout
  title="kWh Rechner: Kilowattstunden in Euro & Kosten umrechnen | kWhKlar"
  description="Rechne beliebige Kilowattstunden (kWh) direkt in Euro um oder ermittle die Kosten für 100, 500, 1.000 oder 3.500 kWh Stromverbrauch."
  canonical="https://kwhklar.de/kwh-rechner"
  jsonLd={schema}
  breadcrumbs={[{ name: 'kWh Rechner', path: '/kwh-rechner' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'kWh Rechner', path: '/kwh-rechner' }]} />

    <div class="max-w-3xl mb-6">
      <span class="badge-emerald text-xs mb-2">Umrechner</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        kWh Rechner: Kilowattstunden in Euro umrechnen
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Rechne jede beliebige Menge an Kilowattstunden (kWh) unkompliziert in Euro um.
      </p>
    </div>

    <!-- Direct kWh to Euro Converter Card -->
    <div class="mx-auto my-8 max-w-4xl rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-md">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-slate-900">kWh & Strompreis eingeben</h2>
          
          <div>
            <label for="kwh-input" class="block text-sm font-semibold text-slate-900 mb-1">
              Strommenge in Kilowattstunden (kWh)
            </label>
            <input
              type="number"
              id="kwh-input"
              value="500"
              min="0"
              step="1"
              class="w-full rounded-xl border border-slate-200 p-3 text-lg font-bold text-slate-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
            />
          </div>

          <div>
            <label for="kwh-price-input" class="block text-sm font-semibold text-slate-900 mb-1">
              Strompreis in ct/kWh
            </label>
            <input
              type="number"
              id="kwh-price-input"
              value="35.0"
              min="1"
              step="0.1"
              class="w-full rounded-xl border border-slate-200 p-3 text-lg font-bold text-slate-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
            />
          </div>

          <div class="flex flex-wrap gap-2 pt-1">
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-800" data-kwh="100">100 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-800" data-kwh="500">500 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-800" data-kwh="1000">1.000 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-800" data-kwh="2500">2.500 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-800" data-kwh="3500">3.500 kWh</button>
          </div>
        </div>

        <div class="rounded-2xl bg-gradient-to-br from-slate-900 to-slate-800 p-6 text-white text-center space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Gesamtkosten</span>
          <div class="text-4xl sm:text-5xl font-extrabold text-emerald-400 tracking-tight" id="kwh-result-euro">
            175,00 €
          </div>
          <p class="text-xs text-slate-300" id="kwh-result-desc">
            500 kWh bei 35,0 ct/kWh
          </p>
          <div class="pt-3 border-t border-slate-700 text-[11px] text-slate-400">
            Formel: <code class="text-emerald-300 font-mono">Kosten = kWh × (ct/kWh ÷ 100)</code>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Reference Table -->
    <div class="my-10 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Übersicht: Typische kWh-Mengen in Euro (bei 35 ct/kWh)</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="p-3">Verbrauchsmenge</th>
              <th class="p-3">Kosten bei 30 ct/kWh</th>
              <th class="p-3">Kosten bei 35 ct/kWh (Referenz)</th>
              <th class="p-3">Kosten bei 40 ct/kWh</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-600">
            <tr><td class="p-3 font-semibold text-slate-900">1 kWh</td><td class="p-3">0,30 €</td><td class="p-3 font-semibold text-emerald-700">0,35 €</td><td class="p-3">0,40 €</td></tr>
            <tr><td class="p-3 font-semibold text-slate-900">100 kWh</td><td class="p-3">30,00 €</td><td class="p-3 font-semibold text-emerald-700">35,00 €</td><td class="p-3">40,00 €</td></tr>
            <tr><td class="p-3 font-semibold text-slate-900">500 kWh</td><td class="p-3">150,00 €</td><td class="p-3 font-semibold text-emerald-700">175,00 €</td><td class="p-3">200,00 €</td></tr>
            <tr><td class="p-3 font-semibold text-slate-900">1.000 kWh</td><td class="p-3">300,00 €</td><td class="p-3 font-semibold text-emerald-700">350,00 €</td><td class="p-3">400,00 €</td></tr>
            <tr><td class="p-3 font-semibold text-slate-900">2.500 kWh (2 Personen)</td><td class="p-3">750,00 €</td><td class="p-3 font-semibold text-emerald-700">875,00 €</td><td class="p-3">1.000,00 €</td></tr>
            <tr><td class="p-3 font-semibold text-slate-900">3.500 kWh (Familie)</td><td class="p-3">1.050,00 €</td><td class="p-3 font-semibold text-emerald-700">1.225,00 €</td><td class="p-3">1.400,00 €</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'bdew']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>

<script>
  function initKwhConverter() {
    const kwhInput = document.getElementById('kwh-input') as HTMLInputElement | null;
    const priceInput = document.getElementById('kwh-price-input') as HTMLInputElement | null;
    const resultEuro = document.getElementById('kwh-result-euro');
    const resultDesc = document.getElementById('kwh-result-desc');

    if (!kwhInput || !priceInput || !resultEuro || !resultDesc) return;

    function update() {
      const kwh = Math.max(0, parseFloat(kwhInput?.value || '0') || 0);
      const priceCt = Math.max(0, parseFloat(priceInput?.value || '0') || 0);
      const total = kwh * (priceCt / 100);

      if (resultEuro) resultEuro.textContent = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(total);
      if (resultDesc) resultDesc.textContent = `${kwh.toLocaleString('de-DE')} kWh bei ${priceCt.toLocaleString('de-DE')} ct/kWh`;
    }

    kwhInput.addEventListener('input', update);
    priceInput.addEventListener('input', update);

    document.querySelectorAll('.quick-kwh').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const val = target.dataset.kwh;
        if (val && kwhInput) {
          kwhInput.value = val;
          update();
        }
      });
    });

    update();
  }

  document.addEventListener('DOMContentLoaded', initKwhConverter);
  initKwhConverter();
</script>
