---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { getCalculatorSchema, getFaqSchema } from '../lib/structured-data';

const faqs = [
  {
    question: "Wie rechne ich Kilowattstunden (kWh) in Euro um?",
    answer: "Um Kilowattstunden in Euro umzurechnen, multiplizierst du die verbrauchten kWh mit deinem Arbeitspreis in Euro (ct/kWh ÷ 100). Formel: Kosten (€) = kWh × (Strompreis in ct/kWh ÷ 100). Beispiel: 2.500 kWh × 0,35 € = 875,00 Euro."
  },
  {
    question: "Was ist 1 kWh auf dem Stromzähler?",
    answer: "1 kWh auf dem Stromzähler bedeutet, dass 1.000 Wattstunden elektrische Energie durch deine Leitungen geflossen sind. Das entspricht der letzten Ziffer vor dem Komma auf einem klassischen Drehstromzähler oder der Zahl hinter '1.8.0' auf einem modernen digitalen Stromzähler."
  },
  {
    question: "Was kostet 1 kWh Strom in Deutschland?",
    answer: "Im bundesweiten Durchschnitt kostet 1 kWh Strom für Haushaltskunden ca. 35 Cent (0,35 €). Je nach Stromanbieter und Tarif liegen die Preise zwischen ca. 28 Cent (günstige Neukundentarife) und bis zu 45 Cent (örtliche Grundversorgung)."
  },
  {
    question: "Sind 4.000 kWh Strom im Jahr viel?",
    answer: "Für eine 4-köpfige Familie in einem Einfamilienhaus oder mit elektrischer Warmwasserbereitung ist ein Jahresverbrauch von 4.000 kWh völlig normal. Für einen Single- oder 2-Personen-Haushalt in einer Wohnung sind 4.000 kWh hingegen außergewöhnlich hoch und deuten auf heimliche Stromfresser oder Dauerheizer hin."
  },
  {
    question: "Sind 2.000 kWh Strom viel?",
    answer: "Für einen 2-Personen-Haushalt in einer Mietwohnung ohne elektrische Warmwasserbereitung sind 2.000 kWh ein idealer, energieeffizienter Durchschnittswert. Für eine Einzelperson ist es leicht erhöht, für eine Familie sehr sparsam."
  },
  {
    question: "Sind 500 kWh Strom viel?",
    answer: "500 kWh entspricht etwa dem Jahresverbrauch einer sehr sparsamen Person in einem Mikro-Apartment oder dem Strombedarf einzelner Großgeräte (z. B. ein alter Kondenstrockner oder ein 24/7 laufender Server verbrauchen ca. 300–500 kWh pro Jahr)."
  },
  {
    question: "Was kann man mit 1 kWh Strom alles machen?",
    answer: "Mit genau 1 kWh Strom kannst du beispielsweise: 1 Waschladung bei 40–60 °C waschen, ca. 70 Tassen Filterkaffee kochen, 10 Stunden lang auf einem 100-Watt-Fernseher fernsehen, rund 50 Stunden mit einer LED-Lampe leuchten oder ca. 5 bis 7 Kilometer mit einem Elektroauto fahren."
  },
  {
    question: "Was kosten 100 kWh, 500 kWh, 1.000 kWh und 3.000 kWh Strom?",
    answer: "Bei einem Standardpreis von 35 ct/kWh kosten: 100 kWh = 35,00 €; 500 kWh = 175,00 €; 1.000 kWh = 350,00 €; 3.000 kWh = 1.050,00 €; 4.000 kWh = 1.400,00 € (jeweils zzgl. des festen monatlichen Grundpreises)."
  },
  {
    question: "Wie viele kWh verbraucht ein 1-Personen-Haushalt im Durchschnitt?",
    answer: "Ein Single in einer Mietwohnung verbraucht ca. 1.300 bis 1.500 kWh pro Jahr (bei zentraler Warmwasserbereitung). Bei elektrischem Durchlauferhitzer im Bad steigt der Verbrauch auf ca. 1.800 bis 2.200 kWh."
  },
  {
    question: "Wie viele kWh verbraucht eine 4-köpfige Familie im Durchschnitt?",
    answer: "Eine 4-köpfige Familie verbraucht im Schnitt ca. 3.000 bis 4.000 kWh pro Jahr in einer Wohnung bzw. ca. 4.000 bis 5.400 kWh in einem Einfamilienhaus."
  },
  {
    question: "Wie viele kWh verbraucht eine Wärmepumpe im Jahr?",
    answer: "Eine moderne Luft-Wasser-Wärmepumpe in einem gut gedämmten Einfamilienhaus verbraucht für Heizung und Warmwasser ca. 3.000 bis 5.000 kWh Strom pro Jahr."
  },
  {
    question: "Wie viele kWh verbraucht ein Elektroauto auf 100 km?",
    answer: "Ein gängiges Elektroauto (wie VW ID.3, Tesla Model 3) verbraucht im Realbetrieb ca. 15 bis 20 kWh Strom pro 100 Kilometer Fahrtstrecke (ca. 5,25 bis 7,00 € bei 35 ct/kWh an der heimischen Wallbox)."
  }
];

const calcSchema = getCalculatorSchema(
  'kWh in Euro Rechner',
  'Rechne beliebige Kilowattstunden (kWh) direkt in Euro um bei aktuellem Strompreis.',
  '/kwh-rechner'
);
const faqSchema = getFaqSchema(faqs);
const pageSchemas = faqSchema ? [calcSchema, faqSchema] : [calcSchema];

const related = [
  { title: 'Watt in kWh Rechner', href: '/watt-rechner', description: 'Leistung in Kilowattstunden umrechnen.' },
  { title: 'Stromkostenrechner', href: '/stromkosten-rechner', description: 'Kosten aus Watt & Stunden berechnen.' },
  { title: 'Strompreis pro kWh', href: '/strompreis-pro-kwh', description: 'Aktuelle Strompreise in Deutschland.' },
  { title: 'Stromverbrauch Haushalt', href: '/stromverbrauch-haushalt', description: 'Richtwerte für 1 bis 5 Personen.' },
];
---

<BaseLayout
  title="kWh Rechner: Kilowattstunden in Euro umrechnen | kWhKlar"
  description="Rechne beliebige Kilowattstunden (kWh) direkt in Euro um. Mit Umrechnungstabelle für 100, 500, 1.000, 3.000 & 4.000 kWh und Alltagsbeispielen."
  canonical="https://kwhklar.de/kwh-rechner"
  jsonLd={pageSchemas}
  breadcrumbs={[{ name: 'kWh Rechner', path: '/kwh-rechner' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'kWh Rechner', path: '/kwh-rechner' }]} />

    <div class="max-w-4xl mb-8">
      <span class="badge-emerald text-xs mb-2">kWh &amp; Euro Umrechner</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        kWh Rechner: Kilowattstunden in Euro umrechnen
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Rechne jede beliebige Strommenge in Kilowattstunden (kWh) unkompliziert in Euro um. Erfahre sofort, was 100, 500, 1.000, 2.500 oder 4.000 kWh Strom bei deinem aktuellen Stromtarif kosten.
      </p>
    </div>

    <!-- Direct kWh to Euro Converter Card -->
    <div class="mx-auto my-8 max-w-4xl rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-md">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">kWh &amp; Strompreis eingeben</h2>
          
          <div>
            <label for="kwh-input" class="block text-sm font-semibold text-slate-900 dark:text-white mb-1">
              Strommenge in Kilowattstunden (kWh)
            </label>
            <input
              type="number"
              id="kwh-input"
              value="500"
              min="0"
              step="1"
              class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-lg font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
            />
          </div>

          <div>
            <label for="kwh-price-input" class="block text-sm font-semibold text-slate-900 dark:text-white mb-1">
              Strompreis in ct/kWh
            </label>
            <input
              type="number"
              id="kwh-price-input"
              value="35.0"
              min="1"
              step="0.1"
              class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-lg font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
            />
          </div>

          <div class="flex flex-wrap gap-2 pt-1">
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-emerald-50 hover:text-emerald-800" data-kwh="100">100 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-emerald-50 hover:text-emerald-800" data-kwh="500">500 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-emerald-50 hover:text-emerald-800" data-kwh="1000">1.000 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-emerald-50 hover:text-emerald-800" data-kwh="2500">2.500 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-emerald-50 hover:text-emerald-800" data-kwh="3500">3.500 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-emerald-50 hover:text-emerald-800" data-kwh="4000">4.000 kWh</button>
          </div>
        </div>

        <div class="rounded-2xl bg-gradient-to-br from-slate-900 to-slate-800 p-6 text-white text-center space-y-4 shadow-inner">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Errechnete Stromkosten</span>
          <div class="text-4xl sm:text-5xl font-extrabold text-emerald-400 tracking-tight" id="kwh-result-euro">
            175,00 €
          </div>
          <p class="text-xs text-slate-300" id="kwh-result-desc">
            500 kWh bei 35,0 ct/kWh
          </p>
          <div class="pt-3 border-t border-slate-700 text-[11px] text-slate-400">
            Formel: <code class="text-emerald-300 font-mono">Kosten = kWh × (ct/kWh ÷ 100)</code>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Depth -->
    <div class="my-12 grid grid-cols-1 lg:grid-cols-12 gap-8">
      <article class="lg:col-span-8 space-y-10">
        
        <!-- Section: Big Benchmark Matrix Table for kWh in Euro -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Vergleichstabelle: Was kosten Kilowattstunden in Euro?
          </h2>
          <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6">
            In der folgenden Übersicht siehst du die Stromkosten für gängige Verbrauchsmengen bei günstigen Neukundentarifen (30 ct), dem Bundesdurchschnitt (35 ct) und der Grundversorgung (40 ct):
          </p>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs sm:text-sm border-collapse">
              <thead>
                <tr class="border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400">
                  <th class="py-3 px-3 font-semibold">Strommenge (kWh)</th>
                  <th class="py-3 px-3 font-semibold">Kosten bei 30 ct/kWh</th>
                  <th class="py-3 px-3 font-semibold text-emerald-700 dark:text-emerald-400">Kosten bei 35 ct/kWh (Ø)</th>
                  <th class="py-3 px-3 font-semibold">Kosten bei 40 ct/kWh</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">1 kWh</td><td class="py-2.5 px-3">0,30 €</td><td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">0,35 €</td><td class="py-2.5 px-3">0,40 €</td></tr>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30"><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">10 kWh</td><td class="py-2.5 px-3">3,00 €</td><td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">3,50 €</td><td class="py-2.5 px-3">4,00 €</td></tr>
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">100 kWh</td><td class="py-2.5 px-3">30,00 €</td><td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">35,00 €</td><td class="py-2.5 px-3">40,00 €</td></tr>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30"><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">500 kWh</td><td class="py-2.5 px-3">150,00 €</td><td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">175,00 €</td><td class="py-2.5 px-3">200,00 €</td></tr>
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">1.000 kWh</td><td class="py-2.5 px-3">300,00 €</td><td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">350,00 €</td><td class="py-2.5 px-3">400,00 €</td></tr>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30"><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">1.500 kWh (1P Ø)</td><td class="py-2.5 px-3">450,00 €</td><td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">525,00 €</td><td class="py-2.5 px-3">600,00 €</td></tr>
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">2.500 kWh (2P Ø)</td><td class="py-2.5 px-3">750,00 €</td><td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">875,00 €</td><td class="py-2.5 px-3">1.000,00 €</td></tr>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30"><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">3.500 kWh (3P Ø)</td><td class="py-2.5 px-3">1.050,00 €</td><td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">1.225,00 €</td><td class="py-2.5 px-3">1.400,00 €</td></tr>
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">4.000 kWh (4P Ø)</td><td class="py-2.5 px-3">1.200,00 €</td><td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">1.400,00 €</td><td class="py-2.5 px-3">1.600,00 €</td></tr>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30"><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">5.000 kWh (Haus/WP)</td><td class="py-2.5 px-3">1.500,00 €</td><td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">1.750,00 €</td><td class="py-2.5 px-3">2.000,00 €</td></tr>
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-xs text-slate-400 dark:text-slate-500">
            * Reine Verbrauchskosten ohne monatlichen Grundpreis.
          </p>
        </section>

        <!-- Section: What does 1 kWh do in reality? -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Alltagsvergleich: Was leistet 1 Kilowattstunde (kWh) Strom?
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="font-bold text-slate-900 dark:text-white block mb-1">🧺 Waschen &amp; Spülen</strong>
              <p class="text-slate-600 dark:text-slate-400">Reicht für ca. 1,5 bis 2 Waschgänge bei 30–40 °C im Eco-Modus oder 1 intensiven Spülgang im Geschirrspüler.</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="font-bold text-slate-900 dark:text-white block mb-1">📺 Unterhaltung &amp; PC</strong>
              <p class="text-slate-600 dark:text-slate-400">Reicht für ca. 10 Stunden Fernsehen auf einem 55-Zoll-LED-TV oder ca. 15 Stunden Arbeiten am Office-Laptop.</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="font-bold text-slate-900 dark:text-white block mb-1">☕ Küche &amp; Kochen</strong>
              <p class="text-slate-600 dark:text-slate-400">Reicht für ca. 70 Tassen Filterkaffee, 10 Liter kochendes Teewasser im Wasserkocher oder 1 Tiefkühlpizza im Ofen.</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="font-bold text-slate-900 dark:text-white block mb-1">🚗 Mobilität &amp; E-Auto</strong>
              <p class="text-slate-600 dark:text-slate-400">Reicht für ca. 5 bis 7 Kilometer Fahrt mit einem Elektroauto oder rund 100 km mit einem E-Bike.</p>
            </div>
          </div>
        </section>

        <!-- FAQ Section -->
        <FaqSection items={faqs} />
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-900 p-6 text-white shadow-md">
          <h3 class="font-bold text-emerald-400 text-sm uppercase tracking-wider mb-3">
            kWh Rechner Formel
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Die Berechnung der Kosten erfolgt direkt über die Multiplikation der Kilowattstunden mit dem Arbeitspreis:
          </p>
          <div class="p-3.5 rounded-xl bg-slate-800 border border-slate-700 font-mono text-xs text-emerald-300 mb-4">
            Kosten (€) = kWh × (ct/kWh ÷ 100)
          </div>
          <div class="text-xs text-slate-400">
            Beispiel: 3.500 kWh × 0,35 € = <strong>1.225,00 €</strong>
          </div>
        </div>

        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
          <h3 class="font-bold text-slate-900 dark:text-white text-sm mb-4">Verwandte Tools</h3>
          <ul class="space-y-2 text-xs">
            <li><a href="/watt-rechner" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Watt in kWh umrechnen</a></li>
            <li><a href="/stromkosten-pro-monat" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromkosten pro Monat</a></li>
            <li><a href="/stromkosten-pro-jahr" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromkosten pro Jahr</a></li>
            <li><a href="/stromverbrauch-haushalt" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromverbrauch im Haushalt</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'bdew', 'destatis']} />
  </div>
</BaseLayout>

<script>
  const kwhInput = document.getElementById('kwh-input') as HTMLInputElement | null;
  const priceInput = document.getElementById('kwh-price-input') as HTMLInputElement | null;
  const resultEuro = document.getElementById('kwh-result-euro');
  const resultDesc = document.getElementById('kwh-result-desc');
  const quickButtons = document.querySelectorAll('.quick-kwh');

  function calculate() {
    if (!kwhInput || !priceInput || !resultEuro || !resultDesc) return;
    const kwh = parseFloat(kwhInput.value) || 0;
    const priceCt = parseFloat(priceInput.value) || 0;
    const totalEuro = (kwh * priceCt) / 100;

    resultEuro.textContent = totalEuro.toLocaleString('de-DE', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }) + ' €';

    resultDesc.textContent = `${kwh.toLocaleString('de-DE')} kWh bei ${priceCt.toFixed(1).replace('.', ',')} ct/kWh`;
  }

  kwhInput?.addEventListener('input', calculate);
  priceInput?.addEventListener('input', calculate);

  quickButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const kwh = btn.getAttribute('data-kwh');
      if (kwh && kwhInput) {
        kwhInput.value = kwh;
        calculate();
      }
    });
  });
</script>
