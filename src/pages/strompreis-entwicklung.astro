---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { electricityPriceData } from '../data/electricity-price';

const faqs = [
  {
    question: 'Warum stiegen die Strompreise 2022 und 2023 so stark an?',
    answer: 'Durch den Krieg in der Ukraine und den Wegfall russischer Erdgaslieferungen stiegen die Großhandelspreise für Gas und Steinkohle an der Strombörse extrem an. Wegen des „Merit-Order-Prinzips“ bestimmten teure Gaskraftwerke oft den Börsenstrompreis.',
  },
];

const related = [
  { title: 'Strompreis Zusammensetzung', href: '/strompreis-zusammensetzung', description: 'Wie entsteht der Preis?' },
  { title: 'Dynamische Stromtarife', href: '/dynamische-stromtarife', description: 'Börsenstrompreise nutzen.' },
  { title: 'Strompreis Deutschland', href: '/strompreis-deutschland', description: 'Aktuelle Marktdaten.' },
];
---

<BaseLayout
  title="Strompreis Entwicklung Deutschland: Historische Preise 2018–2026 | kWhKlar"
  description="Wie haben sich die Strompreise in Deutschland entwickelt? Historische Daten, Ursachen der Energiekrise und aktuelle Trends im Überblick."
  canonical="https://kwhklar.de/strompreis-entwicklung"
  breadcrumbs={[
    { name: 'Strompreis', path: '/strompreis' },
    { name: 'Strompreis Entwicklung', path: '/strompreis-entwicklung' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Strompreis', path: '/strompreis' },
        { name: 'Strompreis Entwicklung', path: '/strompreis-entwicklung' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Historie & Analyse</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Strompreis-Entwicklung in Deutschland (2018–2026)
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Verfolge die Entwicklung des durchschnittlichen Haushaltsstrompreises über die letzten Jahre nach Daten des BDEW und der Bundesnetzagentur.
      </p>
    </div>

    <!-- Historical Chart / Table -->
    <div class="my-8 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-slate-900 mb-6">Durchschnittliche Strompreise für Haushalte</h2>
      <div class="space-y-4">
        {electricityPriceData.historicalTrends.map((item) => {
          const maxVal = 50;
          const pct = Math.round((item.averagePriceCtPerKwh / maxVal) * 100);
          return (
            <div>
              <div class="flex justify-between text-xs sm:text-sm font-semibold mb-1">
                <span class="text-slate-900">{item.year}</span>
                <span class="text-emerald-700 font-bold">{item.averagePriceCtPerKwh.toFixed(2).replace('.', ',')} ct/kWh</span>
              </div>
              <div class="h-3 w-full rounded-full bg-slate-100 overflow-hidden">
                <div
                  class="h-full bg-gradient-to-r from-emerald-500 to-teal-600 rounded-full"
                  style={`width: ${pct}%`}
                ></div>
              </div>
              <span class="text-[11px] text-slate-500 mt-1 block">{item.note}</span>
            </div>
          );
        })}
      </div>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'bdew', 'destatis']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
