---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';

const faqs = [
  {
    question: 'Wie viel Strom und Geld kann man realistisch im Haushalt sparen?',
    answer: 'Ein durchschnittlicher deutscher 3- bis 4-Personen-Haushalt kann durch einfache Verhaltensänderungen und das Ausschalten von Standby-Verlusten 15 bis 25 % Strom (ca. 400 bis 800 kWh = 140 bis 280 €/Jahr) einsparen. Durch den Austausch alter Großgeräte (Kühlschrank, Trockner) sind oft 30–40 % Ersparnis möglich.',
  },
];

const related = [
  { title: 'Die größten Stromfresser', href: '/stromfresser', description: 'Top Stromverbraucher erkennen.' },
  { title: 'Standby-Strom vermeiden', href: '/standby-strom', description: 'Leerlaufverluste berechnen.' },
  { title: 'Konkrete Stromspartipps', href: '/strom-sparen-tipps', description: 'Alltagstipps für Küche, Bad & Büro.' },
  { title: 'Stromanbieter wechseln', href: '/stromanbieter-wechseln', description: 'Tarif wechseln & sparen.' },
];
---

<BaseLayout
  title="Strom sparen im Haushalt: Die besten Strategien & Rechner | kWhKlar"
  description="Effektiv Strom sparen im Haushalt: Die größten Hebel, Spartipps für Großgeräte, Standby-Vermeidung und Anbietervergleich."
  canonical="https://kwhklar.de/strom-sparen"
  breadcrumbs={[{ name: 'Strom sparen', path: '/strom-sparen' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Strom sparen', path: '/strom-sparen' }]} />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Spar-Zentrale</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Strom sparen im Haushalt: Der praktische Leitfaden
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Erfahre, wie du deinen Stromverbrauch Schritt für Schritt analysierst, versteckte Stromfresser aufspürst und deine Stromkosten nachhaltig reduzierst.
      </p>
    </div>

    <!-- 5-Step Saving Workflow Grid -->
    <div class="my-10 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-xs max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-slate-900 mb-6">Das 5-Schritte-System zum Stromsparen</h2>
      <div class="space-y-4 text-xs sm:text-sm">
        <div class="flex gap-4 items-start rounded-2xl bg-slate-50 p-4 border border-slate-100">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 font-bold">1</span>
          <div>
            <strong class="text-slate-900 block font-bold mb-0.5">Ist-Zustand erfassen:</strong>
            Letzte Stromrechnung prüfen und den eigenen Jahresverbrauch mit den Richtwerten für deine Haushaltsgröße vergleichen.
          </div>
        </div>

        <div class="flex gap-4 items-start rounded-2xl bg-slate-50 p-4 border border-slate-100">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 font-bold">2</span>
          <div>
            <strong class="text-slate-900 block font-bold mb-0.5">Stromfresser messen:</strong>
            Mit einem Zwischensteck-Messgerät für 24 bis 48 Stunden Kühlschrank, PC-Setup, TV und Gefriertruhe nachmessen.
          </div>
        </div>

        <div class="flex gap-4 items-start rounded-2xl bg-slate-50 p-4 border border-slate-100">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 font-bold">3</span>
          <div>
            <strong class="text-slate-900 block font-bold mb-0.5">Standby-Verluste stoppen:</strong>
            Schaltbare Steckdosenleisten an Entertainment-Centern, Arbeitsplätzen und Ladestationen installieren.
          </div>
        </div>

        <div class="flex gap-4 items-start rounded-2xl bg-slate-50 p-4 border border-slate-100">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 font-bold">4</span>
          <div>
            <strong class="text-slate-900 block font-bold mb-0.5">Eco-Modi konsequent nutzen:</strong>
            Waschmaschine bei 30 °C und Spülmaschine im Eco-50°C-Programm laufen lassen.
          </div>
        </div>

        <div class="flex gap-4 items-start rounded-2xl bg-slate-50 p-4 border border-slate-100">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 font-bold">5</span>
          <div>
            <strong class="text-slate-900 block font-bold mb-0.5">Tarif optimieren / Eigenstrom erzeugen:</strong>
            Stromvertrag prüfen und ggf. ein Balkonkraftwerk (Steckersolar) auf Balkon oder Terrasse in Betrieb nehmen.
          </div>
        </div>
      </div>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['stromspiegel', 'uba', 'bnetza']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
