---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../components/seo/RelatedLinks.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';
import { getFaqSchema } from '../../lib/structured-data';

const faqs = [
  {
    question: "Was kostet der Strom für eine Wärmepumpe im Einfamilienhaus pro Jahr?",
    answer: "In einem gut gedämmten Neubau (ca. 2.000 kWh Strombedarf) liegen die jährlichen Stromkosten bei einem Heizstrompreis von 28 ct/kWh bei ca. 560 Euro. In einem teilsanierten Altbau (ca. 5.000 kWh Strombedarf) betragen die Heizstromkosten ca. 1.400 Euro pro Jahr."
  },
  {
    question: "Lohnt sich ein separater Wärmepumpenstromtarif mit eigenem Zähler?",
    answer: "Ein separater Wärmepumpentarif (oft 22 bis 28 ct/kWh statt 35 ct/kWh) lohnt sich in der Regel ab einem Wärmepumpen-Stromverbrauch von ca. 2.500 bis 3.000 kWh pro Jahr. Bei geringerem Verbrauch fressen die zusätzlichen Grund- und Messstellengebühren für den zweiten Zähler (ca. 60–100 €/Jahr) den Preisvorteil wieder auf."
  },
  {
    question: "Was besagt die Neuregelung zu § 14a EnWG für Wärmepumpen seit 2024?",
    answer: "Seit 1. Januar 2024 gelten neue Wärmepumpen als 'steuerbare Verbrauchseinrichtungen'. Der Netzbetreiber darf sie bei akuter Netzüberlastung vorübergehend auf 4,2 kW dimmen. Als Gegenleistung erhält der Betreiber einen garantierten Netzentgelt-Rabatt: Modul 1 (pauschale Gutschrift von ca. 110 bis 190 €/Jahr) oder Modul 2 (60 % Rabatt auf den Arbeitspreis der Netzentgelte)."
  },
  {
    question: "Was ist eine Kaskadenschaltung (Zählerkaskade)?",
    answer: "Ein intelligentes Messkonzept mit zwei hintereinander geschalteten Zählern. Sie ermöglicht es, sowohl den günstigen Heizstromtarif für die Wärmepumpe zu nutzen als auch eigenen Solarstrom vom Dach vorrangig in die Wärmepumpe und den Haushalt einzuspeisen."
  },
  {
    question: "Wie hoch sind die monatlichen Stromkosten für eine Wärmepumpe?",
    answer: "Verteilt über das gesamte Jahr liegen die Abschlagszahlungen für den Wärmepumpenstrom im Neubau bei ca. 45 bis 60 Euro monatlich und im teilsanierten Altbau bei ca. 100 bis 135 Euro monatlich."
  },
  {
    question: "Ist Heizen mit Wärmepumpe günstiger als mit Gas oder Öl?",
    answer: "Ja. Selbst bei einem Strompreis von 30 ct/kWh erzeugt eine moderne Wärmepumpe mit JAZ 3,8 eine Kilowattstunde Nutzwärme für ca. 7,9 Cent. Bei Gas oder Heizöl (10–12 ct/kWh Brennstoffkosten) liegt die Nutzwärme unter Berücksichtigung von Abgasverlusten bei 11 bis 14 ct/kWh. Die Wärmepumpe spart ca. 30 bis 45 % der reinen Heizkosten."
  },
  {
    question: "Gibt es Sperrzeiten beim Wärmepumpenstrom?",
    answer: "Früher schalteten Netzbetreiber Wärmepumpen bis zu 3-mal täglich für maximal 2 Stunden komplett ab. Unter dem neuen § 14a EnWG sind Komplettabschaltungen unzulässig; die Wärmepumpe darf im Notfall nur noch auf eine Mindestleistung von 4,2 kW gedrosselt werden, was für die Grundheizung völlig ausreicht."
  },
  {
    question: "Wie viel Heizstrom spart eine Photovoltaikanlage?",
    answer: "Eine 10-kWp-PV-Anlage kann ca. 20 bis 35 % des jährlichen Wärmepumpen-Strombedarfs decken (ca. 800 bis 1.500 kWh). Das spart jährlich rund 220 bis 420 Euro Netzstromkosten ein."
  },
  {
    question: "Wie finde ich den günstigsten Heizstromtarif?",
    answer: "Vergleiche spezielle Wärmepumpentarife in Tarifportalen unter Angabe deiner Postleitzahl und getrennter Eingabe von Haushalts- und Heizstrom. Achte auf 12 Monate Preisgarantie und keine Vorkasse."
  },
  {
    question: "Kann ich dynamische Stromtarife für die Wärmepumpe nutzen?",
    answer: "Ja. Wenn die Wärmepumpe über ein SG-Ready-Interface (Smart Grid Ready) oder EEBUS verfügt, kann sie automatisch bei sehr günstigen Börsenstrompreisen (z. B. nachts oder mittags) den Pufferspeicher überheizen."
  }
];

const faqSchema = getFaqSchema(faqs);

const related = [
  { title: 'Wärmepumpe Stromrechner', href: '/waermepumpe/stromverbrauch-rechner', description: 'Rechner für Strom & Kosten.' },
  { title: 'Wärmepumpe Stromverbrauch', href: '/waermepumpe/stromverbrauch', description: 'Vergleichswerte nach Baujahr.' },
  { title: 'Dynamische Stromtarife', href: '/dynamische-stromtarife', description: 'Heizstrom flexibel einkaufen.' },
  { title: 'PV Eigenverbrauch Rechner', href: '/photovoltaik/eigenverbrauch-rechner', description: 'Wärmepumpe mit Solar betreiben.' },
];
---

<BaseLayout
  title="Wärmepumpe Stromkosten: Heizstromtarife, § 14a EnWG & Spartipps | kWhKlar"
  description="Was kostet der Strom für eine Wärmepumpe im Monat & Jahr? Alles zu speziellen Heizstromtarifen, § 14a EnWG Netzentgelt-Rabatten, Zählerkaskade und Rechner."
  canonical="https://kwhklar.de/waermepumpe/stromkosten"
  jsonLd={faqSchema ? [faqSchema] : undefined}
  breadcrumbs={[
    { name: 'Wärmepumpe', path: '/waermepumpe/stromverbrauch' },
    { name: 'Stromkosten', path: '/waermepumpe/stromkosten' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Wärmepumpe', path: '/waermepumpe/stromverbrauch' },
        { name: 'Stromkosten & Heizstrom', path: '/waermepumpe/stromkosten' },
      ]}
    />

    <div class="max-w-4xl mb-8">
      <span class="badge-emerald text-xs mb-2">Heizstrom &amp; Tarife</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Wärmepumpe Stromkosten &amp; Heizstromtarife
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Erfahre, welche jährlichen Stromkosten beim Heizen mit einer Wärmepumpe anfallen, wann sich ein eigener Heizstromzähler lohnt und welche gesetzlichen Netzentgelt-Rabatte nach § 14a EnWG dir zustehen.
      </p>
    </div>

    <!-- Main Editorial Content Depth -->
    <div class="my-12 grid grid-cols-1 lg:grid-cols-12 gap-8">
      <article class="lg:col-span-8 space-y-10">
        
        <!-- Section: Key Levers Breakdown -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Die 3 wichtigsten Hebel zur Senkung der Wärmepumpen-Stromkosten
          </h2>
          <div class="space-y-4 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="text-base text-slate-900 dark:text-white block font-bold mb-1">1. Vorlauftemperatur &amp; Heizkurve optimieren</strong>
              <p>Jedes Grad weniger Vorlauftemperatur verbessert den Wirkungsgrad der Wärmepumpe um ca. 2,5 % und spart bares Geld. Ein hydraulischer Abgleich ist die rentabelste Sofortmaßnahme.</p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="text-base text-slate-900 dark:text-white block font-bold mb-1">2. § 14a EnWG Netzentgelt-Reduzierung beanspruchen</strong>
              <p>Seit 2024 erhalten steuerbare Verbrauchseinrichtungen (wie neue Wärmepumpen) einen garantierten pauschalen Rabatt (Modul 1: ca. 110 bis 190 Euro pro Jahr) oder 60 % Rabatt auf den Arbeitspreis der Netzentgelte (Modul 2).</p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="text-base text-slate-900 dark:text-white block font-bold mb-1">3. Photovoltaik-Eigenstrom für Übergangszeiten &amp; Warmwasser</strong>
              <p>In den Monaten März bis Mai und September bis Oktober sowie im Sommer kann eine Photovoltaikanlage einen großen Teil des Wärmepumpen-Strombedarfs decken und die Bezugskosten minimieren.</p>
            </div>
          </div>
        </section>

        <!-- FAQ Section -->
        <FaqSection items={faqs} />
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-900 p-6 text-white shadow-md">
          <h3 class="font-bold text-emerald-400 text-sm uppercase tracking-wider mb-3">
            § 14a EnWG Rabatt-Garantie
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-3">
            Seit <strong>Januar 2024</strong> erhalten alle neuen Wärmepumpenbetreiber jährlich zwischen <strong>110 und 190 Euro</strong> Gutschrift auf ihre Netzentgelte.
          </p>
        </div>

        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
          <h3 class="font-bold text-slate-900 dark:text-white text-sm mb-4">Verwandte Ratgeber</h3>
          <ul class="space-y-2 text-xs">
            <li><a href="/waermepumpe/stromverbrauch-rechner" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Wärmepumpen-Stromrechner</a></li>
            <li><a href="/waermepumpe/stromverbrauch" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Richtwerte nach Baujahr</a></li>
            <li><a href="/dynamische-stromtarife" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Dynamische Börsenstromtarife</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'bdew']} />
  </div>
</BaseLayout>
