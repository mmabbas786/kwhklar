---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../components/seo/RelatedLinks.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';
import { calculateHeatPump } from '../../lib/calculators';
import { formatEuro, formatKwh } from '../../lib/formatters';
import { getCalculatorSchema, getFaqSchema } from '../../lib/structured-data';

const defaultRes = calculateHeatPump({
  annualHeatingDemandKwh: 15000,
  jaz: 3.8,
  electricityPriceCtPerKwh: 30.0,
});

const faqs = [
  {
    question: "Wie berechnet man den Stromverbrauch einer Wärmepumpe exakt?",
    answer: "Formel: Stromverbrauch (kWh) = Jährlicher Wärmebedarf (kWh) ÷ Jahresarbeitszahl (JAZ). Bei 15.000 kWh Heizwärmebedarf und einer JAZ von 3,8 benötigt die Wärmepumpe ca. 3.947 kWh Strom pro Jahr."
  },
  {
    question: "Was ist die Jahresarbeitszahl (JAZ) und welcher Wert ist gut?",
    answer: "Die JAZ beziffert das Verhältnis von abgegebener Wärmemenge zum eingesetzten Strom über das gesamte Betriebsjahr. Eine JAZ ab 3,5 gilt für Luft-Wasser-Wärmepumpen als solide, ab 4,0 als sehr gut. Erdwärmepumpen erreichen oft Werte von 4,5 bis 5,0."
  },
  {
    question: "Wie ermittle ich meinen bisherigen Heizwärmebedarf für den Rechner?",
    answer: "Richtwert aus bisherigem Verbrauch: Gasverbrauch in kWh × 0,9 = Nutzwärmebedarf. Heizöl in Litern × 10 × 0,85 = Nutzwärmebedarf. Holzpellets in kg × 4,8 × 0,85 = Nutzwärmebedarf."
  },
  {
    question: "Wie viel Strom verbraucht das Warmwasser bei einer Wärmepumpe?",
    answer: "Für Warmwasser rechnet man ca. 300 bis 450 kWh Strom pro Person und Jahr. Bei 4 Personen im Haushalt fallen ca. 1.200 bis 1.600 kWh Strom pro Jahr allein für warmes Dusch- und Brauchwasser an."
  },
  {
    question: "Wie wirken sich Frosttage auf den Stromverbrauch aus?",
    answer: "Bei Außentemperaturen unter dem Gefrierpunkt sinkt der COP der Luftwärmepumpe vorübergehend auf 2,0 bis 2,5 ab. Der Rechner nutzt die Jahresarbeitszahl (JAZ), welche diese Frostphasen bereits im Jahresmittelwert berücksichtigt."
  },
  {
    question: "Was kostet die Kilowattstunde Wärme bei einer Wärmepumpe?",
    answer: "Formel: Wärmepreis = Strompreis (ct/kWh) ÷ JAZ. Bei 30 ct/kWh Strompreis und JAZ 3,8 kostet 1 kWh Wärme ca. 7,9 Cent – deutlich günstiger als Gas (ca. 11–13 ct/kWh)."
  },
  {
    question: "Wie stark senkt ein hydraulischer Abgleich den Stromverbrauch?",
    answer: "Ein hydraulischer Abgleich stellt sicher, dass alle Heizkörper gleichmäßig durchströmt werden. Dadurch kann die Vorlauftemperatur um 3 bis 6 °C gesenkt werden, was den Stromverbrauch der Wärmepumpe um ca. 8 bis 15 % reduziert."
  },
  {
    question: "Sollte ich die Wärmepumpe nachts absenken?",
    answer: "Bei Wärmepumpen in Verbindung mit Fußbodenheizungen oder gut gedämmten Gebäuden ist eine starke Nachtabsenkung kontraproduktiv, da die Wärmepumpe morgens mit hoher Vorlauftemperatur und schlechterem Wirkungsgrad nachheizen müsste. Eine Absenkung um max. 1 bis 2 °C ist optimal."
  },
  {
    question: "Wie viel PV-Strom kann der Rechner für die Wärmepumpe berücksichtigen?",
    answer: "Typischerweise können 20 bis 35 % des jährlichen Strombedarfs durch eine eigene Photovoltaikanlage gedeckt werden, wodurch der durchschnittliche Mischstrompreis auf ca. 22 bis 25 ct/kWh sinkt."
  },
  {
    question: "Was bedeutet die Modulationsfähigkeit einer modernen Inverter-Wärmepumpe?",
    answer: "Inverter-Wärmepumpen passen ihre Leistung stufenlos an den aktuellen Wärmebedarf des Hauses an. Sie laufen länger bei niedriger Teillast, was die Takthäufigkeit senkt und den Stromverbrauch im Vergleich zu alten Ein/Aus-Geräten um ca. 10–20 % reduziert."
  }
];

const calcSchema = getCalculatorSchema(
  'Wärmepumpe Stromverbrauch & Heizkosten Rechner',
  'Berechne den jährlichen Stromverbrauch und die Heizstromkosten einer Wärmepumpe aus Heizwärmebedarf und Jahresarbeitszahl (JAZ).',
  '/waermepumpe/stromverbrauch-rechner'
);
const faqSchema = getFaqSchema(faqs);
const pageSchemas = faqSchema ? [calcSchema, faqSchema] : [calcSchema];

const related = [
  { title: 'Wärmepumpe Stromverbrauch', href: '/waermepumpe/stromverbrauch', description: 'Richtwerte nach Gebäudestandard.' },
  { title: 'Wärmepumpe Stromkosten', href: '/waermepumpe/stromkosten', description: 'Heizstromtarife & Kosten.' },
  { title: 'E-Auto Ladekosten Rechner', href: '/e-auto/ladekosten-rechner', description: 'Ladekosten berechnen.' },
  { title: 'PV Eigenverbrauch Rechner', href: '/photovoltaik/eigenverbrauch-rechner', description: 'Solarstrom-Eigenverbrauch.' },
];
---

<BaseLayout
  title="Wärmepumpe Stromverbrauch Rechner: JAZ & Kosten berechnen | kWhKlar"
  description="Berechne den jährlichen Stromverbrauch (kWh) und die Heizkosten deiner Wärmepumpe aus Heizwärmebedarf (kWh), JAZ und Heizstrompreis mit Online-Rechner."
  canonical="https://kwhklar.de/waermepumpe/stromverbrauch-rechner"
  jsonLd={pageSchemas}
  breadcrumbs={[
    { name: 'Wärmepumpe', path: '/waermepumpe/stromverbrauch' },
    { name: 'Stromverbrauch Rechner', path: '/waermepumpe/stromverbrauch-rechner' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Wärmepumpe', path: '/waermepumpe/stromverbrauch' },
        { name: 'Stromverbrauch Rechner', path: '/waermepumpe/stromverbrauch-rechner' },
      ]}
    />

    <div class="max-w-4xl mb-8">
      <span class="badge-emerald text-xs mb-2">Wärmepumpen-Rechner</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Wärmepumpe Stromverbrauch &amp; Heizkosten berechnen
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Ermittle den realen Strombedarf deiner Luft-Wasser- oder Sole-Wasser-Wärmepumpe auf Basis des Gebäude-Wärmebedarfs, der Jahresarbeitszahl (JAZ) und deines Heizstrompreises.
      </p>
    </div>

    <!-- Interactive Heat Pump Calculator -->
    <div class="my-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-md max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">Eckdaten deiner Wärmepumpe</h2>

          <div>
            <label for="hp-demand" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
              Jahres-Heizwärmebedarf (kWh thermisch)
            </label>
            <input
              type="number"
              id="hp-demand"
              value="15000"
              min="1000"
              step="500"
              class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-base font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
            />
            <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 block">Tipp: Gasverbrauch in kWh × 0,9 bzw. Heizöl in Litern × 8,5.</span>
          </div>

          <div>
            <label for="hp-jaz" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
              Jahresarbeitszahl (JAZ)
            </label>
            <input
              type="number"
              id="hp-jaz"
              value="3.8"
              min="1.5"
              max="6.0"
              step="0.1"
              class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-base font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
            />
            <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 block">Luft-Wasser: 3,2–4,0 | Sole-Wasser (Erdwärme): 4,2–5,0</span>
          </div>

          <div>
            <label for="hp-price" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
              Strompreis / Heizstrom (ct/kWh)
            </label>
            <input
              type="number"
              id="hp-price"
              value="30.0"
              min="10"
              step="0.5"
              class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-base font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
            />
          </div>
        </div>

        <!-- Heat Pump Results Display -->
        <div class="rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-800 p-6 text-white space-y-4 shadow-md">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-100 block">Berechneter Jahresbedarf</span>
          <div>
            <span class="text-xs text-emerald-200 block">Benötigter Antriebsstrom</span>
            <span class="text-3xl font-black text-white" id="hp-res-kwh">{formatKwh(defaultRes.annualElectricityKwh)}</span>
          </div>
          <div class="border-t border-emerald-500/40 pt-3">
            <span class="text-xs text-emerald-200 block">Jährliche Stromkosten</span>
            <span class="text-2xl font-extrabold text-emerald-100" id="hp-res-year">{formatEuro(defaultRes.annualCostEuro)}</span>
          </div>
          <div class="border-t border-emerald-500/40 pt-3">
            <span class="text-xs text-emerald-200 block">Monatlicher Heizstromabschlag</span>
            <span class="text-xl font-bold text-white" id="hp-res-month">{formatEuro(defaultRes.monthlyCostEuro)}</span>
          </div>
          <div class="border-t border-emerald-500/40 pt-3 text-[11px] text-emerald-100">
            Effektiver Wärmepreis: <strong class="text-white" id="hp-res-heatprice">7,89 ct/kWh Wärme</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Editorial Content Depth -->
    <div class="my-12 grid grid-cols-1 lg:grid-cols-12 gap-8">
      <article class="lg:col-span-8 space-y-10">
        
        <!-- FAQ Section -->
        <FaqSection items={faqs} />
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-900 p-6 text-white shadow-md">
          <h3 class="font-bold text-emerald-400 text-sm uppercase tracking-wider mb-3">
            Wärmepumpen-Formel
          </h3>
          <p class="font-mono text-xs text-slate-300 leading-relaxed">
            Strom (kWh) = Wärmebedarf (kWh) ÷ JAZ<br/><br/>
            Kosten = Strom (kWh) × Arbeitspreis
          </p>
        </div>

        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
          <h3 class="font-bold text-slate-900 dark:text-white text-sm mb-4">Verwandte Rechner</h3>
          <ul class="space-y-2 text-xs">
            <li><a href="/waermepumpe/stromkosten" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Wärmepumpe Stromkosten &amp; §14a</a></li>
            <li><a href="/waermepumpe/stromverbrauch" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Richtwerte nach Gebäudestandard</a></li>
            <li><a href="/photovoltaik/eigenverbrauch-rechner" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ PV-Eigenverbrauch berechnen</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'uba', 'stromspiegel']} />
  </div>
</BaseLayout>

<script>
  const inDemand = document.getElementById('hp-demand') as HTMLInputElement | null;
  const inJaz = document.getElementById('hp-jaz') as HTMLInputElement | null;
  const inPrice = document.getElementById('hp-price') as HTMLInputElement | null;

  const resKwh = document.getElementById('hp-res-kwh');
  const resYear = document.getElementById('hp-res-year');
  const resMonth = document.getElementById('hp-res-month');
  const resHeatPrice = document.getElementById('hp-res-heatprice');

  function calculate() {
    if (!inDemand || !inJaz || !inPrice || !resKwh || !resYear || !resMonth || !resHeatPrice) return;

    const demand = parseFloat(inDemand.value) || 0;
    const jaz = Math.max(parseFloat(inJaz.value) || 1, 0.5);
    const priceCt = parseFloat(inPrice.value) || 0;

    const kwhElectricity = demand / jaz;
    const costYear = (kwhElectricity * priceCt) / 100;
    const costMonth = costYear / 12;
    const heatCostPerKwh = jaz > 0 ? (priceCt / jaz) : 0;

    resKwh.textContent = Math.round(kwhElectricity).toLocaleString('de-DE') + ' kWh';
    resYear.textContent = costYear.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    resMonth.textContent = costMonth.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    resHeatPrice.textContent = heatCostPerKwh.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ct/kWh Wärme';
  }

  inDemand?.addEventListener('input', calculate);
  inJaz?.addEventListener('input', calculate);
  inPrice?.addEventListener('input', calculate);
</script>
