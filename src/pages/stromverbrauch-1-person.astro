---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversalCalculator from '../components/calculator/UniversalCalculator.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { householdBenchmarks } from '../data/household-benchmarks';
import { formatKwh } from '../lib/formatters';

const data = householdBenchmarks[1];

const faqs = [
  {
    question: 'Wie hoch sind die monatlichen Stromkosten für eine Person?',
    answer: 'Ein Single zahlt bei einem Verbrauch von 1.300 bis 1.500 kWh und 35 ct/kWh Arbeitspreis ca. 45 bis 55 Euro monatlich (inklusive Grundgebühr).',
  },
  {
    question: 'Warum verbrauchen manche Singles über 2.000 kWh?',
    answer: 'Häufige Gründe sind elektrische Warmwasserbereitung (Durchlauferhitzer / Boiler im Bad), intensives Homeoffice mit mehreren Monitoren, Gaming-PCs oder alte, ineffiziente Kühlgeräte.',
  },
];

const related = [
  { title: '2-Personen-Haushalt', href: '/stromverbrauch-2-personen', description: 'Richtwerte für Paare.' },
  { title: 'Stromverbrauch Wohnung', href: '/stromverbrauch-wohnung', description: 'Vergleichswerte für Mietwohnungen.' },
  { title: 'Stromverbrauch pro Person', href: '/stromverbrauch-pro-person', description: 'Pro-Kopf-Durchschnitt in Deutschland.' },
  { title: 'Stromrechnung senken', href: '/stromrechnung-senken', description: 'Sofort-Maßnahmen für Singles.' },
];
---

<BaseLayout
  title="Stromverbrauch 1 Person: Durchschnitt & Kosten für Singles | kWhKlar"
  description="Wie viel Strom verbraucht ein 1-Personen-Haushalt? Offizielle Richtwerte (1.300–1.800 kWh), monatliche Kosten und Spartipps für Singles."
  canonical="https://kwhklar.de/stromverbrauch-1-person"
  breadcrumbs={[
    { name: 'Haushalt', path: '/stromverbrauch-haushalt' },
    { name: '1 Person', path: '/stromverbrauch-1-person' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Haushalt', path: '/stromverbrauch-haushalt' },
        { name: '1 Person (Single)', path: '/stromverbrauch-1-person' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Single-Haushalt Benchmark</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Stromverbrauch für 1 Person (Single-Haushalt)
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        {data.description}
      </p>
    </div>

    <!-- Key Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-10">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
        <span class="text-xs text-slate-500 font-medium">Mietwohnung (ohne Warmwasser)</span>
        <div class="mt-2 text-2xl font-bold text-slate-900">{formatKwh(data.apartmentWithoutWarmWaterKwh, 0)}</div>
        <span class="text-xs text-slate-400 mt-1 block">ca. 38–45 € / Monat</span>
      </div>

      <div class="rounded-2xl border border-amber-200 bg-amber-50/50 p-5 shadow-xs">
        <span class="text-xs text-amber-800 font-medium">Wohnung (mit Warmwasser elektrisch)</span>
        <div class="mt-2 text-2xl font-bold text-amber-950">{formatKwh(data.apartmentWithWarmWaterKwh, 0)}</div>
        <span class="text-xs text-amber-700 mt-1 block">ca. 55–65 € / Monat</span>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
        <span class="text-xs text-slate-500 font-medium">Einfamilienhaus</span>
        <div class="mt-2 text-2xl font-bold text-slate-900">{formatKwh(data.houseWithoutWarmWaterKwh, 0)}</div>
        <span class="text-xs text-slate-400 mt-1 block">ca. 60–70 € / Monat</span>
      </div>
    </div>

    <UniversalCalculator
      defaultWatt={150}
      defaultHours={24}
      defaultPriceCt={35.0}
      title="Single-Haushalt Verbrauchsrechner"
      subtitle="Ermittle deine Stromkosten bei individuellem Verbrauch:"
    />

    <!-- Editorial Context -->
    <article class="prose prose-slate max-w-4xl my-12 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200">
      <h2 class="text-2xl font-bold text-slate-900">Warum verbraucht ein Single pro Kopf mehr als eine Familie?</h2>
      <p class="text-slate-600 leading-relaxed">
        Im Single-Haushalt tragen Sie alle „Grundlast-Verbraucher“ allein: Kühlschrank, WLAN-Router, Beleuchtung, Waschmaschine und Fernseher laufen auch bei einer Person regelmäßig. In Mehrpersonenhaushalten verteilen sich diese Grundgeräte auf mehrere Köpfe.
      </p>

      <h3 class="text-xl font-bold text-slate-900 mt-6">Konkrete Spartipps für Singles:</h3>
      <ul class="list-disc pl-5 space-y-2 text-slate-600 text-sm">
        {data.savingTips.map((tip) => (
          <li>{tip}</li>
        ))}
      </ul>
    </article>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['stromspiegel', 'bdew', 'destatis']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
