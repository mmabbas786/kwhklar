---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';

const related = [
  { title: 'Quellen & Methodik', href: '/quellen-methodik', description: 'Transparente Formeln & Datenquellen.' },
  { title: 'Stromkostenrechner', href: '/stromkosten-rechner', description: 'Direkt rechnen.' },
  { title: 'Kontakt', href: '/kontakt', description: 'Fragen & Feedback senden.' },
];
---

<BaseLayout
  title="Über uns: Mission, Transparenz & Unabhängigkeit | kWhKlar"
  description="Über kWhKlar.de: Unsere Mission für mehr Transparenz bei Stromkosten und Energieverbrauch in Deutschland. Wissenschaftlich fundiert und unabhängig."
  canonical="https://kwhklar.de/ueber-uns"
  breadcrumbs={[{ name: 'Über uns', path: '/ueber-uns' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Über uns', path: '/ueber-uns' }]} />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Über das Projekt</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Über kWhKlar: Stromkosten einfach und verständlich machen
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        kWhKlar.de ist eine unabhängige deutsche Plattform für Stromkostenberechnungen, Haushaltsenergie-Benchmarks und fundierte Spartipps.
      </p>
    </div>

    <article class="prose prose-slate max-w-4xl my-8 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 space-y-6">
      <h2 class="text-2xl font-bold text-slate-900">Unsere Mission</h2>
      <p class="text-slate-600 leading-relaxed text-sm">
        Energiepreise und Stromrechnungen sind für viele Verbraucher in Deutschland undurchsichtig geworden. Ob Watt in Kilowattstunden, Arbeitspreis versus Grundpreis oder der reale Verbrauch neuer Elektrogeräte: Oft fehlen schnelle, verständliche Antworten ohne versteckte Vermittlungsinteressen.
      </p>
      <p class="text-slate-600 leading-relaxed text-sm">
        Unsere Mission ist es, jedem Haushalt in Deutschland ein kostenloses, sofort nutzbares und datenbasiertes Werkzeug an die Hand zu geben, um Stromkosten transparent nachzurechnen und Einsparpotenziale aufzudecken.
      </p>

      <h2 class="text-2xl font-bold text-slate-900 pt-4">Unsere Grundsätze</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 not-prose">
        <div class="rounded-2xl bg-slate-50 p-5 border border-slate-200">
          <strong class="text-slate-900 font-bold block mb-1">1. Volle Transparenz</strong>
          <p class="text-xs text-slate-600">Jede Berechnungsmethode und Formel ist offengelegt und nachvollziehbar.</p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-5 border border-slate-200">
          <strong class="text-slate-900 font-bold block mb-1">2. Offizielle Quellen</strong>
          <p class="text-xs text-slate-600">Wir stützen uns auf valide Daten von Bundesnetzagentur, Destatis, BDEW und Stromspiegel.</p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-5 border border-slate-200">
          <strong class="text-slate-900 font-bold block mb-1">3. Nutzen vor Kommerz</strong>
          <p class="text-xs text-slate-600">Rechner und Inhalte stehen an erster Stelle und sind ohne Registrierung frei zugänglich.</p>
        </div>
      </div>
    </article>

    <RelatedLinks links={related} />
  </div>
</BaseLayout>
