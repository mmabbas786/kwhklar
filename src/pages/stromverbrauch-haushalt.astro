<script>
  // Interactive Benchmark Script
  const benchmarks: Record<string, number> = {
    '1_apartment_central': 1400,
    '1_apartment_electric': 1900,
    '1_house_central': 2100,
    '1_house_electric': 2600,
    '2_apartment_central': 2100,
    '2_apartment_electric': 2900,
    '2_house_central': 3000,
    '2_house_electric': 3800,
    '3_apartment_central': 2800,
    '3_apartment_electric': 3900,
    '3_house_central': 3600,
    '3_house_electric': 4900,
    '4_apartment_central': 3800,
    '4_apartment_electric': 5200,
    '4_house_central': 4200,
    '4_house_electric': 6000,
    '5_apartment_central': 4500,
    '5_apartment_electric': 6300,
    '5_house_central': 5400,
    '5_house_electric': 7400,
  };

  function updateBenchmark() {
    const persons = (document.getElementById('hh-persons') as HTMLSelectElement)?.value || '2';
    const type = (document.getElementById('hh-type') as HTMLSelectElement)?.value || 'apartment';
    const water = (document.getElementById('hh-water') as HTMLSelectElement)?.value || 'central';

    const key = `${persons}_${type}_${water}`;
    const kwh = benchmarks[key] || 2100;
    const cost = kwh * 0.35;
    const month = cost / 12;

    const resKwh = document.getElementById('hh-res-kwh');
    const resCost = document.getElementById('hh-res-cost');
    const resMonth = document.getElementById('hh-res-month');
    const effA = document.getElementById('hh-eff-a');
    const effB = document.getElementById('hh-eff-b');
    const effC = document.getElementById('hh-eff-c');

    if (resKwh) resKwh.textContent = `${new Intl.NumberFormat('de-DE').format(kwh)} kWh / Jahr`;
    if (resCost) resCost.textContent = `${new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(cost)} / Jahr`;
    if (resMonth) resMonth.textContent = `ca. ${new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(month)}`;

    if (effA) effA.textContent = `< ${Math.round(kwh * 0.7)} kWh`;
    if (effB) effB.textContent = `${Math.round(kwh * 0.7)} – ${Math.round(kwh * 1.15)} kWh`;
    if (effC) effC.textContent = `${Math.round(kwh * 1.15)} – ${Math.round(kwh * 1.5)} kWh`;
  }

  document.getElementById('hh-persons')?.addEventListener('change', updateBenchmark);
  document.getElementById('hh-type')?.addEventListener('change', updateBenchmark);
  document.getElementById('hh-water')?.addEventListener('change', updateBenchmark);
</script>
