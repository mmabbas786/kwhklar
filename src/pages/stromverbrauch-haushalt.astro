</BaseLayout>

<script>
  import { householdBenchmarks } from '../data/household-benchmarks';

  const selectPersons = document.getElementById('hh-persons') as HTMLSelectElement | null;
  const selectType = document.getElementById('hh-type') as HTMLSelectElement | null;
  const selectWater = document.getElementById('hh-water') as HTMLSelectElement | null;

  const kwhVal = document.getElementById('hh-kwh-val');
  const kwhDay = document.getElementById('hh-kwh-day');
  const costVal = document.getElementById('hh-cost-val');
  const costMonth = document.getElementById('hh-cost-month');
  const summaryLabel = document.getElementById('hh-summary-label');
  const ratingLabel = document.getElementById('hh-rating');

  function update() {
    if (!selectPersons || !selectType || !selectWater || !kwhVal || !costVal || !summaryLabel) return;

    const persons = parseInt(selectPersons.value, 10) as 1 | 2 | 3 | 4 | 5;
    const isHouse = selectType.value === 'house';
    const isWaterElec = selectWater.value === 'yes';

    const data = householdBenchmarks[persons] || householdBenchmarks[4];
    let kwh = 3000;

    if (!isHouse && !isWaterElec) kwh = data.apartmentWithoutWarmWaterKwh;
    else if (!isHouse && isWaterElec) kwh = data.apartmentWithWarmWaterKwh;
    else if (isHouse && !isWaterElec) kwh = data.houseWithoutWarmWaterKwh;
    else if (isHouse && isWaterElec) kwh = data.houseWithWarmWaterKwh;

    const dailyKwh = (kwh / 365).toFixed(1);
    const annualCost = (kwh * 0.35).toFixed(2);
    const monthlyCost = (kwh * 0.35 / 12).toFixed(2);

    kwhVal.textContent = `${kwh.toLocaleString('de-DE')} kWh / Jahr`;
    if (kwhDay) kwhDay.textContent = `ca. ${dailyKwh.replace('.', ',')} kWh pro Tag`;
    costVal.textContent = `${annualCost.replace('.', ',')} € / Jahr`;
    if (costMonth) costMonth.textContent = `ca. ${monthlyCost.replace('.', ',')} € / Monat (zzgl. Grundpreis)`;

    const pText = persons === 1 ? '1 Person' : `${persons} Personen`;
    const tText = isHouse ? 'Einfamilienhaus' : 'Wohnung';
    const wText = isWaterElec ? 'Elektrisches Warmwasser' : 'Zentrales Warmwasser';
    summaryLabel.textContent = `${pText} • ${tText} • ${wText}`;

    if (ratingLabel) {
      if (kwh < 2000) ratingLabel.textContent = 'Sehr sparsamer Verbrauch';
      else if (kwh <= 4000) ratingLabel.textContent = 'Normaler Durchschnittsverbrauch';
      else ratingLabel.textContent = 'Erhöhter Strombedarf (Prüfung empfohlen)';
    }
  }

  selectPersons?.addEventListener('change', update);
  selectType?.addEventListener('change', update);
  selectWater?.addEventListener('change', update);
</script>
