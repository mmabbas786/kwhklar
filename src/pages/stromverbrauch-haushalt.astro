---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { householdBenchmarks } from '../data/household-benchmarks';
import { formatKwh } from '../lib/formatters';
import { getCalculatorSchema } from '../lib/structured-data';

const schema = getCalculatorSchema(
  'Stromverbrauch Haushalt Rechner',
  'Berechne und vergleiche den Stromverbrauch deines Haushalts nach Personenzahl und Wohnform.',
  '/stromverbrauch-haushalt'
);

const faqs = [
  {
    question: 'Welchen Einfluss hat die elektrische Warmwasserbereitung?',
    answer: 'Wird das Dusch- und Spülwasser über elektrische Durchlauferhitzer oder Boiler erwärmt, erhöht sich der jährliche Stromverbrauch pro Person um ca. 500 bis 800 kWh (ca. 175 bis 280 € Mehrkosten pro Person und Jahr).',
  },
  {
    question: 'Warum verbraucht ein Einfamilienhaus mehr Strom als eine Wohnung?',
    answer: 'Im Einfamilienhaus kommen zusätzliche Stromverbraucher wie Heizungspumpen, Außenbeleuchtung, Gartenbewässerung, Garagentorantriebe und oft größere Wohnflächen hinzu.',
  },
];

const related = [
  { title: '1-Personen-Haushalt', href: '/stromverbrauch-1-person', description: 'Richtwerte für Singles.' },
  { title: '2-Personen-Haushalt', href: '/stromverbrauch-2-personen', description: 'Richtwerte für Paare.' },
  { title: '4-Personen-Haushalt', href: '/stromverbrauch-4-personen', description: 'Richtwerte für Familien.' },
  { title: 'Durchschnittlicher Stromverbrauch', href: '/durchschnittlicher-stromverbrauch', description: 'Bundesweiter Gesamtvergleich.' },
];
---

<BaseLayout
  title="Stromverbrauch im Haushalt berechnen & vergleichen | kWhKlar"
  description="Wie viel Strom verbraucht ein typischer deutscher Haushalt? Berechne deinen Haushaltsstromverbrauch nach Personenzahl, Wohnfläche und Warmwasser."
  canonical="https://kwhklar.de/stromverbrauch-haushalt"
  jsonLd={schema}
  breadcrumbs={[{ name: 'Stromverbrauch Haushalt', path: '/stromverbrauch-haushalt' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Stromverbrauch Haushalt', path: '/stromverbrauch-haushalt' }]} />

    <div class="max-w-3xl mb-6">
      <span class="badge-emerald text-xs mb-2">Haushaltsrechner</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Stromverbrauch im Haushalt: Rechner & Vergleichswerte
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Vergleiche deinen jährlichen Stromverbrauch direkt mit den offiziellen Richtwerten des Stromspiegels für Deutschland.
      </p>
    </div>

    <!-- Interactive Household Benchmark Selector -->
    <div class="my-8 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-md max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-slate-900 mb-6">Haushaltsdaten auswählen:</h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div>
          <label for="hh-persons" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Personen im Haushalt</label>
          <select id="hh-persons" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-bold text-slate-900">
            <option value="1">1 Person (Single)</option>
            <option value="2">2 Personen (Paar)</option>
            <option value="3">3 Personen</option>
            <option value="4" selected>4 Personen (Familie)</option>
            <option value="5">5+ Personen</option>
          </select>
        </div>

        <div>
          <label for="hh-type" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Gebäudetyp</label>
          <select id="hh-type" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-bold text-slate-900">
            <option value="apartment" selected>Wohnung (Mehrfamilienhaus)</option>
            <option value="house">Einfamilienhaus</option>
          </select>
        </div>

        <div>
          <label for="hh-water" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Warmwasserbereitung</label>
          <select id="hh-water" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-bold text-slate-900">
            <option value="no" selected>Zentral (Gas / Fernwärme)</option>
            <option value="yes">Elektrisch (Durchlauferhitzer / Boiler)</option>
          </select>
        </div>
      </div>

      <!-- Result Comparison Card -->
      <div class="rounded-2xl bg-gradient-to-br from-slate-900 to-slate-800 p-6 text-white">
        <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-slate-700">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Typischer Richtwert (Stromspiegel)</span>
          <span class="text-xs text-slate-300" id="hh-summary-label">4 Personen • Wohnung • Zentrales Warmwasser</span>
        </div>

        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <span class="text-xs text-slate-400 block">Empfohlener Richtwert</span>
            <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mt-1" id="hh-kwh-val">
              3.000 kWh / Jahr
            </div>
            <span class="text-xs text-slate-400 mt-1 block">Entspricht ca. 250 kWh pro Monat</span>
          </div>

          <div>
            <span class="text-xs text-emerald-300 block">Geschätzte Jahresstromkosten (bei 35 ct/kWh)</span>
            <div class="text-3xl sm:text-4xl font-extrabold text-emerald-400 tracking-tight mt-1" id="hh-cost-val">
              1.200,00 € / Jahr
            </div>
            <span class="text-xs text-emerald-200/80 mt-1 block" id="hh-monthly-val">ca. 100,00 € / Monat (zzgl. Grundgebühr)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Detail Table -->
    <div class="my-10 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Vergleichstabelle für alle Haushaltsgrößen</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="p-3">Haushalt</th>
              <th class="p-3">Wohnung (ohne Warmwasser)</th>
              <th class="p-3">Wohnung (mit Warmwasser)</th>
              <th class="p-3">Einfamilienhaus (ohne Warmwasser)</th>
              <th class="p-3 text-right">Einfamilienhaus (mit Warmwasser)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-600">
            {Object.values(householdBenchmarks).map((b) => (
              <tr>
                <td class="p-3 font-semibold text-slate-900">{b.label}</td>
                <td class="p-3 font-medium text-emerald-700">{formatKwh(b.apartmentWithoutWarmWaterKwh, 0)}</td>
                <td class="p-3 text-amber-700">{formatKwh(b.apartmentWithWarmWaterKwh, 0)}</td>
                <td class="p-3">{formatKwh(b.houseWithoutWarmWaterKwh, 0)}</td>
                <td class="p-3 text-right font-semibold text-slate-900">{formatKwh(b.houseWithWarmWaterKwh, 0)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['stromspiegel', 'bdew', 'destatis']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>

<script>
  function initHouseholdCalculator() {
    const personsSelect = document.getElementById('hh-persons') as HTMLSelectElement | null;
    const typeSelect = document.getElementById('hh-type') as HTMLSelectElement | null;
    const waterSelect = document.getElementById('hh-water') as HTMLSelectElement | null;

    const summaryLabel = document.getElementById('hh-summary-label');
    const kwhVal = document.getElementById('hh-kwh-val');
    const costVal = document.getElementById('hh-cost-val');
    const monthlyVal = document.getElementById('hh-monthly-val');

    if (!personsSelect || !typeSelect || !waterSelect) return;

    const data: Record<string, { aptNo: number; aptYes: number; houseNo: number; houseYes: number }> = {
      '1': { aptNo: 1300, aptYes: 1800, houseNo: 2000, houseYes: 2600 },
      '2': { aptNo: 2100, aptYes: 2900, houseNo: 3000, houseYes: 3800 },
      '3': { aptNo: 2600, aptYes: 3700, houseNo: 3600, houseYes: 4700 },
      '4': { aptNo: 3000, aptYes: 4300, houseNo: 4000, houseYes: 5300 },
      '5': { aptNo: 3600, aptYes: 5200, houseNo: 4800, houseYes: 6300 },
    };

    function update() {
      const p = personsSelect?.value || '4';
      const isHouse = typeSelect?.value === 'house';
      const isWaterElectric = waterSelect?.value === 'yes';

      const bm = data[p] || data['4'];
      let kwh = isHouse ? (isWaterElectric ? bm.houseYes : bm.houseNo) : (isWaterElectric ? bm.aptYes : bm.aptNo);
      let cost = kwh * 0.35;
      let monthly = cost / 12;

      if (summaryLabel) {
        summaryLabel.textContent = `${p} Person${p !== '1' ? 'en' : ''} • ${isHouse ? 'Einfamilienhaus' : 'Wohnung'} • ${isWaterElectric ? 'Elektrisches Warmwasser' : 'Zentrales Warmwasser'}`;
      }
      if (kwhVal) kwhVal.textContent = `${kwh.toLocaleString('de-DE')} kWh / Jahr`;
      if (costVal) costVal.textContent = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(cost) + ' / Jahr';
      if (monthlyVal) monthlyVal.textContent = `ca. ${new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(monthly)} / Monat (zzgl. Grundgebühr)`;
    }

    personsSelect.addEventListener('change', update);
    typeSelect.addEventListener('change', update);
    waterSelect.addEventListener('change', update);

    update();
  }

  document.addEventListener('DOMContentLoaded', initHouseholdCalculator);
  initHouseholdCalculator();
</script>
