---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';

const faqs = [
  {
    question: 'Welche Angaben müssen auf einer Stromrechnung stehen?',
    answer: 'Laut § 40 EnWG muss jede Stromrechnung u.a. enthalten: Zählernummer, Zählerstände zu Beginn und Ende der Periode, den abgerechneten Verbrauch in kWh, Arbeitspreis und Grundpreis, die geleisteten monatlichen Abschläge, den Vergleich zum Vorjahresverbrauch sowie den Strommix des Anbieters.',
  },
  {
    question: 'Was ist der Unterschied zwischen Nachzahlung und Guthaben?',
    answer: 'Waren deine im Jahresverlauf gezahlten 11 oder 12 Monatsabschläge höher als deine tatsächlichen Gesamtkosten, erhältst du ein Guthaben zurückerstattet. Lag der tatsächliche Verbrauch oder der Preis höher als die Summe der Abschläge, musst du den Differenzbetrag nachzahlen.',
  },
];

const related = [
  { title: 'Stromrechnung prüfen', href: '/stromrechnung-pruefen', description: 'Schritt-für-Schritt Prüfanleitung.' },
  { title: 'Stromrechnung berechnen', href: '/stromrechnung-berechnen', description: 'Rechne deine Abrechnung nach.' },
  { title: 'Stromrechnung zu hoch?', href: '/stromrechnung-zu-hoch', description: 'Typische Ursachen & Maßnahmen.' },
  { title: 'Musterrechnung mit Beispiel', href: '/stromrechnung-beispiel', description: 'Erklärte Stromrechnung.' },
  { title: 'Stromrechnung senken', href: '/stromrechnung-senken', description: 'Abschlag und Kosten reduzieren.' },
];
---

<BaseLayout
  title="Stromrechnung verstehen, prüfen & berechnen | kWhKlar"
  description="Stromrechnung einfach erklärt: Zählerstände, Arbeitspreis, Grundpreis, Nachzahlung und Schritt-für-Schritt Prüfanleitung für Verbraucher."
  canonical="https://kwhklar.de/stromrechnung"
  breadcrumbs={[{ name: 'Stromrechnung', path: '/stromrechnung' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Stromrechnung', path: '/stromrechnung' }]} />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Rechnungs-Hub</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Stromrechnung verstehen, prüfen & berechnen
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Erhalte den vollen Durchblick bei deiner Jahresstromabrechnung: Wie Zählerstände, Arbeitspreis und monatliche Abschläge zusammenhängen und wie du Rechnungsfehler aufdeckst.
      </p>
    </div>

    <!-- Cluster Subpages Navigation Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 my-10">
      {related.map((item) => (
        <a
          href={item.href}
          class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs hover:border-emerald-400 hover:shadow-md transition flex flex-col justify-between"
        >
          <div>
            <h2 class="text-lg font-bold text-slate-900 tracking-tight">{item.title}</h2>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">{item.description}</p>
          </div>
          <span class="mt-4 text-xs font-semibold text-emerald-600">Zur Seite →</span>
        </a>
      ))}
    </div>

    <SourceBox sourceIds={['bnetza', 'bdew']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
