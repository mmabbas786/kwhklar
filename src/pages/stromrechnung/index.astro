---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../components/seo/RelatedLinks.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';
import { getFaqSchema } from '../../lib/structured-data';

const faqs = [
  {
    question: "Welche Pflichtangaben müssen laut Gesetz auf einer Stromrechnung stehen?",
    answer: "Nach § 40 des Energiewirtschaftsgesetzes (EnWG) muss jede deutsche Stromabrechnung folgende Angaben transparent enthalten: Name und Kontaktdaten des Lieferanten, Vertrags- und Kundennummer, Zählernummer, genauer Abrechnungszeitraum, Anfangs- und Endzählerstand mit Angabe ob abgelesen oder geschätzt, ermittelter Verbrauch in kWh, Arbeitspreis (ct/kWh), Grundpreis (€/Monat), alle im Zeitraum geleisteten Abschlagszahlungen, Rechnungsendsumme mit Ausweisung von 19 % MwSt., ein grafischer Vergleich zum Vorjahresverbrauch sowie der bundesweite Strommix."
  },
  {
    question: "Wie lese ich meine Stromrechnung richtig?",
    answer: "Beginne immer auf der Übersichtsseite: Prüfe zuerst den Abrechnungszeitraum (meist 12 Monate) und den Gesamtrechnungsbetrag. Vergleiche dann die Summe deiner geleisteten monatlichen Abschläge mit den tatsächlichen Gesamtkosten. Auf den Folgeseiten findest du die Detailaufschlüsselung der Zählerstände (Anfang und Ende) sowie die getrennte Berechnung von verbrauchsabhängigem Arbeitspreis und festem Grundpreis."
  },
  {
    question: "Was ist der genaue Unterschied zwischen Arbeitspreis und Grundpreis auf der Rechnung?",
    answer: "Der Arbeitspreis (auch Verbrauchspreis) beziffert die Kosten pro verbrauchter Kilowattstunde (z. B. 35,0 ct/kWh). Er wird mit deinem Zählerstand-Verbrauch multipliziert. Der Grundpreis ist eine feste Grundgebühr (z. B. 12,50 €/Monat = 150 €/Jahr), die unabhängig von deinem Stromverbrauch für Zählerbetrieb, Eichung, Abrechnung und Netzzugang anfällt."
  },
  {
    question: "Was ist eine Nachzahlung auf der Stromrechnung und wann ist sie fällig?",
    answer: "Eine Nachzahlung entsteht, wenn dein tatsächlicher Stromverbrauch oder gestiegene Tarifpreise höhere Gesamtkosten verursacht haben, als du durch deine monatlichen Vorauszahlungen (Abschläge) im Laufe des Jahres bezahlt hast. Die Nachzahlung ist in der Regel innerhalb von zwei Wochen nach Zugang der Rechnung fällig."
  },
  {
    question: "Was passiert mit einem Guthaben auf der Jahresrechnung?",
    answer: "Ein Guthaben entsteht, wenn du durch deine Abschläge mehr Geld eingezahlt hast, als du Strom verbraucht hast. Nach § 40c Abs. 3 EnWG ist der Energieversorger gesetzlich verpflichtet, das Guthaben unverzüglich mit dem nächsten Monatsabschlag zu verrechnen oder auf dein Bankkonto zu überweisen."
  },
  {
    question: "Wie wird der tatsächliche Stromverbrauch in kWh auf der Rechnung berechnet?",
    answer: "Formel: Endzählerstand (kWh) minus Anfangszählerstand (kWh) = Stromverbrauch im Abrechnungszeitraum. Bei Einbau eines neuen Zählers während des Jahres werden die Differenzen beider Zähler separat berechnet und addiert."
  },
  {
    question: "Wie prüfe ich, ob meine Zählerstände auf der Rechnung geschätzt oder abgelesen wurden?",
    answer: "Auf der Detailseite der Abrechnung muss neben jedem Zählerstand die Ableseart vermerkt sein (z. B. 'Kundenablesung', 'Ablesung durch Netzbetreiber' oder 'rechnerische Schätzung'). Steht dort 'Schätzung', solltest du umgehend deinen tatsächlichen Zählerstand ablesen und eine korrigierte Rechnung verlangen."
  },
  {
    question: "Warum ist meine Stromrechnung plötzlich so hoch?",
    answer: "Häufige Ursachen sind: 1. Eine unbemerkte Strompreiserhöhung des Anbieters. 2. Zu hoch geschätzte Zählerstände mangels Selbstablesung. 3. Ein neues Großgerät im Haushalt (Heizlüfter, Klimaanlage, Gaming-PC, Homeoffice). 4. Defekte Dichtungen an Kühl- und Gefriergeräten (Kompressor-Dauerlauf). 5. Mehr Personen im Haushalt oder längere Anwesenheitszeiten."
  },
  {
    question: "Was kann ich tun, wenn die Stromrechnung fehlerhaft aussieht?",
    answer: "Lege innerhalb von 4 Wochen schriftlich Widerspruch beim Stromanbieter ein. Benenne konkret die Fehler (z. B. falscher Zählerstand, falscher Arbeitspreis, nicht gutgeschriebene Abschläge). Zahle den unstrittigen Betrag fristgerecht. Reagiert der Versorger nicht binnen 4 Wochen, kannst du dich kostenfrei an die Schlichtungsstelle Energie e.V. wenden."
  },
  {
    question: "Wie berechne ich meine Jahresstromkosten vorab selbst?",
    answer: "Formel: (Geschätzter Jahresverbrauch in kWh × Arbeitspreis in €/kWh) + (12 × monatlicher Grundpreis in €) = Jährliche Gesamtkosten brutto. Beispiel bei 3.500 kWh, 32 ct/kWh und 12 € Grundpreis: (3.500 × 0,32 €) + (12 × 12 €) = 1.120 € + 144 € = 1.264 Euro pro Jahr."
  },
  {
    question: "Wie wird der monatliche Abschlag berechnet?",
    answer: "Formel: (Erwartete Jahresgesamtkosten in Euro) ÷ Anzahl der jährlichen Abschlagsmonate (meist 11 oder 12). Bei 1.264 Euro Gesamtkosten und 11 Abschlägen beträgt der Monatsabschlag rund 115 Euro."
  },
  {
    question: "Was ist der Unterschied zwischen Verbrauch und monatlichem Abschlag?",
    answer: "Der Verbrauch ist die physikalisch in Kilowattstunden (kWh) gemessene Energie, die deine Geräte bezogen haben. Der Abschlag ist eine finanzielle Vorauszahlung in Euro, die du monatlich leistest, um die Jahresrechnung gleichmäßig über 12 Monate zu verteilen."
  },
  {
    question: "Wie kann ich meine Stromrechnung aussagekräftig mit dem Vorjahr vergleichen?",
    answer: "Vergleiche nicht nur den Euro-Endbetrag (da sich Strompreise ändern), sondern primär die verbrauchten Kilowattstunden (kWh) und die Anzahl der Abrechnungstage. Seriöse Rechnungen enthalten nach § 40 EnWG ein Balkendiagramm mit Vorjahreswerten."
  },
  {
    question: "Warum stimmen Abschlag und tatsächliche Rechnung fast nie exakt überein?",
    answer: "Weil der Stromverbrauch von unvorhersehbaren Faktoren abhängt: Wetterbedingungen (kältere Winter erfordern mehr Heizungs- und Beleuchtungsstrom), Urlaubstage, veränderte Nutzungsgewohnheiten oder Neuanschaffungen. Eine kleine Abweichung von 20 bis 80 Euro Guthaben oder Nachzahlung ist völlig normal."
  }
];

const faqSchema = getFaqSchema(faqs);

const subpages = [
  { title: 'Stromrechnung prüfen', href: '/stromrechnung-pruefen', description: 'Schritt-für-Schritt Prüfanleitung mit Checkliste gegen häufige Abrechnungsfehler.' },
  { title: 'Stromrechnung berechnen', href: '/stromrechnung-berechnen', description: 'Rechne Abschlag, Nachzahlung und Jahresgesamtkosten selbst exakt nach.' },
  { title: 'Stromrechnung zu hoch?', href: '/stromrechnung-zu-hoch', description: 'Typische Ursachen für überhöhte Stromrechnungen und wie du gegensteuerst.' },
  { title: 'Muster-Stromrechnung Beispiel', href: '/stromrechnung-beispiel', description: 'Vollständig annotierte Musterrechnung mit Erklärung aller Posten.' },
  { title: 'Stromrechnung senken', href: '/stromrechnung-senken', description: 'Praktische Hebel zur dauerhaften Reduktion deines monatlichen Abschlags.' },
  { title: 'Stromanbieter wechseln', href: '/stromanbieter-wechseln', description: 'Tarifwechsel Schritt für Schritt: Kündigungsfristen, Boni und Preisgarantien.' },
];
---

<BaseLayout
  title="Stromrechnung verstehen, prüfen und berechnen | kWhKlar"
  description="Stromrechnung einfach erklärt: Zählerstände, Arbeitspreis, Grundpreis, Nachzahlung, Fristen nach § 40 EnWG und Schritt-für-Schritt Prüfanleitung."
  canonical="https://kwhklar.de/stromrechnung"
  jsonLd={faqSchema ? [faqSchema] : undefined}
  breadcrumbs={[{ name: 'Stromrechnung', path: '/stromrechnung' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Stromrechnung', path: '/stromrechnung' }]} />

    <div class="max-w-4xl mb-8">
      <span class="badge-emerald text-xs mb-2">Verbraucher-Leitfaden</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Stromrechnung verstehen, prüfen und berechnen
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Erhalte den vollen Durchblick bei deiner Jahresstromabrechnung: Wie Zählerstände, Arbeitspreis, monatliche Abschläge und Nachzahlungen zusammenhängen, wie du Berechnungsfehler aufdeckst und welche Rechte du als Verbraucher hast.
      </p>
    </div>

    <!-- Cluster Subpages Navigation Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 my-10">
      {subpages.map((item) => (
        <a
          href={item.href}
          class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs hover:border-emerald-500 dark:hover:border-emerald-500/50 hover:shadow-md transition flex flex-col justify-between group"
        >
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white tracking-tight group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition">{item.title}</h2>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{item.description}</p>
          </div>
          <span class="mt-4 text-xs font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
            Zur Anleitung <span class="group-hover:translate-x-1 transition-transform">→</span>
          </span>
        </a>
      ))}
    </div>

    <!-- Main Editorial Depth Content -->
    <div class="my-12 grid grid-cols-1 lg:grid-cols-12 gap-8">
      <article class="lg:col-span-8 space-y-10">
        
        <!-- Section: Essential Items on Bill -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Welche Angaben stehen auf der Stromrechnung?
          </h2>
          <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
            Eine deutsche Jahresstromrechnung muss nach den gesetzlichen Vorgaben von <strong>§ 40 und § 40c EnWG</strong> übersichtlich und nachvollziehbar gestaltet sein. Folgende Kernangaben müssen zwingend aufgeführt sein:
          </p>

          <div class="space-y-4 text-xs sm:text-sm">
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="font-bold text-slate-900 dark:text-white block mb-1">1. Vertrags- und Zählerdaten</strong>
              <p class="text-slate-600 dark:text-slate-300">
                Kundennummer, Zählernummer (Marktlokations-ID / MaLo), Zählerstand zu Beginn und Ende des Abrechnungszeitraums sowie die Information, ob die Stände abgelesen oder rechnerisch geschätzt wurden.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="font-bold text-slate-900 dark:text-white block mb-1">2. Verbrauchsabrechnung in kWh</strong>
              <p class="text-slate-600 dark:text-slate-300">
                Die Differenz der Zählerstände ergibt den Jahresverbrauch in Kilowattstunden (kWh). Dieser wird mit dem vertraglichen <strong>Arbeitspreis (in ct/kWh)</strong> multipliziert.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="font-bold text-slate-900 dark:text-white block mb-1">3. Grundpreis und Gesamtsumme</strong>
              <p class="text-slate-600 dark:text-slate-300">
                Der verbrauchsunabhängige <strong>Grundpreis (in €/Monat)</strong> wird für 12 Monate addiert. Aus Verbrauchskosten und Grundpreis ergibt sich der Brutto-Gesamtrechnungsbetrag (inkl. 19 % Mehrwertsteuer).
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="font-bold text-slate-900 dark:text-white block mb-1">4. Zahlungsabgleich & Abschlagsplan</strong>
              <p class="text-slate-600 dark:text-slate-300">
                Gegenüberstellung der bezahlten Monatsabschläge mit den tatsächlichen Jahreskosten (Ergebnis: Guthaben oder Nachzahlung) plus der neue monatliche Abschlagsplan für das Folgejahr.
              </p>
            </div>
          </div>
        </section>

        <!-- Section: Step-by-step Audit Checklist -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Stromrechnung Schritt für Schritt prüfen (8-Punkte-Plan)
          </h2>
          <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6">
            Gehe bei jeder neuen Jahresabrechnung diese 8 Prüfschritte der Reihe nach durch:
          </p>

          <div class="space-y-3 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
            <div class="flex gap-3 p-3.5 rounded-2xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-800/40">
              <span class="font-bold text-emerald-800 dark:text-emerald-300">1.</span>
              <span><strong>Abrechnungszeitraum:</strong> Prüfe, ob genau 365 Tage (bzw. dein exakter Einzugs-/Wechselzeitraum) abgerechnet wurden.</span>
            </div>
            <div class="flex gap-3 p-3.5 rounded-2xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-800/40">
              <span class="font-bold text-emerald-800 dark:text-emerald-300">2.</span>
              <span><strong>Anfangszählerstand:</strong> Stimmt der Anfangsstand exakt mit dem Endzählerstand deiner vorherigen Jahresrechnung überein?</span>
            </div>
            <div class="flex gap-3 p-3.5 rounded-2xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-800/40">
              <span class="font-bold text-emerald-800 dark:text-emerald-300">3.</span>
              <span><strong>Endzählerstand:</strong> Wurde der von dir selbst abgelesene Zählerstand verwendet oder ein rechnerisch geschätzter Wert?</span>
            </div>
            <div class="flex gap-3 p-3.5 rounded-2xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-800/40">
              <span class="font-bold text-emerald-800 dark:text-emerald-300">4.</span>
              <span><strong>Verbrauch in kWh:</strong> Ergibt Endstand minus Anfangsstand exakt die ausgewiesene Kilowattstundenzahl?</span>
            </div>
            <div class="flex gap-3 p-3.5 rounded-2xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-800/40">
              <span class="font-bold text-emerald-800 dark:text-emerald-300">5.</span>
              <span><strong>Arbeitspreis:</strong> Stimmt der berechnete Arbeitspreis (ct/kWh) mit deiner Auftragsbestätigung bzw. Preisgarantie überein?</span>
            </div>
            <div class="flex gap-3 p-3.5 rounded-2xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-800/40">
              <span class="font-bold text-emerald-800 dark:text-emerald-300">6.</span>
              <span><strong>Grundpreis:</strong> Wurde die monatliche Grundgebühr für die korrekte Monatsanzahl berechnet?</span>
            </div>
            <div class="flex gap-3 p-3.5 rounded-2xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-800/40">
              <span class="font-bold text-emerald-800 dark:text-emerald-300">7.</span>
              <span><strong>Geleistete Abschläge:</strong> Sind alle von deinem Konto abgebuchten Monatsabschläge vollständig als Guthaben aufgeführt?</span>
            </div>
            <div class="flex gap-3 p-3.5 rounded-2xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-800/40">
              <span class="font-bold text-emerald-800 dark:text-emerald-300">8.</span>
              <span><strong>Nachzahlung oder Guthaben:</strong> Ergibt Gesamtkosten minus Abschlagssumme exakt den geforderten bzw. erstatteten Betrag?</span>
            </div>
          </div>
        </section>

        <!-- Section: Why is the bill suddenly so high -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Warum ist meine Stromrechnung plötzlich so hoch?
          </h2>
          <div class="space-y-4 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="text-slate-900 dark:text-white font-semibold block mb-1">1. Schätzung statt Ablesung:</strong>
              Wenn weder du noch der Ableser den Zähler abgelesen hat, schätzt der Versorger den Stand. Schätzungen sind fast immer zu Ungunsten des Kunden überhöht.
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="text-slate-900 dark:text-white font-semibold block mb-1">2. Unbemerkte Preiserhöhung:</strong>
              Nach Ablauf der Erstvertragslaufzeit oder Preisgarantie erhöhen Anbieter häufig den Arbeitspreis um 20 bis 40 %.
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="text-slate-900 dark:text-white font-semibold block mb-1">3. Versteckte Dauerstromfresser:</strong>
              Ein vereistes Gefrierfach oder defekte Kühlschrankdichtungen führen zum Dauerbetrieb des Kompressors (verursacht 200–300 kWh Mehrverbrauch).
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <strong class="text-slate-900 dark:text-white font-semibold block mb-1">4. Neue Verbraucher (Homeoffice, Heizlüfter, Klima):</strong>
              Ein 2.000-W-Heizlüfter, der an kalten Tagen 3 Stunden läuft, schlägt in einer Wintersaison mit rund 120 bis 180 Euro Mehrkosten zu Buche.
            </div>
          </div>
        </section>

        <!-- FAQ Section -->
        <FaqSection items={faqs} />
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-900 p-6 text-white shadow-md">
          <h3 class="font-bold text-emerald-400 text-sm uppercase tracking-wider mb-3">
            Rechtliche Fristen (§ 40c EnWG)
          </h3>
          <ul class="text-xs space-y-3 text-slate-300">
            <li class="border-b border-slate-800 pb-2">
              <strong class="text-white block">6-Wochen-Zustellfrist:</strong>
              Die Jahresrechnung muss spätestens 6 Wochen nach Ende des Abrechnungsjahres vorliegen.
            </li>
            <li class="border-b border-slate-800 pb-2">
              <strong class="text-white block">Guthabenauszahlung:</strong>
              Ein Rechnungsguthaben muss unverzüglich (spätestens mit dem nächsten Abschlag) verrechnet oder ausgezahlt werden.
            </li>
            <li>
              <strong class="text-white block">Schlichtungsstelle Energie:</strong>
              Kostenloses Schlichtungsverfahren bei ungelösten Streitigkeiten mit dem Stromversorger.
            </li>
          </ul>
        </div>

        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
          <h3 class="font-bold text-slate-900 dark:text-white text-sm mb-4">Wichtige Rechnungsseiten</h3>
          <ul class="space-y-2 text-xs">
            <li><a href="/stromrechnung-pruefen" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromrechnung prüfen</a></li>
            <li><a href="/stromrechnung-berechnen" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromrechnung berechnen</a></li>
            <li><a href="/stromrechnung-zu-hoch" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromrechnung zu hoch?</a></li>
            <li><a href="/stromrechnung-beispiel" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromrechnung Beispiel</a></li>
            <li><a href="/stromrechnung-senken" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromrechnung senken</a></li>
            <li><a href="/stromkosten-pro-jahr" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromkosten pro Jahr</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <RelatedLinks links={subpages.slice(0, 4)} />
    <SourceBox sourceIds={['bnetza', 'bdew', 'uba']} />
  </div>
</BaseLayout>
