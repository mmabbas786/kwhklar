---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversalCalculator from '../components/calculator/UniversalCalculator.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { getCalculatorSchema } from '../lib/structured-data';
import { getCalculatorFaqs } from '../i18n/calculator-faqs';

const schema = getCalculatorSchema(
  'Stromkostenrechner',
  'Berechne die genauen Stromkosten beliebiger Elektrogeräte aus Watt, Betriebsstunden und aktuellem Strompreis in ct/kWh.',
  '/stromkosten-rechner'
);

const faqs = getCalculatorFaqs('stromkosten-rechner', 'de');

const related = [
  { title: 'kWh in Euro Rechner', href: '/kwh-rechner', description: 'Rechne kWh direkt in Euro um.' },
  { title: 'Watt in kWh Rechner', href: '/watt-rechner', description: 'Ermittle den kWh-Verbrauch aus Watt.' },
  { title: 'Geräte Stromkosten', href: '/geraete', description: 'Übersicht für mehr als 25 Haushaltsgeräte.' },
  { title: 'Stromkosten pro Monat', href: '/stromkosten-pro-monat', description: 'Monatskosten und Abschlag prüfen.' },
];
---

<BaseLayout
  title="Stromkostenrechner: Stromkosten mit Watt & kWh berechnen | kWhKlar"
  description="Universeller Stromkostenrechner für Deutschland. Berechne die genauen Kosten pro Stunde, Tag, Monat und Jahr aus Leistung (Watt) und Betriebsdauer."
  canonical="https://kwhklar.de/stromkosten-rechner"
  jsonLd={schema}
  breadcrumbs={[{ name: 'Stromkostenrechner', path: '/stromkosten-rechner' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Stromkostenrechner', path: '/stromkosten-rechner' }]} />

    <div class="max-w-3xl mb-6">
      <span class="badge-emerald text-xs mb-2">Interaktives Tool</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Stromkostenrechner: Stromkosten schnell & präzise berechnen
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Mit unserem kostenlosen Stromkostenrechner ermittelst du in Sekundenschnelle, wie viel Strom ein Elektrogerät verbraucht und welche Kosten pro Stunde, Tag, Monat oder Jahr anfallen.
      </p>
    </div>

    <!-- The Live Calculator -->
    <UniversalCalculator
      defaultWatt={1000}
      defaultHours={1}
      defaultPriceCt={35.0}
      title="Stromkosten berechnen"
      subtitle="Passe Watt, Nutzungsdauer und deinen Strompreis flexibel an:"
    />

    <!-- Explanatory Content -->
    <article class="prose prose-slate max-w-4xl my-12 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200">
      <h2 class="text-2xl font-bold text-slate-900">Wie werden Stromkosten berechnet?</h2>
      <p class="text-slate-600 leading-relaxed">
        Die Berechnung der Stromkosten eines beliebigen Haushalts- oder Bürogeräts folgt einem einfachen dreistufigen Prinzip:
      </p>

      <div class="my-6 rounded-2xl bg-slate-50 p-5 border border-slate-200 text-sm">
        <h3 class="font-bold text-slate-900 text-base mb-2">Die mathematische Formel:</h3>
        <p class="font-mono text-emerald-800 bg-emerald-50 p-2.5 rounded-lg">
          Stromkosten (€) = (Leistung in Watt × Betriebsstunden ÷ 1.000) × (Strompreis in ct/kWh ÷ 100)
        </p>
      </div>

      <h3 class="text-xl font-bold text-slate-900 mt-6">Beispielrechnung für einen Heizlüfter (2.000 Watt):</h3>
      <ul class="list-disc pl-5 space-y-1.5 text-slate-600 text-sm">
        <li><strong>Leistung:</strong> 2.000 Watt (= 2 kW)</li>
        <li><strong>Laufzeit:</strong> 3 Stunden täglich</li>
        <li><strong>Strompreis:</strong> 35 ct/kWh (= 0,35 €)</li>
        <li><strong>Tagesverbrauch:</strong> 2.000 W × 3 h ÷ 1.000 = <strong>6,0 kWh</strong></li>
        <li><strong>Kosten pro Tag:</strong> 6,0 kWh × 0,35 € = <strong>2,10 €</strong></li>
        <li><strong>Kosten pro Monat (30 Tage):</strong> 6,0 kWh × 30 × 0,35 € = <strong>63,00 €</strong></li>
      </ul>

      <h2 class="text-2xl font-bold text-slate-900 mt-8">Tipps für eine genaue Berechnung</h2>
      <p class="text-slate-600 text-sm leading-relaxed">
        Viele Geräte wie Kühlschränke, Waschmaschinen oder Backöfen laufen nicht dauerhaft unter Volllast, sondern takten thermostatgesteuert. Für getaktete Geräte empfiehlt sich ein digitales Zwischensteck-Strommessgerät für 10 bis 15 Euro aus dem Baumarkt.
      </p>
    </article>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'bdew', 'stromspiegel']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
