---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../components/seo/RelatedLinks.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';
import { calculateBalconySolar } from '../../lib/calculators';
import { formatEuro, formatKwh } from '../../lib/formatters';
import { getCalculatorSchema } from '../../lib/structured-data';

const schema = getCalculatorSchema(
  'Balkonkraftwerk Ersparnis Rechner',
  'Berechne den jährlichen Solarertrag, die Stromkosteneinsparung und die Amortisationszeit eines 800W-Balkonkraftwerks.',
  '/balkonkraftwerk/stromkosten-sparen'
);

const defaultRes = calculateBalconySolar({
  systemPeakWatt: 800,
  annualYieldKwh: 750,
  selfConsumptionPercent: 70,
  electricityPriceCtPerKwh: 35.0,
  systemCostEuro: 450,
});

const faqs = [
  {
    question: 'Wie viel Strom erzeugt ein 800-Watt-Balkonkraftwerk im Jahr?',
    answer: 'Bei optimaler Südausrichtung und unverschatteter Montage erzeugt ein 800W-Balkonkraftwerk in Deutschland ca. 700 bis 850 kWh Solarstrom pro Jahr. Bei Ost- oder Westausrichtung sind es rund 550 bis 700 kWh.',
  },
  {
    question: 'Wie viel Geld spart ein Balkonkraftwerk pro Jahr?',
    answer: 'Wer ca. 70 % des erzeugten Stroms direkt im Haushalt für Grundlast (Kühlschrank, Router, Standby) selbst verbraucht, spart bei 750 kWh Ertrag und 35 ct/kWh Strompreis rund 184 Euro Stromkosten pro Jahr. Ein 450-Euro-Set amortisiert sich somit in etwa 2,5 Jahren.',
  },
];

const related = [
  { title: 'PV Eigenverbrauch Rechner', href: '/photovoltaik/eigenverbrauch-rechner', description: 'Große Solaranlagen berechnen.' },
  { title: 'Standby-Strom vermeiden', href: '/standby-strom', description: 'Grundlast im Haushalt analysieren.' },
  { title: 'Strom sparen Tipps', href: '/strom-sparen-tipps', description: 'Weitere Sparpotenziale.' },
];
---

<BaseLayout
  title="Balkonkraftwerk: Ertrag, Stromkosten sparen & Rechner (800W) | kWhKlar"
  description="Wie viel Strom und Geld spart ein 800-Watt-Balkonkraftwerk? Interaktiver Ersparnisrechner, Ertragsprognose und Amortisationszeit für Mieter & Eigentümer."
  canonical="https://kwhklar.de/balkonkraftwerk/stromkosten-sparen"
  jsonLd={schema}
  breadcrumbs={[
    { name: 'Solar', path: '/balkonkraftwerk/stromkosten-sparen' },
    { name: 'Balkonkraftwerk Ersparnis', path: '/balkonkraftwerk/stromkosten-sparen' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Solar & Photovoltaik', path: '/balkonkraftwerk/stromkosten-sparen' },
        { name: 'Balkonkraftwerk Ersparnis', path: '/balkonkraftwerk/stromkosten-sparen' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Steckersolar 800 W</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Balkonkraftwerk: Stromkosten sparen mit 800 Watt
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Erzeuge deinen eigenen Solarstrom auf dem Balkon oder der Terrasse. Berechne den Jahresertrag, die jährliche Ersparnis und die Amortisationszeit deines Stecker-Solargeräts.
      </p>
    </div>

    <!-- Interactive Balcony Solar Calculator -->
    <div class="my-8 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-md max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-slate-900">Eckdaten deines Balkonkraftwerks</h2>

          <div>
            <label for="pv-yield" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
              Erwarteter Jahresertrag (kWh)
            </label>
            <input
              type="number"
              id="pv-yield"
              value="750"
              min="200"
              max="1200"
              step="50"
              class="w-full rounded-xl border border-slate-200 p-3 text-base font-bold text-slate-900"
            />
            <span class="text-[11px] text-slate-500 mt-1 block">800W Süd: ca. 750–850 kWh • Ost/West: ca. 600–700 kWh</span>
          </div>

          <div>
            <label for="pv-self" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
              Eigenverbrauchsquote (%)
            </label>
            <input
              type="number"
              id="pv-self"
              value="70"
              min="20"
              max="100"
              step="5"
              class="w-full rounded-xl border border-slate-200 p-3 text-base font-bold text-slate-900"
            />
            <span class="text-[11px] text-slate-500 mt-1 block">Ohne Speicher typisch 60–80 % (mit Batteriespeicher 85–95 %)</span>
          </div>

          <div>
            <label for="pv-price" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
              Dein Strompreis (ct/kWh)
            </label>
            <input
              type="number"
              id="pv-price"
              value="35.0"
              min="10"
              step="0.5"
              class="w-full rounded-xl border border-slate-200 p-3 text-base font-bold text-slate-900"
            />
          </div>

          <div>
            <label for="pv-cost" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
              Anschaffungskosten Komplettset (€)
            </label>
            <input
              type="number"
              id="pv-cost"
              value="450"
              min="100"
              step="50"
              class="w-full rounded-xl border border-slate-200 p-3 text-base font-bold text-slate-900"
            />
          </div>
        </div>

        <div class="rounded-2xl bg-gradient-to-br from-slate-900 to-slate-800 p-6 text-white space-y-5">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Jährliche Stromersparnis</span>
            <div class="text-3xl sm:text-4xl font-extrabold text-emerald-400 tracking-tight mt-1" id="pv-res-savings">
              {formatEuro(defaultRes.annualSavingsEuro)} / Jahr
            </div>
            <span class="text-xs text-slate-300 mt-1 block" id="pv-res-kwh">
              ca. {formatKwh(defaultRes.selfConsumedKwh, 0)} selbst genutzter Ökostrom
            </span>
          </div>

          <div class="pt-4 border-t border-slate-700">
            <span class="text-xs font-bold uppercase tracking-wider text-white">Amortisationszeit</span>
            <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mt-1" id="pv-res-payback">
              ca. {defaultRes.paybackYears} Jahre
            </div>
            <span class="text-xs text-emerald-200/80 mt-1 block" id="pv-res-10y">
              10-Jahres-Ersparnis: ca. {formatEuro(defaultRes.tenYearSavingsEuro)}
            </span>
          </div>
        </div>
      </div>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'uba']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>

<script>
  function initBalconyCalc() {
    const yieldIn = document.getElementById('pv-yield') as HTMLInputElement | null;
    const selfIn = document.getElementById('pv-self') as HTMLInputElement | null;
    const priceIn = document.getElementById('pv-price') as HTMLInputElement | null;
    const costIn = document.getElementById('pv-cost') as HTMLInputElement | null;

    const resSavings = document.getElementById('pv-res-savings');
    const resKwh = document.getElementById('pv-res-kwh');
    const resPayback = document.getElementById('pv-res-payback');
    const res10y = document.getElementById('pv-res-10y');

    if (!yieldIn || !selfIn || !priceIn || !costIn || !resSavings || !resPayback) return;

    function update() {
      const y = Math.max(0, parseFloat(yieldIn?.value || '0') || 0);
      const s = Math.min(100, Math.max(0, parseFloat(selfIn?.value || '0') || 0));
      const p = Math.max(0, parseFloat(priceIn?.value || '0') || 0);
      const c = Math.max(0, parseFloat(costIn?.value || '0') || 0);

      const selfKwh = y * (s / 100);
      const annualSavings = selfKwh * (p / 100);
      const tenYear = annualSavings * 10;
      const payback = annualSavings > 0 && c > 0 ? (c / annualSavings).toFixed(1).replace('.', ',') : '–';

      const fmt = (v: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(v);

      if (resSavings) resSavings.textContent = `${fmt(annualSavings)} / Jahr`;
      if (resKwh) resKwh.textContent = `ca. ${Math.round(selfKwh).toLocaleString('de-DE')} kWh selbst genutzter Ökostrom`;
      if (resPayback) resPayback.textContent = `ca. ${payback} Jahre`;
      if (res10y) res10y.textContent = `10-Jahres-Ersparnis: ca. ${fmt(tenYear)}`;
    }

    [yieldIn, selfIn, priceIn, costIn].forEach((el) => el.addEventListener('input', update));
    update();
  }

  document.addEventListener('DOMContentLoaded', initBalconyCalc);
  initBalconyCalc();
</script>
