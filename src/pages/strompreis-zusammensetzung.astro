---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { electricityPriceData } from '../data/electricity-price';

const faqs = [
  {
    question: 'Wie hoch ist der Steuer- und Abgabenanteil am deutschen Strompreis?',
    answer: 'Steuern, staatlich veranlasste Abgaben und Umlagen (inkl. Mehrwertsteuer und Stromsteuer) machen ca. 28 % des gesamten Haushaltsstrompreises aus. Hinzu kommen ca. 27 % für die regulierten Netzentgelte.',
  },
];

const related = [
  { title: 'Aktueller Strompreis', href: '/strompreis-aktuell', description: 'Referenzpreise im Überblick.' },
  { title: 'Strompreis Entwicklung', href: '/strompreis-entwicklung', description: 'Historischer Verlauf.' },
  { title: 'Stromrechnung prüfen', href: '/stromrechnung-pruefen', description: 'Preiskomponenten auf der Rechnung.' },
];
---

<BaseLayout
  title="Strompreis Zusammensetzung: Steuern, Abgaben & Netzentgelte | kWhKlar"
  description="Woraus setzt sich der Strompreis in Deutschland zusammen? Detaillierte Aufschlüsselung von Beschaffung, Netzentgelten, Stromsteuer und Umlagen."
  canonical="https://kwhklar.de/strompreis-zusammensetzung"
  breadcrumbs={[
    { name: 'Strompreis', path: '/strompreis' },
    { name: 'Strompreis Zusammensetzung', path: '/strompreis-zusammensetzung' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Strompreis', path: '/strompreis' },
        { name: 'Strompreis Zusammensetzung', path: '/strompreis-zusammensetzung' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Preisanalyse</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Zusammensetzung des Strompreises in Deutschland
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Wohin fließt dein Geld für jede bezahlte Kilowattstunde? Eine transparente Aufschlüsselung aller Kostenbestandteile.
      </p>
    </div>

    <!-- 3 Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-10">
      {electricityPriceData.priceComposition.map((comp) => (
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="text-2xl font-black text-emerald-600 tracking-tight mb-2">
              {comp.sharePercent.toFixed(1)} %
            </div>
            <h2 class="font-bold text-slate-900 text-base mb-2">{comp.category}</h2>
            <p class="text-xs text-slate-600 leading-relaxed">{comp.description}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-semibold text-slate-700">
            ca. {comp.valueCtPerKwh.toFixed(2).replace('.', ',')} ct/kWh
          </div>
        </div>
      ))}
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bdew', 'bnetza', 'destatis']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
