---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversalCalculator from '../components/calculator/UniversalCalculator.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { householdBenchmarks } from '../data/household-benchmarks';
import { formatKwh } from '../lib/formatters';

const data = householdBenchmarks[4];

const faqs = [
  {
    question: 'Wie hoch sind die jährlichen Stromkosten einer 4-köpfigen Familie?',
    answer: 'Eine 4-köpfige Familie zahlt bei einem typischen Jahresverbrauch von 3.000 bis 4.000 kWh rund 1.200 bis 1.550 Euro pro Jahr (ca. 100 bis 130 € monatlich) bei einem Arbeitspreis von 35 ct/kWh.',
  },
  {
    question: 'Was treibt den Stromverbrauch in einer Familie am stärksten an?',
    answer: 'Hauptverbraucher sind tägliche Waschmaschinen- und Trocknerladungen, ständiges Kochen/Backen, mehrere PCs/Konsolen/Fernseher sowie Durchlauferhitzer bei elektrischer Warmwasserbereitung.',
  },
];

const related = [
  { title: 'Stromverbrauch 3 Personen', href: '/stromverbrauch-3-personen', description: 'Richtwerte für 3 Personen.' },
  { title: 'Stromverbrauch Einfamilienhaus', href: '/stromverbrauch-einfamilienhaus', description: 'Verbrauch im Eigenheim.' },
  { title: 'Die größten Stromfresser', href: '/stromfresser', description: 'Großverbraucher im Haushalt reduzieren.' },
  { title: 'Stromrechnung senken', href: '/stromrechnung-senken', description: 'Effektive Spartipps.' },
];
---

<BaseLayout
  title="Stromverbrauch 4 Personen: Durchschnitt & Kosten für Familien | kWhKlar"
  description="Wie viel Strom verbraucht eine 4-köpfige Familie? Richtwerte (3.000–4.300 kWh), Kostenvergleich und die besten Stromspartipps."
  canonical="https://kwhklar.de/stromverbrauch-4-personen"
  breadcrumbs={[
    { name: 'Haushalt', path: '/stromverbrauch-haushalt' },
    { name: '4 Personen', path: '/stromverbrauch-4-personen' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Haushalt', path: '/stromverbrauch-haushalt' },
        { name: '4 Personen (Familie)', path: '/stromverbrauch-4-personen' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Familien-Benchmark</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Stromverbrauch für 4 Personen (Familie)
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        {data.description}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-10">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
        <span class="text-xs text-slate-500 font-medium">Wohnung (ohne Warmwasser)</span>
        <div class="mt-2 text-2xl font-bold text-slate-900">{formatKwh(data.apartmentWithoutWarmWaterKwh, 0)}</div>
        <span class="text-xs text-slate-400 mt-1 block">ca. 100–110 € / Monat</span>
      </div>

      <div class="rounded-2xl border border-amber-200 bg-amber-50/50 p-5 shadow-xs">
        <span class="text-xs text-amber-800 font-medium">Wohnung (mit Warmwasser elektrisch)</span>
        <div class="mt-2 text-2xl font-bold text-amber-950">{formatKwh(data.apartmentWithWarmWaterKwh, 0)}</div>
        <span class="text-xs text-amber-700 mt-1 block">ca. 135–150 € / Monat</span>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
        <span class="text-xs text-slate-500 font-medium">Einfamilienhaus</span>
        <div class="mt-2 text-2xl font-bold text-slate-900">{formatKwh(data.houseWithoutWarmWaterKwh, 0)}</div>
        <span class="text-xs text-slate-400 mt-1 block">ca. 130–145 € / Monat</span>
      </div>
    </div>

    <UniversalCalculator
      defaultWatt={450}
      defaultHours={24}
      defaultPriceCt={35.0}
      title="Familien Verbrauchsrechner"
      subtitle="Ermittle deine Stromkosten bei individuellem Verbrauch:"
    />

    <article class="prose prose-slate max-w-4xl my-12 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200">
      <h2 class="text-2xl font-bold text-slate-900">Spartipps für die 4-köpfige Familie:</h2>
      <ul class="list-disc pl-5 space-y-2 text-slate-600 text-sm">
        {data.savingTips.map((tip) => (
          <li>{tip}</li>
        ))}
      </ul>
    </article>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['stromspiegel', 'bdew', 'destatis']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
