  { title: t('cat.watt.title') || 'Watt in kWh Rechner', href: getLocalizedPath('/watt-rechner', lang), description: t('cat.watt.desc') || 'Ermittle den kWh-Verbrauch aus Watt.' },
  { title: t('nav.appliances') || 'Geräte-Übersicht', href: getLocalizedPath('/geraete', lang), description: t('app.section.subtitle') || 'Übersicht für mehr als 25 Haushaltsgeräte.' },
  { title: t('cat.house.title') || 'Stromverbrauch Haushalt', href: getLocalizedPath('/stromverbrauch-haushalt', lang), description: t('cat.house.desc') || 'Monatskosten und Abschlag prüfen.' },
];

const schema = getCalculatorSchema(
  c.h1,
  c.sub,
  `/${lang}/stromkosten-rechner`
);
const faqs = getCalculatorFaqs('stromkosten-rechner', lang);
const faqSchema = getFaqSchema(faqs);
const pageSchemas = faqSchema ? [schema, faqSchema] : [schema];
---

<BaseLayout
  title={`${c.h1} | ${t('site.title')}`}
  description={c.sub}
  canonical={`https://kwhklar.de/${lang}/stromkosten-rechner`}
  jsonLd={pageSchemas}
  breadcrumbs={[
    { name: t('nav.calculators') || 'Rechner', path: getLocalizedPath('/stromkosten-rechner', lang) },
    { name: c.calcTitle, path: getLocalizedPath('/stromkosten-rechner', lang) }
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400">
      <a href={getLocalizedPath('/', lang)} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">{c.calcTitle}</span>
    </nav>

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">{c.badge}</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {c.h1}
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        {c.sub}
      </p>
    </div>

    <!-- The Live Calculator -->
    <UniversalCalculator
      defaultWatt={1000}
      defaultHours={1}
      defaultPriceCt={langInfo.defaultPricePerKwh * 100}
      title={c.calcTitle}
      subtitle={c.calcSubtitle}
      lang={lang}
    />

    <!-- Explanatory Content -->
    <article class="prose prose-slate dark:prose-invert max-w-4xl my-12 bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-10 border border-slate-200 dark:border-slate-800 shadow-xs">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{c.howTitle}</h2>
      <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
        {c.howIntro}
      </p>

      <div class="my-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-5 border border-slate-200 dark:border-slate-700/70 text-sm">
        <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2">{c.formulaHeading}</h3>
        <p class="font-mono text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/20 text-xs sm:text-sm">
          {c.formulaStr}
        </p>
      </div>

      <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-6">{c.exampleHeading}</h3>
      <ul class="list-disc pl-5 space-y-1.5 text-slate-600 dark:text-slate-300 text-sm">
        <li><strong>{c.examplePower}</strong></li>
        <li>{c.exampleHours}</li>
        <li>{c.exampleRate}</li>
        <li>{c.exampleDailyKwh}</li>
        <li>{c.exampleDailyCost}</li>
        <li><strong>{c.exampleMonthlyCost}</strong></li>
      </ul>

      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-8">{c.tipsHeading}</h2>
      <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
        {c.tipsText}
      </p>
    </article>

    <!-- Related Links -->
    <div class="max-w-4xl">
      <RelatedLinks links={relatedLinks} lang={lang} />
    </div>

    <!-- Source Box -->
    <div class="mt-8 max-w-4xl">
      <SourceBox sourceIds={['bnetza', 'bdew', 'destatis', 'stromspiegel']} lang={lang} />
    </div>

    <!-- FAQ Section -->
    <div class="mt-8 max-w-4xl">
      <FaqSection items={faqs} lang={lang} />
    </div>
  </div>
</BaseLayout>
