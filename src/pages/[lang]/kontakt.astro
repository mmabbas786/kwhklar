---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, type SupportedLanguage } from '../../i18n/languages';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const langInfo = languages[lang];
---

<BaseLayout
  title={`${t('footer.contact')} — ${t('site.title')}`}
  description={t('site.description')}
  canonical={`https://kwhklar.de/${lang}/kontakt`}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="inline-flex items-center gap-2 rounded-full bg-emerald-100/90 dark:bg-emerald-950/80 px-3.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 shadow-2xs mb-4">
      <span>{langInfo.flag} {langInfo.nativeName}</span>
    </div>
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight sm:text-4xl">
      {t('footer.contact')}
    </h1>
    <div class="mt-6 space-y-4 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
      <p>
        {lang === 'en' ? 'Have questions, feedback, or suggestions regarding our calculators and formulas? Reach out to our team:' :
         lang === 'es' ? '¿Tienes preguntas, comentarios o sugerencias sobre nuestras calculadoras? Escríbenos:' :
         lang === 'ja' ? '計算ツールや掲載データに関するご質問やご意見がございましたら、下記までお気軽にお問い合わせください。' :
         lang === 'fr' ? 'Vous avez des questions ou suggestions concernant nos calculateurs ? Contactez notre équipe :' :
         lang === 'pt' ? 'Tem dúvidas, comentários ou sugestões sobre nossas calculadoras? Fale com a nossa equipe:' :
         lang === 'ko' ? '계산기 기능 및 통계 데이터에 관한 문의나 의견이 있으시면 언제든지 연락해 주세요:' :
         'Hai domande o suggerimenti sui nostri calcolatori? Contatta il nostro team:'}
      </p>
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-6">
        <p class="font-semibold text-slate-900 dark:text-white">E-Mail:</p>
        <a href="mailto:kontakt@kwhklar.de" class="text-emerald-600 dark:text-emerald-400 font-bold hover:underline">
          kontakt@kwhklar.de
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
