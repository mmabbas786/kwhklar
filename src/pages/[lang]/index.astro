---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UniversalCalculator from '../../components/calculator/UniversalCalculator.astro';
import ApplianceCard from '../../components/cards/ApplianceCard.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';
import ApplianceIcon from '../../components/icons/ApplianceIcon.astro';
import { appliances } from '../../data/appliances';
import { householdBenchmarks } from '../../data/household-benchmarks';
import { formatEuro, formatKwh } from '../../lib/formatters';
import { languages, type SupportedLanguage } from '../../i18n/languages';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const langInfo = languages[lang];

const popularAppliances = [
  appliances['kuehlschrank'],
  appliances['waschmaschine'],
  appliances['trockner'],
  appliances['geschirrspueler'],
  appliances['gaming-pc'],
  appliances['fernseher'],
];

const homeFaqs = [
  {
    question: lang === 'en'
      ? 'How do you calculate electricity costs from watts and hours?'
      : lang === 'es'
      ? '¿Cómo se calcula el coste de electricidad a partir de vatios y horas?'
      : lang === 'fr'
      ? 'Comment calculer le coût de l\'électricité à partir des watts et des heures ?'
      : lang === 'it'
      ? 'Come si calcola il costo dell\'energia elettrica da watt e ore?'
      : lang === 'pt'
      ? 'Como calcular os custos de eletricidade a partir de watts e horas?'
      : lang === 'ja'
      ? 'ワット数と使用時間から電気代を計算するにはどうすればよいですか？'
      : '소비전력(W)과 사용 시간으로 전기요금을 어떻게 계산하나요?',
    answer: lang === 'en'
      ? 'Formula: Cost (€) = (Power in Watts × Operating Hours ÷ 1,000) × Electricity Price (€/kWh). Example: A 2,000 W appliance running for 2 hours consumes (2,000 × 2 ÷ 1,000) = 4 kWh. At €0.35/kWh, this costs €1.40.'
      : lang === 'es'
      ? 'Fórmula: Coste (€) = (Potencia en vatios × Horas de uso ÷ 1.000) × Precio kWh. Ejemplo: Un aparato de 2.000 W durante 2 horas consume 4 kWh. A 0,35 €/kWh cuesta 1,40 €.'
      : lang === 'fr'
      ? 'Formule : Coût (€) = (Puissance en Watts × Heures ÷ 1 000) × Prix du kWh. Exemple : Un appareil de 2 000 W pendant 2 heures consomme 4 kWh. À 0,35 €/kWh, cela coûte 1,40 €.'
      : lang === 'it'
      ? 'Formula: Costo (€) = (Potenza in Watt × Ore di utilizzo ÷ 1.000) × Prezzo kWh. Esempio: Un apparecchio da 2.000 W per 2 ore consuma 4 kWh. A 0,35 €/kWh costa 1,40 €.'
      : lang === 'pt'
      ? 'Fórmula: Custo (€) = (Potência em Watts × Horas de uso ÷ 1.000) × Preço kWh. Exemplo: Um aparelho de 2.000 W por 2 horas consome 4 kWh. A 0,35 €/kWh custa 1,40 €.'
      : lang === 'ja'
      ? '計算式: 電気代 (€) = (消費電力W × 使用時間h ÷ 1,000) × 単価 (€/kWh)。例: 2,000Wの機器を2時間使用すると4kWhとなり、単価0.35€の場合1.40€となります。'
      : '계산식: 전기요금 (€) = (소비전력W × 사용시간h ÷ 1,000) × 단가 (€/kWh). 예: 2,000W 기기를 2시간 사용 시 4kWh를 소비하며, 단가가 0.35€일 경우 1.40€입니다.',
  },
  {
    question: lang === 'en'
      ? 'What are typical standby power losses in a household?'
      : lang === 'es'
      ? '¿Cuáles son las pérdidas típicas de consumo en espera (standby)?'
      : lang === 'fr'
      ? 'Quelle est la consommation moyenne en veille dans un foyer ?'
      : lang === 'it'
      ? 'Quali sono le perdite tipiche di energia in standby?'
      : lang === 'pt'
      ? 'Quanto os aparelhos gastam em modo de espera (standby)?'
      : lang === 'ja'
      ? '家庭での待機電力はどれくらい発生しますか？'
      : '가정 내 대기전력으로 인한 낭비는 어느 정도인가요?',
    answer: lang === 'en'
      ? 'A typical household has 20 to 40 Watts of continuous standby load from TVs, routers, chargers, and appliances, costing €60 to €120 annually. Using switchable power strips eliminates this waste.'
      : lang === 'es'
      ? 'Un hogar promedio tiene entre 20 y 40 W de carga constante en reposo (TV, router, cargadores), lo que supone 60 a 120 € al año. Las regletas con interruptor evitan este gasto.'
      : lang === 'fr'
      ? 'Un foyer moyen cumule 20 à 40 W de veille continue (TV, box internet, chargeurs), soit 60 à 120 € par an. Les multiprises à interrupteur permettent de supprimer ces pertes.'
      : lang === 'it'
      ? 'Una casa tipo consuma costantemente 20-40 W in standby (TV, router, alimentatori), pari a 60-120 € all\'anno. Una presa multipla con interruttore risolve il problema.'
      : lang === 'pt'
      ? 'Uma residência média consome 20 a 40 W constantes em modo de espera, gerando um custo anual de 60 a 120 €. Réguas com interruptor eliminam essa perda.'
      : lang === 'ja'
      ? '一般的な家庭ではテレビ、ルーター、充電器などにより常時20〜40Wの待機電力が発生し、年間約60〜120€のコストになります。節電タップの活用でゼロにできます。'
      : '일반 가정에서는 TV, 공유기, 충전기 등으로 인해 상시 20~40W의 대기전력이 발생하여 연간 약 60~120€의 불필요한 비용이 청구됩니다. 절전 멀티탭으로 차단할 수 있습니다.',
  },
];
---

<BaseLayout
  title={t('site.title')}
  description={t('site.description')}
  canonical={`https://kwhklar.de/${lang}`}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-emerald-50/70 via-slate-50 to-slate-50 dark:from-slate-950 dark:via-slate-900/90 dark:to-slate-950 pt-10 pb-8 sm:pt-16 sm:pb-12 border-b border-slate-200/70 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-4 mb-8">
        <div class="inline-flex items-center gap-2 rounded-full bg-emerald-100/90 dark:bg-emerald-950/80 px-3.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 shadow-2xs">
          <span>{t('hero.badge')}</span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl">
          {t('hero.title')} <span class="text-emerald-600 dark:text-emerald-400">{t('hero.title_highlight')}</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto">
          {t('hero.subtitle')}
        </p>
      </div>

      <!-- Hero Calculator Island -->
      <UniversalCalculator
        defaultWatt={1000}
        defaultHours={1}
        defaultPriceCt={langInfo.defaultPricePerKwh * 100}
        title={t('calc.title')}
        subtitle={t('calc.subtitle')}
      />
    </div>
  </section>

  <!-- Popular Calculation Categories -->
  <section class="py-14 bg-white dark:bg-slate-900 border-b border-slate-200/70 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight sm:text-3xl">
          {t('categories.heading')}
        </h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          {t('categories.subheading')}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Card 1: Cost -->
        <a href={getLocalizedPath('/stromkosten-rechner', lang)} class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col justify-between dark:bg-slate-800/80 dark:border-slate-700 transition group">
          <div>
            <div class="h-11 w-11 rounded-xl bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 flex items-center justify-center mb-4 border border-emerald-500/20 group-hover:bg-emerald-500 group-hover:text-white transition-all">
              <ApplianceIcon name="calculator" class="h-6 w-6" />
            </div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition">{t('cat.cost.title')}</h3>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {t('cat.cost.desc')}
            </p>
          </div>
          <span class="mt-5 text-xs font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5 group-hover:text-emerald-700 dark:group-hover:text-emerald-300">
            {t('cat.cost.cta')}
          </span>
        </a>

        <!-- Card 2: kWh -->
        <a href={getLocalizedPath('/kwh-rechner', lang)} class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col justify-between dark:bg-slate-800/80 dark:border-slate-700 transition group">
          <div>
            <div class="h-11 w-11 rounded-xl bg-blue-100 dark:bg-blue-950/80 text-blue-700 dark:text-blue-400 flex items-center justify-center mb-4 border border-blue-500/20 group-hover:bg-blue-500 group-hover:text-white transition-all">
              <ApplianceIcon name="kwh" class="h-6 w-6" />
            </div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">{t('cat.kwh.title')}</h3>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {t('cat.kwh.desc')}
            </p>
          </div>
          <span class="mt-5 text-xs font-semibold text-blue-600 dark:text-blue-400 flex items-center gap-1.5 group-hover:text-blue-700 dark:group-hover:text-blue-300">
            {t('cat.kwh.cta')}
          </span>
        </a>

        <!-- Card 3: Watt -->
        <a href={getLocalizedPath('/watt-rechner', lang)} class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col justify-between dark:bg-slate-800/80 dark:border-slate-700 transition group">
          <div>
            <div class="h-11 w-11 rounded-xl bg-amber-100 dark:bg-amber-950/80 text-amber-700 dark:text-amber-400 flex items-center justify-center mb-4 border border-amber-500/20 group-hover:bg-amber-500 group-hover:text-white transition-all">
              <ApplianceIcon name="watt" class="h-6 w-6" />
            </div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base group-hover:text-amber-600 dark:group-hover:text-amber-400 transition">{t('cat.watt.title')}</h3>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {t('cat.watt.desc')}
            </p>
          </div>
          <span class="mt-5 text-xs font-semibold text-amber-600 dark:text-amber-400 flex items-center gap-1.5 group-hover:text-amber-700 dark:group-hover:text-amber-300">
            {t('cat.watt.cta')}
          </span>
        </a>

        <!-- Card 4: Household -->
        <a href={getLocalizedPath('/stromverbrauch-haushalt', lang)} class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col justify-between dark:bg-slate-800/80 dark:border-slate-700 transition group">
          <div>
            <div class="h-11 w-11 rounded-xl bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-400 flex items-center justify-center mb-4 border border-purple-500/20 group-hover:bg-purple-500 group-hover:text-white transition-all">
              <ApplianceIcon name="household" class="h-6 w-6" />
            </div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base group-hover:text-purple-600 dark:group-hover:text-purple-400 transition">{t('cat.house.title')}</h3>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {t('cat.house.desc')}
            </p>
          </div>
          <span class="mt-5 text-xs font-semibold text-purple-600 dark:text-purple-400 flex items-center gap-1.5 group-hover:text-purple-700 dark:group-hover:text-purple-300">
            {t('cat.house.cta')}
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Popular Appliances Section -->
  <section class="py-14 bg-slate-50 dark:bg-slate-950 border-b border-slate-200/70 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">2026</span>
          <h2 class="mt-1 text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
            {t('appliances.heading')}
          </h2>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
            {t('appliances.subheading')}
          </p>
        </div>
        <a
          href={getLocalizedPath('/geraete', lang)}
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-xs font-semibold text-slate-800 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 hover:border-emerald-400 transition"
        >
          {t('appliances.view_all')}
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {popularAppliances.map((appliance) => (
          <ApplianceCard appliance={appliance} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <!-- Household Benchmarks Section -->
  <section class="py-14 bg-white dark:bg-slate-900 border-b border-slate-200/70 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">2026</span>
        <h2 class="mt-1 text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          {t('benchmarks.heading')}
        </h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          {t('benchmarks.subheading')}
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/90 shadow-2xs">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold border-b border-slate-200 dark:border-slate-800">
            <tr>
              <th class="p-4">{t('table.size')}</th>
              <th class="p-4">{t('table.apt_no_water')}</th>
              <th class="p-4">{t('table.apt_water')}</th>
              <th class="p-4">{t('table.house')}</th>
              <th class="p-4 text-right">{t('table.cost_month')}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-600 dark:text-slate-300">
            {Object.values(householdBenchmarks).map((bm) => (
              <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/50 transition">
                <td class="p-4 font-semibold text-slate-900 dark:text-white">
                  {bm.label}
                </td>
                <td class="p-4">{formatKwh(bm.apartmentWithoutWarmWaterKwh, 0)}{t('table.per_year')}</td>
                <td class="p-4 text-emerald-600 dark:text-emerald-400 font-semibold">{formatKwh(bm.apartmentWithWarmWaterKwh, 0)}{t('table.per_year')}</td>
                <td class="p-4">{formatKwh(bm.houseWithoutWarmWaterKwh, 0)}{t('table.per_year')}</td>
                <td class="p-4 text-right font-bold text-slate-900 dark:text-white">{formatEuro(bm.typicalMonthlyCostEuro)}{t('table.per_month')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Sources & Methodology Box -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
    <SourceBox
      sourceIds={['bnetza', 'bdew', 'destatis', 'stromspiegel']}
      lang={lang}
    />
  </div>

  <!-- FAQ Section -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
    <FaqSection items={homeFaqs} lang={lang} />
  </div>
</BaseLayout>
