---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import { languages, type SupportedLanguage } from '../../i18n/languages';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const langInfo = languages[lang];
---

<BaseLayout
  title={`${t('footer.sources')} — ${t('site.title')}`}
  description={t('site.description')}
  canonical={`https://kwhklar.de/${lang}/quellen-methodik`}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="inline-flex items-center gap-2 rounded-full bg-emerald-100/90 dark:bg-emerald-950/80 px-3.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 shadow-2xs mb-4">
      <span>{langInfo.flag} {langInfo.nativeName}</span>
    </div>
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight sm:text-4xl">
      {t('footer.sources')}
    </h1>
    <p class="mt-4 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
      {lang === 'en' ? 'All mathematical calculations on kWhKlar are based on standardized physical formulas (1 kWh = 1,000 Watt-hours). Consumption benchmarks and electricity price indices originate from official statistical publications and monitoring agencies.' :
       lang === 'es' ? 'Todos los modelos de cálculo en kWhKlar se basan en fórmulas físicas estandarizadas (1 kWh = 1.000 Wh). Los consumos y precios de referencia provienen de publicaciones estadísticas oficiales.' :
       lang === 'ja' ? 'kWhKlarのすべての計算モデルは標準的な物理計算式（1 kWh = 1,000 Wh）に基づいています。機器の消費電力基準値や電気料金データは公式統計機関の発表資料に準拠しています。' :
       lang === 'fr' ? 'Tous les modèles mathématiques reposent sur les formules physiques standard (1 kWh = 1 000 Wh). Les consommations et prix proviennent de publications statistiques officielles.' :
       lang === 'pt' ? 'Todos os cálculos matemáticos utilizam fórmulas físicas padronizadas (1 kWh = 1.000 Wh). Os parâmetros de consumo e tarifas derivam de órgãos estatísticos oficiais.' :
       lang === 'ko' ? 'kWhKlar의 모든 계산 공식은 표준 물리 공식(1 kWh = 1,000 Wh)을 기반으로 하며, 가전제품 소비전력 및 요금 데이터는 공식 통계 자료에 근거합니다.' :
       'Tutti i modelli matematici si basano su formule fisiche standard (1 kWh = 1.000 Wh). I parametri di consumo e i prezzi provengono da fonti statistiche ufficiali.'}
    </p>
    <div class="mt-8">
      <SourceBox
        sourceIds={['bnetza', 'bdew', 'destatis', 'stromspiegel']}
        lang={lang}
      />
    </div>
  </div>
</BaseLayout>
