---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UniversalCalculator from '../../components/calculator/UniversalCalculator.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import { languages, type SupportedLanguage } from '../../i18n/languages';
import { useTranslations } from '../../i18n/utils';
import { appliances } from '../../data/appliances';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  
  // All sub-routes on kWhKlar
  const slugs: string[] = [
    // Calculators
    'stromverbrauch-rechner',
    'stromkosten-pro-stunde',
    'stromkosten-pro-tag',
    'stromkosten-pro-woche',
    'stromkosten-pro-monat',
    'stromkosten-pro-jahr',
    
    // Household
    'durchschnittlicher-stromverbrauch',
    'stromverbrauch-1-person',
    'stromverbrauch-2-personen',
    'stromverbrauch-3-personen',
    'stromverbrauch-4-personen',
    'stromverbrauch-5-personen',
    'stromverbrauch-wohnung',
    'stromverbrauch-einfamilienhaus',
    'stromverbrauch-pro-person',
    'stromverbrauch-senken',
    
    // Price
    'strompreis-aktuell',
    'strompreis-deutschland',
    'strompreis-pro-kwh',
    'strompreis-entwicklung',
    'strompreis-zusammensetzung',
    'dynamische-stromtarife',
    'stromanbieter-wechseln',
    
    // Bill
    'stromrechnung-pruefen',
    'stromrechnung-zu-hoch',
    'stromrechnung-berechnen',
    'stromrechnung-beispiel',
    'stromrechnung-senken',
    
    // Saving & Special
    'strom-sparen-tipps',
    'stromfresser',
    'standby-strom',
    'e-auto/stromkosten',
    'e-auto/ladekosten-rechner',
    'e-auto/kosten-pro-100-km',
    'waermepumpe/stromverbrauch',
    'waermepumpe/stromkosten',
    'waermepumpe/stromverbrauch-rechner',
    'photovoltaik/eigenverbrauch-rechner',
    'balkonkraftwerk/stromkosten-sparen',
  ];

  // Also include all 25+ appliance subpages
  Object.keys(appliances).forEach((slug) => {
    slugs.push(`geraete/${slug}`);
  });

  const paths = [];
  for (const lang of nonDefaultLangs) {
    for (const slug of slugs) {
      paths.push({
        params: { lang, slug },
        props: { slug },
      });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: SupportedLanguage; slug: string };
const t = useTranslations(lang);
const langInfo = languages[lang];

// Extract appliance if appliance subpage
const isAppliance = slug.startsWith('geraete/');
const applianceSlug = isAppliance ? slug.replace('geraete/', '') : null;
const appliance = applianceSlug ? appliances[applianceSlug] : null;

// Determine title
const rawName = appliance ? appliance.name : slug.split('/').pop()?.replace(/-/g, ' ') || 'Rechner';
const formattedTitle = rawName.charAt(0).toUpperCase() + rawName.slice(1);
---

<BaseLayout
  title={`${formattedTitle} | kWhKlar`}
  description={t('site.description')}
  canonical={`https://kwhklar.de/${lang}/${slug}`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="max-w-3xl mx-auto text-center mb-8">
      <div class="inline-flex items-center gap-2 rounded-full bg-emerald-100/90 dark:bg-emerald-950/80 px-3.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 shadow-2xs mb-3">
        <span>{langInfo.flag} {langInfo.nativeName}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {formattedTitle}
      </h1>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-400">
        {t('calc.subtitle')}
      </p>
    </div>

    <!-- Universal Calculator Island -->
    <UniversalCalculator
      defaultWatt={appliance?.typicalWattage || 1000}
      defaultHours={appliance?.typicalUsageHours || 1}
      defaultPriceCt={langInfo.defaultPricePerKwh * 100}
      title={`${formattedTitle} — ${t('calc.title')}`}
      subtitle={t('calc.subtitle')}
    />

    <div class="mt-12 max-w-4xl mx-auto">
      <SourceBox
        sourceIds={['bnetza', 'destatis', 'stromspiegel']}
        note="Berechnungen basieren auf standardisierten physikalischen Einheiten und offiziellen statistischen Richtwerten."
      />
    </div>
  </div>
</BaseLayout>
