---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UniversalCalculator from '../../components/calculator/UniversalCalculator.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';
import RelatedLinks from '../../components/seo/RelatedLinks.astro';
import ApplianceIcon from '../../components/icons/ApplianceIcon.astro';
import { appliances } from '../../data/appliances';
import { householdBenchmarks } from '../../data/household-benchmarks';
import { formatEuro, formatKwh, formatWatt } from '../../lib/formatters';
import { languages, type SupportedLanguage } from '../../i18n/languages';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { getLocalizedAppliance } from '../../i18n/appliances';
import { getLocalizedTopic } from '../../i18n/topics';
import { getGuideTranslations } from '../../i18n/guide-sections';
import { getCalculatorSchema, getFaqSchema } from '../../lib/structured-data';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  
  const slugs = [
    // Calculations & Units
    'stromkosten-pro-stunde',
    'stromkosten-pro-tag',
    'stromkosten-pro-woche',
    'stromkosten-pro-monat',
    'stromkosten-pro-jahr',
    'stromverbrauch-rechner',
    'durchschnittlicher-stromverbrauch',
    
    // Tariffs & Prices
    'strompreis-aktuell',
    'strompreis-deutschland',
    'strompreis-pro-kwh',
    'strompreis-entwicklung',
    'strompreis-zusammensetzung',
    'dynamische-stromtarife',
    'stromanbieter-wechseln',

    // Bills
    'stromrechnung-pruefen',
    'stromrechnung-zu-hoch',
    'stromrechnung-senken',
    'stromrechnung-berechnen',
    'stromrechnung-beispiel',

    // Households
    'stromverbrauch-pro-person',
    'stromverbrauch-1-person',
    'stromverbrauch-2-personen',
    'stromverbrauch-3-personen',
    'stromverbrauch-4-personen',
    'stromverbrauch-5-personen',
    'stromverbrauch-wohnung',
    'stromverbrauch-einfamilienhaus',
    'stromverbrauch-senken',

    // Saving & Special
    'strom-sparen-tipps',
    'stromfresser',
    'standby-strom',
    'e-auto/stromkosten',
    'e-auto/ladekosten-rechner',
    'e-auto/kosten-pro-100-km',
    'waermepumpe/stromverbrauch',
    'waermepumpe/stromkosten',
    'waermepumpe/stromverbrauch-rechner',
    'photovoltaik/eigenverbrauch-rechner',
    'balkonkraftwerk/stromkosten-sparen',
  ];

  // Also include all 25+ appliance subpages
  Object.keys(appliances).forEach((slug) => {
    slugs.push(`geraete/${slug}`);
  });

  const paths = [];
  for (const lang of nonDefaultLangs) {
    for (const slug of slugs) {
      paths.push({
        params: { lang, slug },
        props: { slug },
      });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: SupportedLanguage; slug: string };
const t = useTranslations(lang);
const langInfo = languages[lang];
const guide = getGuideTranslations(lang);

// Extract appliance if appliance subpage
const isAppliance = slug.startsWith('geraete/');
const applianceSlug = isAppliance ? slug.replace('geraete/', '') : null;
const appliance = applianceSlug ? appliances[applianceSlug] : null;
const localizedAppliance = applianceSlug ? getLocalizedAppliance(applianceSlug, lang) : null;
const localizedTopic = !isAppliance ? getLocalizedTopic(slug, lang) : null;

// Determine page nature
const isHouseholdPage = slug.startsWith('stromverbrauch-') || slug === 'durchschnittlicher-stromverbrauch';
const isPricePage = slug.startsWith('strompreis-') || slug === 'dynamische-stromtarife' || slug === 'stromanbieter-wechseln';

// Household specific data
let householdData = null;
if (isHouseholdPage) {
  if (slug === 'stromverbrauch-1-person' || slug === 'stromverbrauch-pro-person') householdData = householdBenchmarks[1];
  else if (slug === 'stromverbrauch-2-personen' || slug === 'stromverbrauch-wohnung') householdData = householdBenchmarks[2];
  else if (slug === 'stromverbrauch-3-personen' || slug === 'durchschnittlicher-stromverbrauch') householdData = householdBenchmarks[3];
  else if (slug === 'stromverbrauch-4-personen' || slug === 'stromverbrauch-einfamilienhaus') householdData = householdBenchmarks[4];
  else if (slug === 'stromverbrauch-5-personen') householdData = householdBenchmarks[5];
  else householdData = householdBenchmarks[3];
}

// Determine title and descriptions
const rawName = localizedAppliance?.name || localizedTopic?.title || appliance?.name || slug.split('/').pop()?.replace(/-/g, ' ') || 'Calculator';
const formattedTitle = rawName.charAt(0).toUpperCase() + rawName.slice(1);
const pageDescription = localizedAppliance?.shortDescription || localizedTopic?.shortDescription || appliance?.shortDescription || t('site.description');
const savingTips = localizedAppliance?.savingAdvice || localizedTopic?.savingAdvice || appliance?.savingAdvice || [];
const faqs = localizedAppliance?.faq || localizedTopic?.faq || appliance?.faq || [];

// Breadcrumb
const breadcrumbParentName = isAppliance 
  ? (t('nav.appliances') || 'Geräte') 
  : isHouseholdPage 
  ? (t('cat.house.title') || 'Haushalt') 
  : isPricePage 
  ? (t('nav.prices') || 'Strompreise') 
  : (t('nav.calculators') || 'Rechner');

const breadcrumbParentPath = isAppliance 
  ? getLocalizedPath('/geraete', lang) 
  : isHouseholdPage 
  ? getLocalizedPath('/stromverbrauch-haushalt', lang) 
  : isPricePage 
  ? getLocalizedPath('/strompreis', lang) 
  : getLocalizedPath('/stromkosten-rechner', lang);

const relatedLinks = [
  { title: t('cat.cost.title') || 'Stromkostenrechner', href: getLocalizedPath('/stromkosten-rechner', lang), description: t('cat.cost.desc') },
  { title: t('cat.kwh.title') || 'kWh in Euro', href: getLocalizedPath('/kwh-rechner', lang), description: t('cat.kwh.desc') },
  { title: t('cat.house.title') || 'Haushalt', href: getLocalizedPath('/stromverbrauch-haushalt', lang), description: t('cat.house.desc') },
  { title: t('nav.appliances') || 'Geräte-Übersicht', href: getLocalizedPath('/geraete', lang), description: t('app.section.subtitle') || 'Finde heraus, wie viel deine Geräte verbrauchen.' }
];

const calcSchema = getCalculatorSchema(
  `${formattedTitle} — ${t('calc.title')}`,
  pageDescription,
  `/${lang}/${slug}`
);
const faqSchema = getFaqSchema(faqs);
const pageSchemas = faqSchema ? [calcSchema, faqSchema] : [calcSchema];
---

<BaseLayout
  title={`${formattedTitle} | ${t('site.title')}`}
  description={pageDescription}
  canonical={`https://kwhklar.de/${lang}/${slug}`}
  jsonLd={pageSchemas}
  breadcrumbs={[
    { name: breadcrumbParentName, path: breadcrumbParentPath },
    { name: formattedTitle, path: `/${lang}/${slug}` }
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400">
      <a href={getLocalizedPath('/', lang)} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
      <span>/</span>
      <a href={breadcrumbParentPath} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{breadcrumbParentName}</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">{formattedTitle}</span>
    </nav>

    <!-- Header Section -->
    <div class="max-w-4xl mx-auto text-center mb-8">
      {isAppliance && applianceSlug ? (
        <div class="inline-flex h-16 w-16 items-center justify-center rounded-3xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-xs mb-4">
          <ApplianceIcon name={applianceSlug} class="h-9 w-9" />
        </div>
      ) : (
        <div class="inline-flex items-center gap-2 rounded-full bg-emerald-100/90 dark:bg-emerald-950/80 px-3.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 shadow-2xs mb-3">
          <span>{langInfo.flag} {localizedTopic?.category || breadcrumbParentName}</span>
        </div>
      )}
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {formattedTitle}
      </h1>
      <p class="mt-3.5 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed">
        {pageDescription}
      </p>

      <!-- Direct Answer Box -->
      <div class="mt-6 text-left rounded-2xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200/80 dark:border-emerald-800/60 p-5 sm:p-6 text-slate-800 dark:text-slate-200 leading-relaxed shadow-2xs">
        <strong class="font-bold text-emerald-950 dark:text-emerald-300 block text-base mb-1">
          {t('detail.quick_answer') || 'Direkte Antwort & Zusammenfassung auf einen Blick:'}
        </strong>
        <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
          {pageDescription}
        </p>
      </div>
    </div>

    <!-- Universal Calculator Island -->
    <UniversalCalculator
      defaultWatt={appliance?.calculationDefaults?.watt || appliance?.typicalWattage || (householdData ? Math.round(householdData.apartmentWithoutWarmWaterKwh / 1.4) : 1000)}
      defaultHours={appliance?.calculationDefaults?.hoursPerDay || appliance?.typicalUsageHours || 1}
      defaultPriceCt={langInfo.defaultPricePerKwh * 100}
      title={`${formattedTitle} — ${t('calc.title')}`}
      subtitle={t('calc.subtitle')}
      lang={lang}
    />

    <!-- Appliance-Specific Metrics -->
    {appliance && (
      <div class="mt-12 max-w-4xl mx-auto">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-5 flex items-center gap-2">
          <span class="text-emerald-500">📊</span>
          {t('detail.overview') || 'Überblick & Richtwerte'}
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-4 shadow-xs">
            <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400 block">{t('detail.annual_cost') || 'Typische Jahreskosten'}</span>
            <span class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white mt-1 block">{formatEuro(appliance.annualCostEuro)}{t('card.per_year')}</span>
          </div>

          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-4 shadow-xs">
            <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400 block">{t('detail.annual_kwh') || 'Jahresverbrauch'}</span>
            <span class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white mt-1 block">{formatKwh(appliance.typicalAnnualKwh, 0)}{t('table.per_year')}</span>
          </div>

          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-4 shadow-xs">
            <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400 block">{t('detail.typical_power') || 'Typische Leistung'}</span>
            <span class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white mt-1 block">{formatWatt(appliance.typicalWattage)}</span>
          </div>

          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-4 shadow-xs">
            <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400 block">{t('detail.daily_usage') || 'Typische Nutzung'}</span>
            <span class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white mt-1 block">{appliance.typicalUsageHours} h / Tag</span>
          </div>
        </div>

        {localizedAppliance?.dutyCycleExplanation && (
          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-6 shadow-xs mb-8">
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
              <span class="text-emerald-500">⚡</span>
              {t('detail.duty_cycle') || 'Taktung & Verbrauch im Detail'}
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {localizedAppliance.dutyCycleExplanation}
            </p>
          </div>
        )}
      </div>
    )}

    <!-- Household Benchmark Cards & Full Comparison Table -->
    {householdData && (
      <div class="mt-12 max-w-4xl mx-auto space-y-8">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
          <span class="text-emerald-500">🏠</span>
          {t('benchmarks.title') || 'Stromverbrauch nach Haushaltsgröße'}
        </h2>

        <!-- 3 Benchmark Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-5 shadow-xs">
            <span class="text-xs text-slate-500 dark:text-slate-400 font-medium block">{t('benchmarks.col_apt_noww') || 'Mietwohnung (ohne Warmwasser)'}</span>
            <div class="mt-2 text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">{formatKwh(householdData.apartmentWithoutWarmWaterKwh, 0)}</div>
            <span class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 block">ca. {(householdData.apartmentWithoutWarmWaterKwh * 0.35 / 12 + 12.5).toFixed(2).replace('.', ',')} € / {t('card.per_month') || 'Monat'}</span>
          </div>

          <div class="rounded-2xl border border-emerald-500/40 dark:border-emerald-500/30 bg-emerald-50/40 dark:bg-emerald-950/20 p-5 shadow-xs">
            <span class="text-xs text-emerald-700 dark:text-emerald-400 font-semibold flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              {t('benchmarks.col_apt_ww') || 'Wohnung (mit Warmwasser elektrisch)'}
            </span>
            <div class="mt-2 text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">{formatKwh(householdData.apartmentWithWarmWaterKwh, 0)}</div>
            <span class="text-xs text-emerald-600 dark:text-emerald-400/90 mt-1.5 block font-medium">ca. {(householdData.apartmentWithWarmWaterKwh * 0.35 / 12 + 12.5).toFixed(2).replace('.', ',')} € / {t('card.per_month') || 'Monat'}</span>
          </div>

          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-5 shadow-xs">
            <span class="text-xs text-slate-500 dark:text-slate-400 font-medium block">{t('benchmarks.col_house') || 'Einfamilienhaus'}</span>
            <div class="mt-2 text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">{formatKwh(householdData.houseWithoutWarmWaterKwh, 0)}</div>
            <span class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 block">ca. {(householdData.houseWithoutWarmWaterKwh * 0.35 / 12 + 12.5).toFixed(2).replace('.', ',')} € / {t('card.per_month') || 'Monat'}</span>
          </div>
        </div>

        <!-- Full Comparison Table -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 overflow-hidden shadow-xs">
          <div class="p-4 sm:p-5 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <h3 class="font-bold text-slate-900 dark:text-white text-base">
              {t('benchmarks.title') || 'Vergleich aller Haushaltsgrößen'}
            </h3>
            <span class="text-xs text-slate-500 dark:text-slate-400">Ø 35 ct/kWh</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-400 font-semibold border-b border-slate-200 dark:border-slate-800">
                <tr>
                  <th class="p-3.5 sm:p-4">{t('benchmarks.col_size') || 'Haushaltsgröße'}</th>
                  <th class="p-3.5 sm:p-4">{t('benchmarks.col_apt_noww') || 'Wohnung (ohne WW)'}</th>
                  <th class="p-3.5 sm:p-4">{t('benchmarks.col_apt_ww') || 'Wohnung (mit WW)'}</th>
                  <th class="p-3.5 sm:p-4">{t('benchmarks.col_house') || 'Einfamilienhaus'}</th>
                  <th class="p-3.5 sm:p-4">{t('benchmarks.col_cost') || 'Monatliche Kosten'}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
                {Object.values(householdBenchmarks).map((bm) => {
                  const isCurrent = householdData && householdData.persons === bm.persons;
                  const rowLabel = t(`benchmarks.row_${bm.persons}`) || bm.label;
                  const calcLink = getLocalizedPath(`/stromverbrauch-${bm.persons}-person${bm.persons > 1 ? 'en' : ''}`, lang);
                  return (
                    <tr class={`transition-colors hover:bg-slate-50/80 dark:hover:bg-slate-800/40 ${isCurrent ? 'bg-emerald-50/60 dark:bg-emerald-950/30 font-semibold' : ''}`}>
                      <td class="p-3.5 sm:p-4">
                        <a href={calcLink} class="text-emerald-700 dark:text-emerald-400 hover:underline flex items-center gap-1.5">
                          <span>{rowLabel}</span>
                          <span class="text-slate-400 text-xs">→</span>
                        </a>
                      </td>
                      <td class="p-3.5 sm:p-4">{formatKwh(bm.apartmentWithoutWarmWaterKwh, 0)}/{t('table.per_year') || 'Jahr'}</td>
                      <td class="p-3.5 sm:p-4">{formatKwh(bm.apartmentWithWarmWaterKwh, 0)}/{t('table.per_year') || 'Jahr'}</td>
                      <td class="p-3.5 sm:p-4">{formatKwh(bm.houseWithoutWarmWaterKwh, 0)}/{t('table.per_year') || 'Jahr'}</td>
                      <td class="p-3.5 sm:p-4 text-emerald-700 dark:text-emerald-400 font-semibold">{formatEuro(bm.typicalMonthlyCostEuro)}/{t('card.per_month') || 'Monat'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}

    <!-- Price Composition & 3-Step Guide (for Price / Tariff pages) -->
    {isPricePage && (
      <div class="mt-12 max-w-4xl mx-auto space-y-6">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
          <span class="text-emerald-500">💶</span>
          {guide.title}
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          {guide.description}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {guide.compositionItems.map((comp) => (
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs">
              <div class="flex items-center justify-between text-xs font-semibold text-slate-900 dark:text-white">
                <span>{comp.category}</span>
                <span class="text-emerald-700 dark:text-emerald-400">{comp.sharePercent.toFixed(1)} %</span>
              </div>
              <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">{comp.description}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Actionable Saving Advice (for all pages) -->
    {savingTips.length > 0 && (
      <div class="mt-12 max-w-4xl mx-auto rounded-3xl border border-emerald-500/30 dark:border-emerald-500/25 bg-emerald-50/40 dark:bg-emerald-950/20 p-6 sm:p-8 shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-5 flex items-center gap-2">
          <span class="text-emerald-500">💡</span>
          {t('detail.saving_tip') || 'Effektive Energiespartipps'}
        </h2>
        <ul class="space-y-3">
          {savingTips.map((tip) => (
            <li class="flex items-start gap-3 text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-bold text-xs mt-0.5">✓</span>
              <span>{tip}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Deep-Dive FAQ Section (4-5 High-Intent Questions) -->
    {faqs.length > 0 && (
      <div class="mt-12 max-w-4xl mx-auto">
        <FaqSection items={faqs} lang={lang} />
      </div>
    )}

    <!-- Localized Related Calculators & Content -->
    <div class="mt-12 max-w-4xl mx-auto">
      <RelatedLinks links={relatedLinks} lang={lang} />
    </div>

    <!-- Methodology & Sources -->
    <div class="mt-10 max-w-4xl mx-auto">
      <SourceBox
        sourceIds={appliance?.sourceIds || ['bnetza', 'bdew', 'destatis', 'stromspiegel']}
        lang={lang}
      />
    </div>
  </div>
</BaseLayout>
