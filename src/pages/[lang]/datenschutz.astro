---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type SupportedLanguage } from '../../i18n/languages';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t('footer.privacy')} | kWhKlar`}
  description="Datenschutzerklärung für kWhKlar.de gemäß DSGVO und TTDSG."
  canonical={`https://kwhklar.de/${lang}/datenschutz`}
  noindex={true}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white tracking-tight sm:text-4xl">
      {t('footer.privacy')}
    </h1>
    <div class="mt-6 space-y-4 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
      <h2 class="text-base font-bold text-slate-900 dark:text-white">1. Datenschutz auf einen Blick</h2>
      <p>
        Wir nehmen den Schutz deiner persönlichen Daten sehr ernst. Sämtliche Berechnungen auf kWhKlar finden rein clientseitig in deinem Browser statt.
      </p>
    </div>
  </div>
</BaseLayout>
