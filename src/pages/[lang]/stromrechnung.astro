---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import { languages, type SupportedLanguage } from '../../i18n/languages';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const langInfo = languages[lang];
---

<BaseLayout
  title={`${t('nav.bill')} — ${t('site.title')}`}
  description={t('site.description')}
  canonical={`https://kwhklar.de/${lang}/stromrechnung`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <div class="inline-flex items-center gap-2 rounded-full bg-emerald-100/90 dark:bg-emerald-950/80 px-3.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 shadow-2xs mb-3">
        <span>{langInfo.flag} {langInfo.nativeName}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t('nav.bill')}
      </h1>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-300">
        {lang === 'en' ? 'Understand, check and reduce your annual electricity bill.' :
         lang === 'es' ? 'Comprende, comprueba y reduce tu factura anual de la luz.' :
         lang === 'ja' ? '年間の電気料金明細を正しく理解し、節電につなげましょう。' :
         lang === 'fr' ? 'Comprendre, vérifier et réduire votre facture d\'électricité annuelle.' :
         lang === 'pt' ? 'Entenda, confira e reduza sua conta anual de energia elétrica.' :
         lang === 'ko' ? '연간 전기요금 고지서를 분석하고 요금을 효과적으로 절약하세요.' :
         'Comprendi, controlla e riduci la tua bolletta elettrica annuale.'}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-6 space-y-2.5 shadow-xs">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 font-bold">1</span>
        <h2 class="text-base font-bold text-slate-900 dark:text-white">
          {lang === 'en' ? 'Base Price (Grundpreis)' :
           lang === 'es' ? 'Término fijo (Base)' :
           lang === 'ja' ? '基本料金（固定費）' :
           lang === 'fr' ? 'Abonnement de base' :
           lang === 'pt' ? 'Tarifa básica fixa' :
           lang === 'ko' ? '기본요금 (고정비)' :
           'Quota fissa (Base)'}
        </h2>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          {lang === 'en' ? 'Fixed monthly fee for grid access, meter maintenance and metering (approx. €8–€15/month).' :
           lang === 'es' ? 'Cuota mensual fija por acceso a la red y mantenimiento del contador (aprox. 8–15 €/mes).' :
           lang === 'ja' ? '送電網利用・メーター管理等の月額固定費（月額約8〜15€）。' :
           lang === 'fr' ? 'Frais mensuels fixes pour l\'accès au réseau et le compteur (env. 8–15 €/mois).' :
           lang === 'pt' ? 'Valor mensal fixo para acesso à rede e medição (aprox. 8–15 €/mês).' :
           lang === 'ko' ? '전력망 접속 및 계량기 유지 관리를 위한 월 고정요금 (월 약 8~15€).' :
           'Costo fisso mensile per l\'accesso alla rete e la gestione del contatore (circa 8–15 €/mese).'}
        </p>
      </div>

      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-6 space-y-2.5 shadow-xs">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 font-bold">2</span>
        <h2 class="text-base font-bold text-slate-900 dark:text-white">
          {lang === 'en' ? 'Energy Price (Arbeitspreis)' :
           lang === 'es' ? 'Término de energía (Variable)' :
           lang === 'ja' ? '電力量料金（従量料金）' :
           lang === 'fr' ? 'Prix du kWh consommé' :
           lang === 'pt' ? 'Tarifa de consumo por kWh' :
           lang === 'ko' ? '전력량요금 (사용량 요금)' :
           'Quota energia (Variabile)'}
        </h2>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          {lang === 'en' ? 'Variable cost per kilowatt-hour actually consumed (approx. 30–38 cents/kWh).' :
           lang === 'es' ? 'Coste variable por cada kilovatio-hora realmente consumido (aprox. 30–38 céntimos/kWh).' :
           lang === 'ja' ? '実際に使用した電力（1kWhあたり約30〜38セント）に応じた従量課金。' :
           lang === 'fr' ? 'Coût variable par kilowattheure effectivement consommé (env. 30–38 centimes/kWh).' :
           lang === 'pt' ? 'Custo variável por cada quilowatt-hora consumido (aprox. 30–38 centavos/kWh).' :
           lang === 'ko' ? '실제 사용한 전력량(kWh당 약 30~38센트)에 비례하여 부과되는 요금.' :
           'Costo variabile per ogni chilowattora effettivamente consumato (circa 30–38 centesimi/kWh).'}
        </p>
      </div>
    </div>

    <div class="mt-10 max-w-4xl mx-auto">
      <SourceBox
        sourceIds={['bnetza', 'bdew']}
        lang={lang}
      />
    </div>
  </div>
</BaseLayout>
