---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ApplianceCard from '../../../components/cards/ApplianceCard.astro';
import SourceBox from '../../../components/trust/SourceBox.astro';
import { appliances } from '../../../data/appliances';
import { type SupportedLanguage } from '../../../i18n/languages';
import { useTranslations, getLocalizedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const applianceList = Object.values(appliances);

const categoryTranslations: Record<SupportedLanguage, Record<string, string>> = {
  de: {
    'Küche': 'Küche',
    'Haushalt & Reinigung': 'Haushalt & Reinigung',
    'Unterhaltung & Büro': 'Unterhaltung & Büro',
    'Klima & Heizen': 'Klima & Heizen',
    'Hobby & Spezial': 'Hobby & Spezial',
  },
  en: {
    'Küche': 'Kitchen & Cooking',
    'Haushalt & Reinigung': 'Household & Cleaning',
    'Unterhaltung & Büro': 'Entertainment, Gaming & Office',
    'Klima & Heizen': 'Climate, Cooling & Heating',
    'Hobby & Spezial': 'Hobby, Smart Home & Special',
  },
  es: {
    'Küche': 'Cocina y Preparación',
    'Haushalt & Reinigung': 'Hogar y Limpieza',
    'Unterhaltung & Büro': 'Entretenimiento, Gaming y Oficina',
    'Klima & Heizen': 'Climatización y Calefacción',
    'Hobby & Spezial': 'Ocio y Equipamiento Especial',
  },
  ja: {
    'Küche': 'キッチン・調理家電',
    'Haushalt & Reinigung': '生活・洗濯・掃除家電',
    'Unterhaltung & Büro': 'エンタメ・パソコン・オフィス',
    'Klima & Heizen': '空調・冷暖房・季節家電',
    'Hobby & Spezial': '趣味・スマートホーム・特殊設備',
  },
  fr: {
    'Küche': 'Cuisine et Préparation',
    'Haushalt & Reinigung': 'Ménage et Entretien',
    'Unterhaltung & Büro': 'Divertissement, Gaming et Bureau',
    'Klima & Heizen': 'Chauffage et Climatisation',
    'Hobby & Spezial': 'Loisirs et Équipements Spécifiques',
  },
  pt: {
    'Küche': 'Cozinha e Eletrodomésticos',
    'Haushalt & Reinigung': 'Casa e Limpeza',
    'Unterhaltung & Büro': 'Entretenimento, Gaming e Escritório',
    'Klima & Heizen': 'Climatização e Aquecimento',
    'Hobby & Spezial': 'Lazer e Equipamentos Especiais',
  },
  ko: {
    'Küche': '주방 및 조리 가전',
    'Haushalt & Reinigung': '생활, 세탁 및 청소 가전',
    'Unterhaltung & Büro': '엔터테인먼트, 게이밍 및 컴퓨터',
    'Klima & Heizen': '냉난방 및 계절 가전',
    'Hobby & Spezial': '취미, 스마트홈 및 특수 기기',
  },
  it: {
    'Küche': 'Cucina ed Elettrodomestici',
    'Haushalt & Reinigung': 'Casa e Pulizia',
    'Unterhaltung & Büro': 'Intrattenimento, Gaming e Ufficio',
    'Klima & Heizen': 'Climatizzazione e Riscaldamento',
    'Hobby & Spezial': 'Hobby e Dispositivi Speciali',
  },
};

const categories = [
  'Küche',
  'Haushalt & Reinigung',
  'Unterhaltung & Büro',
  'Klima & Heizen',
  'Hobby & Spezial',
] as const;

const categorizedAppliances = categories.map((cat) => ({
  categoryKey: cat,
  categoryName: categoryTranslations[lang]?.[cat] || cat,
  items: applianceList.filter((a) => a.category === cat),
}));
---

<BaseLayout
  title={`${t('appliances.heading')} | ${t('site.title')}`}
  description={t('appliances.subheading')}
  canonical={`https://kwhklar.de/${lang}/geraete`}
  breadcrumbs={[
    { name: t('nav.appliances') || 'Geräte', path: getLocalizedPath('/geraete', lang) }
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400">
      <a href={getLocalizedPath('/', lang)} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">{t('nav.appliances') || 'Geräte'}</span>
    </nav>

    <div class="max-w-3xl mb-10">
      <span class="badge-emerald text-xs mb-2">2026 Index</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t('appliances.heading')}
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        {t('appliances.subheading')}
      </p>
    </div>

    <!-- Category Sections -->
    <div class="space-y-12 mb-12">
      {categorizedAppliances.map(({ categoryName, items }) => (
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 p-6 sm:p-8">
          <div class="mb-6 flex items-center justify-between">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">{categoryName}</h2>
              <span class="text-xs text-slate-500 dark:text-slate-400">{items.length} {t('appliances.count_label') || 'Geräte erfasst'}</span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {items.map((appliance) => (
              <ApplianceCard appliance={appliance} lang={lang} />
            ))}
          </div>
        </section>
      ))}
    </div>

    <div class="max-w-7xl mx-auto">
      <SourceBox sourceIds={['bnetza', 'uba', 'stromspiegel', 'destatis']} lang={lang} />
    </div>
  </div>
</BaseLayout>
