---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { electricityPriceData } from '../../data/electricity-price';
import SourceBox from '../../components/trust/SourceBox.astro';
import { languages, type SupportedLanguage } from '../../i18n/languages';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const langInfo = languages[lang];
---

<BaseLayout
  title={`${t('nav.price')} — ${t('site.title')}`}
  description={t('site.description')}
  canonical={`https://kwhklar.de/${lang}/strompreis`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <div class="inline-flex items-center gap-2 rounded-full bg-emerald-100/90 dark:bg-emerald-950/80 px-3.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 shadow-2xs mb-3">
        <span>{langInfo.flag} {langInfo.nativeName}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t('nav.price')}
      </h1>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-300">
        {lang === 'en' ? 'Electricity Price Benchmarks & Cost Composition 2026' :
         lang === 'es' ? 'Precios de la electricidad y desglose de costes 2026' :
         lang === 'ja' ? '電気料金単価の目安と内訳構成 2026' :
         lang === 'fr' ? 'Prix de l\'électricité et composition des coûts 2026' :
         lang === 'pt' ? 'Tarifas de eletricidade e composição de custos 2026' :
         lang === 'ko' ? '전력량 요금단가 기준 및 구성 내역 2026' :
         'Prezzi dell\'energia elettrica e composizione dei costi 2026'}
      </p>
    </div>

    <div class="space-y-4 max-w-3xl mx-auto">
      {electricityPriceData.priceComposition.map((comp) => (
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-5 shadow-xs transition hover:border-slate-300 dark:hover:border-slate-700">
          <div class="flex items-center justify-between font-semibold text-slate-900 dark:text-white text-sm">
            <span>{comp.category}</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-bold">{comp.sharePercent.toFixed(1)} % ({comp.valueCtPerKwh.toFixed(2).replace('.', ',')} ct/kWh)</span>
          </div>
          <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">{comp.description}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 max-w-3xl mx-auto">
      <SourceBox
        sourceIds={['bnetza', 'bdew', 'destatis']}
        lang={lang}
      />
    </div>
  </div>
</BaseLayout>
