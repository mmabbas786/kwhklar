---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { electricityPriceData } from '../../data/electricity-price';
import SourceBox from '../../components/trust/SourceBox.astro';
import { type SupportedLanguage } from '../../i18n/languages';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
---

<BaseLayout
  title={`Strompreise & Zusammensetzung 2026 | kWhKlar`}
  description="Aktuelle Strompreise, Entwicklung und transparente Zusammensetzung der Stromkosten."
  canonical={`https://kwhklar.de/${lang}/strompreis`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Strompreise & Zusammensetzung
      </h1>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-400">
        Durchschnittswerte und Bestandteile des Arbeitspreises und Grundpreises.
      </p>
    </div>

    <div class="space-y-4 max-w-3xl mx-auto">
      {electricityPriceData.priceComposition.map((comp) => (
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs">
          <div class="flex items-center justify-between font-semibold text-slate-900 dark:text-white text-sm">
            <span>{comp.category}</span>
            <span class="text-emerald-600 dark:text-emerald-400">{comp.sharePercent.toFixed(1)} % ({comp.valueCtPerKwh.toFixed(2).replace('.', ',')} ct/kWh)</span>
          </div>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{comp.description}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 max-w-3xl mx-auto">
      <SourceBox
        sourceIds={['bnetza', 'bdew', 'destatis']}
        note="Offizielle Preisdaten gemäß Monitoringbericht der Bundesnetzagentur und des BDEW."
      />
    </div>
  </div>
</BaseLayout>
