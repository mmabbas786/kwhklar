---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../components/seo/RelatedLinks.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';
import { languages, type SupportedLanguage } from '../../i18n/languages';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { getCalculatorSchema, getFaqSchema } from '../../lib/structured-data';
import { getCalculatorFaqs } from '../../i18n/calculator-faqs';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const langInfo = languages[lang];

const pageContent: Record<SupportedLanguage, {
  badge: string;
  h1: string;
  sub: string;
  cardTitle: string;
  kwhLabel: string;
  priceLabel: string;
  totalLabel: string;
  tableTitle: string;
  colAmount: string;
  colRate1: string;
  colRate2: string;
  colRate3: string;
  faqs: { question: string; answer: string }[];
}> = {
  de: {
    badge: 'Umrechner',
    h1: 'kWh Rechner: Kilowattstunden in Euro & Kosten umrechnen',
    sub: 'Rechne jede beliebige Menge an Kilowattstunden (kWh) unkompliziert in Euro um bei aktuellem Strompreis.',
    cardTitle: 'kWh & Strompreis eingeben',
    kwhLabel: 'Strommenge in Kilowattstunden (kWh)',
    priceLabel: 'Strompreis in ct/kWh',
    totalLabel: 'Gesamtkosten',
    tableTitle: 'Übersicht: Typische kWh-Mengen in Euro (bei 35 ct/kWh)',
    colAmount: 'Verbrauchsmenge',
    colRate1: 'Kosten bei 30 ct/kWh',
    colRate2: 'Kosten bei 35 ct/kWh (Referenz)',
    colRate3: 'Kosten bei 40 ct/kWh',
    faqs: [
      { question: 'Was kosten 100, 500, 1.000 oder 3.500 kWh Strom?', answer: 'Bei einem Referenzpreis von 35 ct/kWh kosten 100 kWh = 35,00 €, 500 kWh = 175,00 €, 1.000 kWh = 350,00 € und 3.500 kWh = 1.225,00 €.' },
      { question: 'Was genau ist 1 Kilowattstunde (kWh)?', answer: '1 kWh ist die Energiemenge, die ein Gerät mit 1.000 Watt Leistung in genau 1 Stunde verbraucht (z.B. 1 Waschgang oder 70 Tassen Kaffee).' },
    ],
  },
  en: {
    badge: 'Interactive Converter',
    h1: 'kWh to Money Calculator: Convert Kilowatt-Hours to Euro (€)',
    sub: 'Convert any amount of electricity in kilowatt-hours (kWh) directly into costs in Euros based on your electricity rate.',
    cardTitle: 'Enter kWh & Electricity Rate',
    kwhLabel: 'Electricity amount in Kilowatt-Hours (kWh)',
    priceLabel: 'Electricity rate in ct/kWh (cents)',
    totalLabel: 'Total Calculated Cost',
    tableTitle: 'Quick Reference: Typical kWh Quantities in Euros (at 35 ct/kWh)',
    colAmount: 'Consumption Tier',
    colRate1: 'Cost at 30 ct/kWh',
    colRate2: 'Cost at 35 ct/kWh (Benchmark)',
    colRate3: 'Cost at 40 ct/kWh',
    faqs: [
      { question: 'How much do 100, 500, 1,000 or 3,500 kWh of electricity cost?', answer: 'At a standard rate of 35 ct/kWh (€0.35), 100 kWh = €35.00, 500 kWh = €175.00, 1,000 kWh = €350.00, and 3,500 kWh = €1,225.00.' },
      { question: 'What exactly is 1 kilowatt-hour (kWh)?', answer: '1 kWh is the energy consumed by a 1,000-watt device running for exactly 1 hour. It is enough to wash a load of laundry or brew about 70 cups of coffee.' },
    ],
  },
  es: {
    badge: 'Conversor Interactivo',
    h1: 'Calculadora de kWh a Euros: Convierte Kilovatios-Hora a Dinero',
    sub: 'Convierte cualquier consumo en kilovatios-hora (kWh) directamente a euros (€) según tu precio de la luz.',
    cardTitle: 'Introduce kWh y Precio de la Luz',
    kwhLabel: 'Cantidad de energía en Kilovatios-Hora (kWh)',
    priceLabel: 'Precio de la electricidad en céntimos (ct/kWh)',
    totalLabel: 'Coste Total Calculado',
    tableTitle: 'Tabla de Referencia: Consumo en kWh a Euros (a 35 ct/kWh)',
    colAmount: 'Volumen de Consumo',
    colRate1: 'Coste a 30 ct/kWh',
    colRate2: 'Coste a 35 ct/kWh (Referencia)',
    colRate3: 'Coste a 40 ct/kWh',
    faqs: [
      { question: '¿Cuánto cuestan 100, 500, 1.000 o 3.500 kWh de luz?', answer: 'A un precio de 35 ct/kWh (0,35 €), 100 kWh = 35,00 €, 500 kWh = 175,00 €, 1.000 kWh = 350,00 € y 3.500 kWh = 1.225,00 €.' },
      { question: '¿Qué es exactamente 1 kilovatio-hora (kWh)?', answer: '1 kWh es la energía que consume un aparato de 1.000 vatios funcionando durante 1 hora continua.' },
    ],
  },
  ja: {
    badge: '単位換算シミュレーター',
    h1: 'kWh換算計算機：電力量（kWh）を電気代（ユーロ/円）に瞬時換算',
    sub: '消費電力量（kWh）と電気料金単価を入力するだけで、合計電気代を瞬時に計算します。',
    cardTitle: 'kWhと電気料金単価を入力',
    kwhLabel: '消費電力量（kWh）',
    priceLabel: '電気料金単価（ct/kWh）',
    totalLabel: '合計電気代',
    tableTitle: '標準消費電力量（kWh）別電気代早見表（単価35 ct/kWh基準）',
    colAmount: '消費電力量',
    colRate1: '30 ct/kWhの場合',
    colRate2: '35 ct/kWhの場合（基準）',
    colRate3: '40 ct/kWhの場合',
    faqs: [
      { question: '100 kWh、500 kWh、1,000 kWh、3,500 kWhの電気代はいくら？', answer: '単価35 ct/kWh（0.35 €）の場合、100 kWh＝35.00 €、500 kWh＝175.00 €、1,000 kWh＝350.00 €、3,500 kWh＝1,225.00 €となります。' },
      { question: '1キロワット時（1 kWh）とは具体的にどれくらいのエネルギー？', answer: '1,000Wの家電をちょうど1時間使用したときの消費電力量です。洗濯機1回の運転やコーヒー約70杯分の抽出に相当します。' },
    ],
  },
  fr: {
    badge: 'Convertisseur Interactif',
    h1: 'Calculateur kWh en Euros : Convertir Kilowattheures en Coût Réel',
    sub: 'Convertissez instantanément n\'importe quel volume de kilowattheures (kWh) en euros selon votre tarif d\'électricité.',
    cardTitle: 'Saisir les kWh et le Tarif',
    kwhLabel: 'Consommation en kilowattheures (kWh)',
    priceLabel: 'Tarif en centimes (ct/kWh)',
    totalLabel: 'Coût Total Estimé',
    tableTitle: 'Tableau de Référence : Valeur des kWh en Euros (à 35 ct/kWh)',
    colAmount: 'Volume Consommé',
    colRate1: 'Coût à 30 ct/kWh',
    colRate2: 'Coût à 35 ct/kWh (Référence)',
    colRate3: 'Coût à 40 ct/kWh',
    faqs: [
      { question: 'Combien coûtent 100, 500, 1 000 ou 3 500 kWh d\'électricité ?', answer: 'À 35 ct/kWh (0,35 €), 100 kWh = 35,00 €, 500 kWh = 175,00 €, 1 000 kWh = 350,00 € et 3 500 kWh = 1 225,00 €.' },
      { question: 'Qu\'est-ce qu\'un kilowattheure (1 kWh) exactement ?', answer: 'C\'est l\'énergie consommée par un appareil de 1 000 Watts fonctionnant pendant 1 heure (ex. un cycle de lave-linge ou 70 tasses de café).' },
    ],
  },
  pt: {
    badge: 'Conversor Interativo',
    h1: 'Calculadora kWh para Euros: Converta Kilowatt-Hora em Dinheiro',
    sub: 'Converta qualquer consumo em kilowatt-hora (kWh) diretamente em euros com base no seu preço de eletricidade.',
    cardTitle: 'Introduza kWh e Tarifa',
    kwhLabel: 'Consumo de energia em Kilowatt-Hora (kWh)',
    priceLabel: 'Tarifa em cêntimos (ct/kWh)',
    totalLabel: 'Custo Total Calculado',
    tableTitle: 'Tabela de Referência: kWh em Euros (a 35 ct/kWh)',
    colAmount: 'Volume de Consumo',
    colRate1: 'Custo a 30 ct/kWh',
    colRate2: 'Custo a 35 ct/kWh (Referência)',
    colRate3: 'Custo a 40 ct/kWh',
    faqs: [
      { question: 'Quanto custam 100, 500, 1.000 ou 3.500 kWh de eletricidade?', answer: 'A 35 ct/kWh (0,35 €), 100 kWh = 35,00 €, 500 kWh = 175,00 €, 1.000 kWh = 350,00 € e 3.500 kWh = 1.225,00 €.' },
      { question: 'O que é exatamente 1 kilowatt-hora (kWh)?', answer: 'É a quantidade de energia que um aparelho de 1.000 Watts consome em 1 hora.' },
    ],
  },
  ko: {
    badge: '실시간 단위 변환기',
    h1: 'kWh 요금 변환기: 킬로와트시(kWh)를 전기요금(€/원)으로 즉시 환산',
    sub: '사용한 전력량(kWh)과 전기요금 단가를 입력하여 총 예상 비용을 즉시 산출하세요.',
    cardTitle: 'kWh 및 전력 단가 입력',
    kwhLabel: '사용 전력량 (킬로와트시, kWh)',
    priceLabel: '전력 단가 (ct/kWh)',
    totalLabel: '총 계산 요금',
    tableTitle: '주요 소비량별 전기요금 환산표 (단가 35 ct/kWh 기준)',
    colAmount: '사용 전력량',
    colRate1: '30 ct/kWh 적용 시',
    colRate2: '35 ct/kWh 적용 시 (기준)',
    colRate3: '40 ct/kWh 적용 시',
    faqs: [
      { question: '100, 500, 1,000, 3,500 kWh의 전기요금은 얼마인가요?', answer: '기준 단가 35 ct/kWh(0.35 €) 적용 시 100 kWh = 35.00 €, 500 kWh = 175.00 €, 1,000 kWh = 350.00 €, 3,500 kWh = 1,225.00 €입니다.' },
      { question: '1 킬로와트시(1 kWh)란 정확히 무엇인가요?', answer: '1,000W 출력의 가전제품을 1시간 동안 연속 가동했을 때 소비되는 전력 에너지의 양입니다.' },
    ],
  },
  it: {
    badge: 'Convertitore Interattivo',
    h1: 'Calcolatore da kWh a Euro: Converti Chilowattora in Costi Reali',
    sub: 'Converti qualsiasi quantità di chilowattora (kWh) direttamente in euro sulla base della tua tariffa elettrica.',
    cardTitle: 'Inserisci kWh e Prezzo Energia',
    kwhLabel: 'Quantità di energia in Chilowattora (kWh)',
    priceLabel: 'Prezzo dell\'energia in centesimi (ct/kWh)',
    totalLabel: 'Spesa Totale Calcolata',
    tableTitle: 'Tabella di Riferimento: Valore dei kWh in Euro (a 35 ct/kWh)',
    colAmount: 'Fascia di Consumo',
    colRate1: 'Costo a 30 ct/kWh',
    colRate2: 'Costo a 35 ct/kWh (Riferimento)',
    colRate3: 'Costo a 40 ct/kWh',
    faqs: [
      { question: 'Quanto costano 100, 500, 1.000 o 3.500 kWh di luce?', answer: 'A 35 ct/kWh (0,35 €), 100 kWh = 35,00 €, 500 kWh = 175,00 €, 1.000 kWh = 350,00 € e 3.500 kWh = 1.225,00 €.' },
      { question: 'Cos\'è esattamente 1 chilowattora (1 kWh)?', answer: 'È l\'energia consumata da un apparecchio da 1.000 Watt acceso per esattamente 1 ora.' },
    ],
  },
};

const c = pageContent[lang] || pageContent.en;

const relatedLinks = [
  { title: t('cat.watt.title') || 'Watt in kWh Rechner', href: getLocalizedPath('/watt-rechner', lang), description: t('cat.watt.desc') || 'Leistung in Kilowattstunden umrechnen.' },
  { title: t('cat.cost.title') || 'Stromkostenrechner', href: getLocalizedPath('/stromkosten-rechner', lang), description: t('cat.cost.desc') || 'Kosten aus Watt & Stunden berechnen.' },
  { title: t('nav.prices') || 'Strompreis pro kWh', href: getLocalizedPath('/strompreis', lang), description: t('prices.section.subtitle') || 'Aktuelle Strompreise und Tarife.' },
];

const schema = getCalculatorSchema(
  c.h1,
  c.sub,
  `/${lang}/kwh-rechner`
);
const faqs = getCalculatorFaqs('kwh-rechner', lang);
const faqSchema = getFaqSchema(faqs);
const pageSchemas = faqSchema ? [schema, faqSchema] : [schema];
---

<BaseLayout
  title={`${c.h1} | ${t('site.title')}`}
  description={c.sub}
  canonical={`https://kwhklar.de/${lang}/kwh-rechner`}
  jsonLd={pageSchemas}
  breadcrumbs={[
    { name: t('nav.calculators') || 'Rechner', path: getLocalizedPath('/stromkosten-rechner', lang) },
    { name: c.badge, path: getLocalizedPath('/kwh-rechner', lang) }
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400">
      <a href={getLocalizedPath('/', lang)} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">{c.badge}</span>
    </nav>

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">{c.badge}</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {c.h1}
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        {c.sub}
      </p>
    </div>

    <!-- Direct kWh to Euro Converter Card -->
    <div class="mx-auto my-8 max-w-4xl rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-md">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">{c.cardTitle}</h2>
          
          <div>
            <label for="kwh-input" class="block text-sm font-semibold text-slate-900 dark:text-slate-200 mb-1">
              {c.kwhLabel}
            </label>
            <input
              type="number"
              id="kwh-input"
              value="500"
              min="0"
              step="1"
              class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-lg font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
            />
          </div>

          <div>
            <label for="kwh-price-input" class="block text-sm font-semibold text-slate-900 dark:text-slate-200 mb-1">
              {c.priceLabel}
            </label>
            <input
              type="number"
              id="kwh-price-input"
              value={(langInfo.defaultPricePerKwh * 100).toFixed(1)}
              min="1"
              step="0.1"
              class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-lg font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
            />
          </div>

          <div class="flex flex-wrap gap-2 pt-1">
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-emerald-50 dark:hover:bg-emerald-950 hover:text-emerald-800 dark:hover:text-emerald-400" data-kwh="100">100 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-emerald-50 dark:hover:bg-emerald-950 hover:text-emerald-800 dark:hover:text-emerald-400" data-kwh="500">500 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-emerald-50 dark:hover:bg-emerald-950 hover:text-emerald-800 dark:hover:text-emerald-400" data-kwh="1000">1.000 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-emerald-50 dark:hover:bg-emerald-950 hover:text-emerald-800 dark:hover:text-emerald-400" data-kwh="2500">2.500 kWh</button>
            <button type="button" class="quick-kwh rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-emerald-50 dark:hover:bg-emerald-950 hover:text-emerald-800 dark:hover:text-emerald-400" data-kwh="3500">3.500 kWh</button>
          </div>
        </div>

        <div class="rounded-2xl bg-gradient-to-br from-slate-900 to-slate-800 dark:from-slate-950 dark:to-slate-900 p-6 text-white text-center space-y-4 shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">{c.totalLabel}</span>
          <div class="text-4xl sm:text-5xl font-extrabold text-emerald-400 tracking-tight" id="kwh-result-euro">
            175,00 €
          </div>
          <p class="text-xs text-slate-300" id="kwh-result-desc">
            500 kWh
          </p>
          <div class="pt-3 border-t border-slate-700 text-[11px] text-slate-400">
            <code>Cost = kWh × (Rate ÷ 100)</code>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Reference Table -->
    <div class="my-10 bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-xs">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">{c.tableTitle}</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-800">
            <tr>
              <th class="p-3">{c.colAmount}</th>
              <th class="p-3">{c.colRate1}</th>
              <th class="p-3">{c.colRate2}</th>
              <th class="p-3">{c.colRate3}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-600 dark:text-slate-300">
            <tr><td class="p-3 font-semibold text-slate-900 dark:text-white">1 kWh</td><td class="p-3">0,30 €</td><td class="p-3 font-semibold text-emerald-700 dark:text-emerald-400">0,35 €</td><td class="p-3">0,40 €</td></tr>
            <tr><td class="p-3 font-semibold text-slate-900 dark:text-white">100 kWh</td><td class="p-3">30,00 €</td><td class="p-3 font-semibold text-emerald-700 dark:text-emerald-400">35,00 €</td><td class="p-3">40,00 €</td></tr>
            <tr><td class="p-3 font-semibold text-slate-900 dark:text-white">500 kWh</td><td class="p-3">150,00 €</td><td class="p-3 font-semibold text-emerald-700 dark:text-emerald-400">175,00 €</td><td class="p-3">200,00 €</td></tr>
            <tr><td class="p-3 font-semibold text-slate-900 dark:text-white">1.000 kWh</td><td class="p-3">300,00 €</td><td class="p-3 font-semibold text-emerald-700 dark:text-emerald-400">350,00 €</td><td class="p-3">400,00 €</td></tr>
            <tr><td class="p-3 font-semibold text-slate-900 dark:text-white">2.500 kWh</td><td class="p-3">750,00 €</td><td class="p-3 font-semibold text-emerald-700 dark:text-emerald-400">875,00 €</td><td class="p-3">1.000,00 €</td></tr>
            <tr><td class="p-3 font-semibold text-slate-900 dark:text-white">3.500 kWh</td><td class="p-3">1.050,00 €</td><td class="p-3 font-semibold text-emerald-700 dark:text-emerald-400">1.225,00 €</td><td class="p-3">1.400,00 €</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <RelatedLinks links={relatedLinks} lang={lang} />
    <div class="mt-8">
      <SourceBox sourceIds={['bnetza', 'bdew', 'destatis']} lang={lang} />
    </div>
    <div class="mt-8">
      <FaqSection items={faqs} lang={lang} />
    </div>
  </div>
</BaseLayout>

<script define:vars={{ lang }}>
  function initKwhConverter() {
    const kwhInput = document.getElementById('kwh-input');
    const priceInput = document.getElementById('kwh-price-input');
    const resultEuro = document.getElementById('kwh-result-euro');
    const resultDesc = document.getElementById('kwh-result-desc');

    if (!kwhInput || !priceInput || !resultEuro || !resultDesc) return;

    const localeMap = { de: 'de-DE', en: 'en-US', es: 'es-ES', ja: 'ja-JP', fr: 'fr-FR', pt: 'pt-PT', ko: 'ko-KR', it: 'it-IT' };
    const activeLocale = localeMap[lang] || 'de-DE';

    function update() {
      const kwh = Math.max(0, parseFloat(kwhInput.value || '0') || 0);
      const priceCt = Math.max(0, parseFloat(priceInput.value || '0') || 0);
      const total = kwh * (priceCt / 100);

      resultEuro.textContent = new Intl.NumberFormat(activeLocale, { style: 'currency', currency: 'EUR' }).format(total);
      resultDesc.textContent = `${new Intl.NumberFormat(activeLocale).format(kwh)} kWh @ ${new Intl.NumberFormat(activeLocale).format(priceCt)} ct/kWh`;
    }

    kwhInput.addEventListener('input', update);
    priceInput.addEventListener('input', update);

    document.querySelectorAll('.quick-kwh').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const val = target.getAttribute('data-kwh');
        if (val && kwhInput) {
          kwhInput.value = val;
          update();
        }
      });
    });

    update();
  }

  document.addEventListener('DOMContentLoaded', initKwhConverter);
  document.addEventListener('astro:page-load', initKwhConverter);
