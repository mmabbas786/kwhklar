---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, type SupportedLanguage } from '../../i18n/languages';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const langInfo = languages[lang];
---

<BaseLayout
  title={`${t('footer.about')} — ${t('site.title')}`}
  description={t('site.description')}
  canonical={`https://kwhklar.de/${lang}/ueber-uns`}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="inline-flex items-center gap-2 rounded-full bg-emerald-100/90 dark:bg-emerald-950/80 px-3.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 shadow-2xs mb-4">
      <span>{langInfo.flag} {langInfo.nativeName}</span>
    </div>
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight sm:text-4xl">
      {t('footer.about')}
    </h1>
    <div class="mt-6 space-y-4 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
      <p>
        <strong class="text-slate-900 dark:text-white">kWhKlar</strong> {lang === 'en' ? 'is an independent, free platform providing transparent energy consumption calculations, electricity cost estimations, and energy-saving advice for households and consumers.' :
         lang === 'es' ? 'es una plataforma independiente y gratuita para calcular el consumo de electricidad, los costes de energía y fomentar la eficiencia en el hogar.' :
         lang === 'ja' ? 'は、家庭や消費者が電気代や消費電力量を分かりやすく正確に計算・把握できるように設計された中立的な情報ポータルです。' :
         lang === 'fr' ? 'est une plateforme indépendante dédiée au calcul transparent des coûts d\'électricité, de la consommation des appareils et à l\'efficacité énergétique.' :
         lang === 'pt' ? 'é uma plataforma independente para cálculo transparente de custos elétricos, consumo de energia e eficiência doméstica.' :
         lang === 'ko' ? '는 가전제품과 가구별 전기요금, 전력 소비량을 투명하고 정확하게 계산할 수 있도록 돕는 독립 정보 플랫폼입니다.' :
         'è una piattaforma indipendente per il calcolo trasparente dei costi dell\'elettricità, dei consumi energetici e dell\'efficienza domestica.'}
      </p>
      <p>
        {lang === 'en' ? 'Our mission is to translate complex utility tariffs and obscure power ratings into clear, actionable everyday numbers.' :
         lang === 'es' ? 'Nuestra misión es traducir tarifas eléctricas complejas y potencias en datos claros y útiles para el día a día.' :
         lang === 'ja' ? '私たちの目的は、複雑な電気料金プランや機器の消費電力表記を、誰もが直感的に理解できる実用的な数値へ変換することです。' :
         lang === 'fr' ? 'Notre mission est de rendre compréhensibles les factures complexes et la puissance des appareils au quotidien.' :
         lang === 'pt' ? 'Nossa missão é traduzir contas de luz complexas e especificações técnicas em números claros e práticos para o dia a dia.' :
         lang === 'ko' ? '복잡한 전기요금 체계와 가전제품의 소비전력을 누구나 쉽게 이해할 수 있는 일상적인 비용 데이터로 제공합니다.' :
         'La nostra missione è tradurre bollette complesse e specifiche tecniche in dati chiari e utili per la vita di tutti i giorni.'}
      </p>
    </div>
  </div>
</BaseLayout>
