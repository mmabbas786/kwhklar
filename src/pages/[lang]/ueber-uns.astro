---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type SupportedLanguage } from '../../i18n/languages';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  const nonDefaultLangs: SupportedLanguage[] = ['en', 'es', 'ja', 'fr', 'pt', 'ko', 'it'];
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t('footer.about')} | kWhKlar`}
  description="Über kWhKlar: Unsere Mission für unabhängige und transparente Energieberechnungen."
  canonical={`https://kwhklar.de/${lang}/ueber-uns`}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white tracking-tight sm:text-4xl">
      {t('footer.about')}
    </h1>
    <div class="mt-6 space-y-4 text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed">
      <p>
        <strong>kWhKlar</strong> ist eine unabhängige Plattform zur transparenten Berechnung und Visualisierung von Stromkosten, Stromverbrauch und Energieeffizienz für Haushalte und Verbraucher.
      </p>
      <p>
        Unser Ziel ist es, komplexe Stromrechnungen und Geräteverbräuche in verständliche, alltagstaugliche Zahlen zu übersetzen.
      </p>
    </div>
  </div>
</BaseLayout>
