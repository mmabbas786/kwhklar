---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversalCalculator from '../components/calculator/UniversalCalculator.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { householdBenchmarks } from '../data/household-benchmarks';
import { formatKwh } from '../lib/formatters';

const faqs = [
  {
    question: 'Warum ist der Stromverbrauch im Einfamilienhaus höher?',
    answer: 'Im Einfamilienhaus kommen zusätzliche Stromverbraucher hinzu: Heizungsumwälzpumpen (oft 100–300 kWh/Jahr), Außen- und Gartenbeleuchtung, elektrische Garagentore, Hebeanlagen, Alarmanlagen und oft größere Wohnflächen.',
  },
];

const related = [
  { title: 'Stromverbrauch Wohnung', href: '/stromverbrauch-wohnung', description: 'Vergleich mit der Mietwohnung.' },
  { title: 'Wärmepumpe Stromverbrauch', href: '/waermepumpe/stromverbrauch', description: 'Heizstrom im Einfamilienhaus.' },
  { title: 'Balkonkraftwerk / PV', href: '/balkonkraftwerk/stromkosten-sparen', description: 'Eigenverbrauch im Haus steigern.' },
  { title: '4-Personen-Haushalt', href: '/stromverbrauch-4-personen', description: 'Familien-Benchmark.' },
];
---

<BaseLayout
  title="Stromverbrauch Einfamilienhaus: Durchschnitt & Kosten | kWhKlar"
  description="Wie viel Strom verbraucht ein Einfamilienhaus? Richtwerte für 1–5 Personen im Eigenheim mit & ohne Wärmepumpe/Warmwasser."
  canonical="https://kwhklar.de/stromverbrauch-einfamilienhaus"
  breadcrumbs={[
    { name: 'Haushalt', path: '/stromverbrauch-haushalt' },
    { name: 'Einfamilienhaus', path: '/stromverbrauch-einfamilienhaus' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Haushalt', path: '/stromverbrauch-haushalt' },
        { name: 'Stromverbrauch Einfamilienhaus', path: '/stromverbrauch-einfamilienhaus' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Eigenheim Benchmark</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Stromverbrauch im Einfamilienhaus
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Ein Einfamilienhaus benötigt durch Haus- und Gartentechnik rund 4.000 bis 5.300 kWh Haushaltsstrom (ohne Wärmepumpe oder E-Auto).
      </p>
    </div>

    <!-- Overview Table -->
    <div class="my-8 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Einfamilienhaus-Richtwerte im Überblick (Stromspiegel)</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="p-3">Haushaltsgröße</th>
              <th class="p-3">Ohne Warmwasser (Zentral)</th>
              <th class="p-3">Mit Warmwasser (Elektrisch)</th>
              <th class="p-3 text-right">Monatskosten ca. (bei 35 ct)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-600">
            {Object.values(householdBenchmarks).map((b) => (
              <tr>
                <td class="p-3 font-semibold text-slate-900">{b.label}</td>
                <td class="p-3 text-emerald-700 font-medium">{formatKwh(b.houseWithoutWarmWaterKwh, 0)}/Jahr</td>
                <td class="p-3 text-amber-700 font-medium">{formatKwh(b.houseWithWarmWaterKwh, 0)}/Jahr</td>
                <td class="p-3 text-right font-bold text-slate-900">{Math.round((b.houseWithoutWarmWaterKwh * 0.35) / 12 + 12.5)} €/Monat</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <UniversalCalculator
      defaultWatt={500}
      defaultHours={24}
      defaultPriceCt={35.0}
      title="Hausstrom-Rechner"
      subtitle="Ermittle deine Stromkosten bei individuellem Hausverbrauch:"
    />

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['stromspiegel', 'bdew']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
