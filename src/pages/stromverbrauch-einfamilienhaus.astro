---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversalCalculator from '../components/calculator/UniversalCalculator.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { getCalculatorSchema, getFaqSchema } from '../lib/structured-data';

const faqs = [
  {
    question: "Wie hoch ist der normale Stromverbrauch in einem Einfamilienhaus?",
    answer: "In einem durchschnittlichen Einfamilienhaus liegt der Haushaltsstromverbrauch bei ca. 3.000 bis 4.500 kWh pro Jahr (ohne Wärmepumpe und E-Auto). Bei 2 Personen sind es ca. 2.800–3.200 kWh, bei 4 Personen ca. 3.800–4.400 kWh pro Jahr."
  },
  {
    question: "Wie viele kWh braucht ein Einfamilienhaus pro Tag?",
    answer: "Ein Einfamilienhaus verbraucht im Schnitt ca. 8 bis 13 kWh Strom pro Tag (ca. 2,80 bis 4,55 Euro täglich). Im Winter liegt der Tagesbedarf bei 12–16 kWh, im Sommer bei 6–9 kWh."
  },
  {
    question: "Wie viel Strom braucht ein Einfamilienhaus im Ruhezustand (Grundlast)?",
    answer: "Die Grundlast (Heizungspumpen, Kühlschränke, Router, Alarmanlage, Standby) liegt in einem Einfamilienhaus typischerweise bei 120 bis 250 Watt. Über 24 Stunden summiert sich dies auf ca. 3 bis 6 kWh pro Tag (ca. 1.000 bis 2.200 kWh im Jahr)."
  },
  {
    question: "Wie viel Strom verbraucht ein Einfamilienhaus mit Wärmepumpe?",
    answer: "Eine moderne Luft-Wasser-Wärmepumpe in einem gedämmten Haus verbraucht zusätzlich ca. 3.000 bis 5.000 kWh Heizstrom pro Jahr. Der Gesamtertrag des Hauses liegt dann bei ca. 6.500 bis 9.500 kWh jährlich."
  },
  {
    question: "Wie viel Strom verbraucht ein Haus mit Wärmepumpe und E-Auto?",
    answer: "Kommt zum Haushaltsstrom (ca. 4.000 kWh) und zur Wärmepumpe (ca. 4.000 kWh) noch ein Elektroauto mit 15.000 km Jahresfahrleistung (ca. 2.500–3.000 kWh) hinzu, liegt der Jahresgesamtbedarf bei ca. 10.500 bis 11.500 kWh."
  },
  {
    question: "Wie viel Strom spart eine Photovoltaik-Anlage im Einfamilienhaus?",
    answer: "Eine 10-kWp-PV-Anlage mit Batteriespeicher erzeugt ca. 10.000 kWh Solarstrom und kann 60 bis 75 % des gesamten Haushalts- und Heizstrombedarfs autark abdecken (Ersparnis oft 1.200 bis 2.000 Euro jährlich)."
  },
  {
    question: "Warum verbraucht ein Einfamilienhaus mehr als eine Wohnung?",
    answer: "Wegen zusätzlicher Verbraucher wie Heizungsumwälzpumpen, Außenbeleuchtung, Garagentorantrieben, Gartenpumpen, größeren Wohnflächen und dem Fehlen gemeinsamer isolierender Nachbarwände."
  },
  {
    question: "Wie viel Strom verbraucht eine alte Heizungspumpe im Keller?",
    answer: "Eine alte ungeregelte Heizungspumpe zieht 60 bis 90 Watt dauerhaft und verbraucht ca. 350 bis 550 kWh Strom pro Heizperiode (ca. 120 bis 190 Euro). Eine moderne Hocheffizienzpumpe (5–15 Watt) benötigt nur ca. 40 bis 80 kWh (ca. 15 bis 28 Euro)."
  },
  {
    question: "Wie viel Strom braucht ein Einfamilienhaus in der Nacht?",
    answer: "In den 8 Nachtstunden verbraucht ein Haus meist 1,0 bis 2,5 kWh (ca. 35 bis 88 Cent), primär durch Kühlgeräte, Router und die Heizungsregelung."
  },
  {
    question: "Lohnt sich ein dynamischer Stromtarif für ein Einfamilienhaus?",
    answer: "Besonders für Besitzer von Wärmepumpen oder Elektroautos lohnt sich ein dynamischer Börsenstromtarif (z. B. Tibber) in Kombination mit einem Smart Meter, um gezielt in günstigen Nacht- und Mittagsstunden Strom zu beziehen."
  }
];

const calcSchema = getCalculatorSchema(
  'Stromverbrauch Einfamilienhaus Rechner',
  'Berechne den jährlichen und täglichen Stromverbrauch für ein Einfamilienhaus mit oder ohne Wärmepumpe, E-Auto und PV.',
  '/stromverbrauch-einfamilienhaus'
);
const faqSchema = getFaqSchema(faqs);
const pageSchemas = faqSchema ? [calcSchema, faqSchema] : [calcSchema];

const related = [
  { title: 'Wärmepumpe Stromverbrauch', href: '/waermepumpe/stromverbrauch', description: 'Heizstrombedarf im Detail.' },
  { title: 'E-Auto Stromkosten', href: '/e-auto/stromkosten', description: 'Ladekosten für Elektroautos.' },
  { title: 'Stromverbrauch Haushalt', href: '/stromverbrauch-haushalt', description: 'Richtwerte für alle Haushaltsgrößen.' },
  { title: 'Photovoltaik Eigenverbrauch', href: '/photovoltaik/eigenverbrauch-rechner', description: 'Solarertrag optimieren.' },
];
---

<BaseLayout
  title="Stromverbrauch Einfamilienhaus: Richtwerte & Tagesverbrauch | kWhKlar"
  description="Wie viel Strom verbraucht ein Einfamilienhaus pro Tag & Jahr? Richtwerte für 2 bis 5 Personen, Einfluss von Wärmepumpe, E-Auto und PV mit Rechner."
  canonical="https://kwhklar.de/stromverbrauch-einfamilienhaus"
  jsonLd={pageSchemas}
  breadcrumbs={[
    { name: 'Haushalt', path: '/stromverbrauch-haushalt' },
    { name: 'Einfamilienhaus', path: '/stromverbrauch-einfamilienhaus' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Haushalt', path: '/stromverbrauch-haushalt' },
        { name: 'Stromverbrauch Einfamilienhaus', path: '/stromverbrauch-einfamilienhaus' },
      ]}
    />

    <div class="max-w-4xl mb-8">
      <span class="badge-emerald text-xs mb-2">Hausbesitzer-Leitfaden</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Stromverbrauch im Einfamilienhaus: Richtwerte &amp; Analyse
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Erfahre, wie viel Strom ein Einfamilienhaus pro Jahr und Tag verbraucht, was typische Grundlasten im Haus ausmachen und wie Wärmepumpe, E-Auto und Photovoltaik den Gesamtverbrauch prägen.
      </p>
    </div>

    <!-- Live Universal Calculator -->
    <UniversalCalculator
      defaultWatt={400}
      defaultHours={24}
      defaultPriceCt={35.0}
      title="Einfamilienhaus-Rechner"
      subtitle="Ermittle die jährlichen Stromkosten für dein Einfamilienhaus:"
    />

    <!-- Main Content Depth -->
    <div class="my-12 grid grid-cols-1 lg:grid-cols-12 gap-8">
      <article class="lg:col-span-8 space-y-10">
        
        <!-- Section: EFH Benchmark Matrix Table -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Einfamilienhaus-Vergleich: Von Haushaltsstrom bis Sektorkopplung
          </h2>
          <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6">
            So staffelt sich der typische Jahresstromverbrauch in einem deutschen Einfamilienhaus je nach Ausstattung (Basis: 35 ct/kWh):
          </p>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs sm:text-sm border-collapse">
              <thead>
                <tr class="border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400">
                  <th class="py-3 px-3 font-semibold">Konfiguration</th>
                  <th class="py-3 px-3 font-semibold">Jahresverbrauch</th>
                  <th class="py-3 px-3 font-semibold">Tagesverbrauch (Ø)</th>
                  <th class="py-3 px-3 font-semibold text-right">Jahreskosten (@ 35 ct)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">2 Personen (nur Haushaltsstrom)</td><td class="py-2.5 px-3">3.000 kWh</td><td class="py-2.5 px-3">ca. 8,2 kWh/Tag</td><td class="py-2.5 px-3 text-right font-semibold">1.050,00 €</td></tr>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30"><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">4 Personen (nur Haushaltsstrom)</td><td class="py-2.5 px-3">4.000 kWh</td><td class="py-2.5 px-3">ca. 11,0 kWh/Tag</td><td class="py-2.5 px-3 text-right font-semibold">1.400,00 €</td></tr>
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">4 Personen + elektr. Durchlauferhitzer</td><td class="py-2.5 px-3">5.400 kWh</td><td class="py-2.5 px-3">ca. 14,8 kWh/Tag</td><td class="py-2.5 px-3 text-right font-semibold">1.890,00 €</td></tr>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30"><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">4 Personen + Wärmepumpe</td><td class="py-2.5 px-3">8.000 kWh</td><td class="py-2.5 px-3">ca. 21,9 kWh/Tag</td><td class="py-2.5 px-3 text-right font-bold text-amber-700 dark:text-amber-400">2.800,00 €</td></tr>
                <tr><td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">4 Personen + Wärmepumpe + E-Auto</td><td class="py-2.5 px-3">10.500 kWh</td><td class="py-2.5 px-3">ca. 28,8 kWh/Tag</td><td class="py-2.5 px-3 text-right font-bold text-amber-700 dark:text-amber-400">3.675,00 €</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- FAQ Section -->
        <FaqSection items={faqs} />
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-900 p-6 text-white shadow-md">
          <h3 class="font-bold text-emerald-400 text-sm uppercase tracking-wider mb-3">
            Top 3 Haus-Stromfresser
          </h3>
          <ul class="text-xs space-y-2.5 text-slate-300">
            <li><strong class="text-white">1. Alte Heizungspumpe:</strong> Bis zu 500 kWh/Jahr (spart 150 € bei Tausch gegen Hocheffizienzpumpe).</li>
            <li><strong class="text-white">2. Zweit-Kühlschrank im Keller:</strong> Bis zu 350 kWh/Jahr.</li>
            <li><strong class="text-white">3. Elektrische Fußboden-Zusatzheizung:</strong> Bis zu 800 kWh/Jahr.</li>
          </ul>
        </div>

        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
          <h3 class="font-bold text-slate-900 dark:text-white text-sm mb-4">Spezialseiten fürs Haus</h3>
          <ul class="space-y-2 text-xs">
            <li><a href="/waermepumpe/stromverbrauch" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Wärmepumpe Stromverbrauch</a></li>
            <li><a href="/e-auto/stromkosten" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ E-Auto Stromkosten</a></li>
            <li><a href="/photovoltaik/eigenverbrauch-rechner" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ PV-Eigenverbrauchsrechner</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['stromspiegel', 'bdew', 'destatis']} />
  </div>
</BaseLayout>
