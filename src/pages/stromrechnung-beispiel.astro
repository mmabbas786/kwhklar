---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';

const faqs = [
  {
    question: 'Welche Bestandteile hat eine typische Jahresstromrechnung?',
    answer: 'Eine Stromrechnung besteht aus: 1. Abrechnungszeitraum & Kundendaten, 2. Verbrauchsermittlung (Anfangsstand, Endstand, Differenz in kWh), 3. Kostenberechnung (kWh × Arbeitspreis + Grundpreis), 4. Abzug der gezahlten Abschläge und 5. Rechnungsbetrag (Guthaben oder Nachzahlung).',
  },
];

const related = [
  { title: 'Stromrechnung prüfen', href: '/stromrechnung-pruefen', description: 'Rechnung kontrollieren.' },
  { title: 'Stromrechnung berechnen', href: '/stromrechnung-berechnen', description: 'Online-Rechner nutzen.' },
  { title: 'Strompreis Zusammensetzung', href: '/strompreis-zusammensetzung', description: 'Preisbestandteile.' },
];
---

<BaseLayout
  title="Stromrechnung Beispiel: Musterrechnung einfach erklärt | kWhKlar"
  description="Muster-Stromrechnung verständlich erklärt. Lerne alle Posten kennen: Zählerstände, Abrechnungszeitraum, kWh, Arbeitspreis und Abschläge."
  canonical="https://kwhklar.de/stromrechnung-beispiel"
  breadcrumbs={[
    { name: 'Stromrechnung', path: '/stromrechnung' },
    { name: 'Musterrechnung Beispiel', path: '/stromrechnung-beispiel' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Stromrechnung', path: '/stromrechnung' },
        { name: 'Stromrechnung Beispiel', path: '/stromrechnung-beispiel' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-blue text-xs mb-2">Musterabrechnung</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Stromrechnung Beispiel & Musterrechnung
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        So ist eine deutsche Jahresstromrechnung aufgebaut: Alle Fachbegriffe, Posten und Berechnungen Schritt für Schritt an einem anschaulichen Rechenbeispiel erklärt.
      </p>
    </div>

    <!-- Visual Sample Bill Card -->
    <div class="my-8 rounded-3xl border border-slate-200 bg-white p-6 sm:p-10 shadow-sm max-w-4xl mx-auto space-y-6">
      <div class="flex justify-between items-start border-b border-slate-200 pb-6">
        <div>
          <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider">Muster-Energieversorger GmbH</span>
          <h2 class="text-xl font-bold text-slate-900 mt-1">Jahresabrechnung Strom 2025/2026</h2>
          <p class="text-xs text-slate-500 mt-0.5">Abrechnungszeitraum: 01.01.2025 – 31.12.2025 (365 Tage)</p>
        </div>
        <div class="text-right text-xs text-slate-500">
          <span>Zählernummer: 1EMH0012345678</span><br />
          <span>Kundennummer: 987654321</span>
        </div>
      </div>

      <!-- Section 1: Meter reading -->
      <div class="rounded-2xl bg-slate-50 p-5 border border-slate-200 text-xs">
        <h3 class="font-bold text-slate-900 text-sm mb-3">1. Zählerstand & Verbrauch</h3>
        <div class="grid grid-cols-3 gap-4 text-center">
          <div>
            <span class="text-slate-500 block">Zählerstand alt (01.01.)</span>
            <span class="font-bold text-slate-800 text-sm">24.500 kWh</span>
          </div>
          <div>
            <span class="text-slate-500 block">Zählerstand neu (31.12.)</span>
            <span class="font-bold text-slate-800 text-sm">27.500 kWh</span>
          </div>
          <div>
            <span class="text-slate-500 block">Abrechnungsverbrauch</span>
            <span class="font-bold text-emerald-700 text-base">3.000 kWh</span>
          </div>
        </div>
      </div>

      <!-- Section 2: Financial Calculation -->
      <div class="rounded-2xl bg-slate-50 p-5 border border-slate-200 text-xs space-y-3">
        <h3 class="font-bold text-slate-900 text-sm mb-2">2. Kostenaufstellung</h3>
        <div class="flex justify-between py-1 border-b border-slate-200/60">
          <span>Arbeitspreis: 3.000 kWh × 35,00 ct/kWh</span>
          <span class="font-semibold text-slate-900">1.050,00 €</span>
        </div>
        <div class="flex justify-between py-1 border-b border-slate-200/60">
          <span>Grundpreis: 12 Monate × 12,50 €/Monat</span>
          <span class="font-semibold text-slate-900">150,00 €</span>
        </div>
        <div class="flex justify-between py-1 font-bold text-slate-900 text-sm">
          <span>Gesamtkosten Strom (inkl. 19 % MwSt.):</span>
          <span class="text-slate-900">1.200,00 €</span>
        </div>
      </div>

      <!-- Section 3: Reconciliation -->
      <div class="rounded-2xl bg-slate-900 p-6 text-white text-xs space-y-3">
        <h3 class="font-bold text-emerald-400 text-sm mb-2">3. Verrechnung der Abschläge & Ergebnis</h3>
        <div class="flex justify-between py-1 border-b border-slate-800">
          <span class="text-slate-300">Gesamte Jahreskosten:</span>
          <span class="font-semibold text-white">1.200,00 €</span>
        </div>
        <div class="flex justify-between py-1 border-b border-slate-800">
          <span class="text-slate-300">Geleistete Zahlungen (11 × 115,00 € Abschlag):</span>
          <span class="font-semibold text-white">- 1.265,00 €</span>
        </div>
        <div class="flex justify-between items-center pt-2">
          <span class="font-bold text-base text-emerald-300">Dein Abrechnungsguthaben (Rückzahlung):</span>
          <span class="text-2xl font-black text-emerald-400">+ 65,00 €</span>
        </div>
      </div>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'bdew']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
