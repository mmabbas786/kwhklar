---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';

const faqs = [
  {
    question: 'Welches ist der größte Stromfresser in einem durchschnittlichen Haushalt?',
    answer: 'In Haushalten mit elektrischer Warmwasserbereitung ist der elektrische Durchlauferhitzer / Boiler mit 500 bis 800 kWh pro Person der größte Einzelverbraucher. Ohne elektrisches Warmwasser sind es meist alte Kühlschränke (> 12 Jahre), Kondenstrockner, Gaming-PCs im Dauerbetrieb oder Heizlüfter.',
  },
];

const stromfresserList = [
  { rank: 1, name: 'Elektrischer Durchlauferhitzer / Boiler', kwh: '600–1.200 kWh/Person', cost: '210–420 €/Jahr', reason: 'Hohe Heizleistung von 18 bis 24 kW bei jedem Duschgang.' },
  { rank: 2, name: 'Alter Kühlschrank / Gefriertruhe (> 10 Jahre)', kwh: '300–500 kWh', cost: '105–175 €/Jahr', reason: 'Verschlissene Dichtungen, veraltete Kompressoren und Vereisung.' },
  { rank: 3, name: 'Heizlüfter / Radiator', kwh: '400–800 kWh', cost: '140–280 €/Jahr', reason: 'Direkte Strom-zu-Wärme-Umwandlung bei 2.000 Watt Leistungsaufnahme.' },
  { rank: 4, name: 'Kondenstrockner (alte Bauart)', kwh: '400–550 kWh', cost: '140–190 €/Jahr', reason: 'Keine Wärmerückgewinnung im Gegensatz zu Wärmepumpentrocknern.' },
  { rank: 5, name: 'Gaming-PC & High-End-Workstation', kwh: '400–700 kWh', cost: '140–245 €/Jahr', reason: 'Hohe Last von 400–600 Watt bei täglichem Gaming über mehrere Stunden.' },
  { rank: 6, name: 'Outdoor-Whirlpool / Poolpumpe', kwh: '700–3.000 kWh', cost: '245–1.050 €/Jahr', reason: 'Dauerhaftes Umwälzen und elektrisches Nachheizen großer Wassermengen.' },
];

const related = [
  { title: 'Standby-Strom', href: '/standby-strom', description: 'Versteckter Dauerstrom.' },
  { title: 'Strom sparen Tipps', href: '/strom-sparen-tipps', description: 'Praxistipps für jedes Zimmer.' },
  { title: 'Geräte Stromkosten', href: '/geraete', description: '25+ Geräte im Detail.' },
];
---

<BaseLayout
  title="Stromfresser im Haushalt: Die Top 10 Verbraucher & Einsparpotenziale | kWhKlar"
  description="Welche Geräte verbrauchen am meisten Strom? Die größten Stromfresser im Haushalt im Ranking: Kosten, Ursachen und Austausch-Tipps."
  canonical="https://kwhklar.de/stromfresser"
  breadcrumbs={[
    { name: 'Sparen', path: '/strom-sparen' },
    { name: 'Stromfresser', path: '/stromfresser' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Strom sparen', path: '/strom-sparen' },
        { name: 'Die größten Stromfresser', path: '/stromfresser' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-amber text-xs mb-2">Verbrauchsanalyse</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Die größten Stromfresser im Haushalt
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Wer seine Stromrechnung effektiv senken will, muss die echten Großverbraucher kennen. Hier ist das Ranking der energieintensivsten Haushaltsgeräte in Deutschland.
      </p>
    </div>

    <!-- Ranking Table -->
    <div class="my-8 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-slate-900 mb-6">Ranking der Top Stromverbraucher</h2>
      <div class="space-y-4">
        {stromfresserList.map((item) => (
          <div class="rounded-2xl border border-slate-100 bg-slate-50/60 p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3.5">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-black text-sm border border-emerald-500/20">
                #{item.rank}
              </span>
              <div>
                <h3 class="font-bold text-slate-900 dark:text-white text-base">{item.name}</h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">{item.reason}</p>
                <span class="text-xs text-slate-500 dark:text-slate-400 mt-1 block">Verbrauch: <strong class="text-slate-900 dark:text-slate-200">{item.kwh}</strong></span>
              </div>
            </div>
            <div class="text-right sm:shrink-0">
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-slate-200 border border-slate-200 dark:border-slate-700">{item.cost}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['stromspiegel', 'uba', 'bnetza']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
