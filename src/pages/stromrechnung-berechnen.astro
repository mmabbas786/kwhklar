---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { getCalculatorSchema } from '../lib/structured-data';

const schema = getCalculatorSchema(
  'Stromrechnung berechnen',
  'Berechne deine Jahresstromrechnung aus Zählerständen, Arbeitspreis, Grundpreis und geleisteten Abschlägen.',
  '/stromrechnung-berechnen'
);

const faqs = [
  {
    question: 'Wie wird die Jahresabrechnung genau kalkuliert?',
    answer: 'Jahresgesamtkosten = (Verbrauch in kWh × Arbeitspreis in €) + (12 × monatlicher Grundpreis in €). Von diesem Gesamtbetrag werden die im Jahresverlauf bezahlten 11 oder 12 Abschlagszahlungen abgezogen. Die Differenz ist dein Guthaben oder deine Nachzahlung.',
  },
];

const related = [
  { title: 'Stromrechnung prüfen', href: '/stromrechnung-pruefen', description: 'Rechnung Schritt für Schritt prüfen.' },
  { title: 'Stromrechnung zu hoch?', href: '/stromrechnung-zu-hoch', description: 'Typische Ursachen finden.' },
  { title: 'Musterrechnung', href: '/stromrechnung-beispiel', description: 'Beispielrechnung ansehen.' },
];
---

<BaseLayout
  title="Stromrechnung berechnen: Jahresabrechnung & Nachzahlung nachrechnen | kWhKlar"
  description="Berechne deine Stromrechnung selbst: Aus Zählerstand, Arbeitspreis, Grundpreis und Monatsabschlägen. Ermittle Guthaben oder Nachzahlung."
  canonical="https://kwhklar.de/stromrechnung-berechnen"
  jsonLd={schema}
  breadcrumbs={[
    { name: 'Stromrechnung', path: '/stromrechnung' },
    { name: 'Stromrechnung berechnen', path: '/stromrechnung-berechnen' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Stromrechnung', path: '/stromrechnung' },
        { name: 'Stromrechnung berechnen', path: '/stromrechnung-berechnen' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Abrechnungs-Rechner</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Stromrechnung & Jahresabrechnung berechnen
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Rechne deine Stromrechnung Cent-genau nach und prüfe, ob du eine Nachzahlung leisten musst oder ein Guthaben erhältst.
      </p>
    </div>

    <!-- Bill Simulator Form -->
    <div class="my-8 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-md max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-slate-900 mb-6">Rechnungsdaten eingeben</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="bill-kwh" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Jahresverbrauch in kWh</label>
          <input type="number" id="bill-kwh" value="3000" min="0" step="10" class="w-full rounded-xl border border-slate-200 p-3 text-base font-bold text-slate-900" />
        </div>

        <div>
          <label for="bill-price" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Arbeitspreis (ct/kWh)</label>
          <input type="number" id="bill-price" value="35.0" min="0" step="0.1" class="w-full rounded-xl border border-slate-200 p-3 text-base font-bold text-slate-900" />
        </div>

        <div>
          <label for="bill-base" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Grundpreis pro Monat (€)</label>
          <input type="number" id="bill-base" value="12.50" min="0" step="0.5" class="w-full rounded-xl border border-slate-200 p-3 text-base font-bold text-slate-900" />
        </div>

        <div>
          <label for="bill-prepaid" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Gezahlter monatlicher Abschlag (€)</label>
          <input type="number" id="bill-prepaid" value="100.00" min="0" step="1" class="w-full rounded-xl border border-slate-200 p-3 text-base font-bold text-slate-900" />
        </div>
      </div>

      <!-- Bill Result Card -->
      <div class="mt-8 rounded-2xl bg-gradient-to-br from-slate-900 to-slate-800 p-6 text-white space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pb-4 border-b border-slate-700 text-center">
          <div>
            <span class="text-xs text-slate-400 block">Verbrauchskosten</span>
            <span class="text-xl font-bold text-white block mt-1" id="bill-res-consumption">1.050,00 €</span>
          </div>
          <div>
            <span class="text-xs text-slate-400 block">Grundgebühren (Jahr)</span>
            <span class="text-xl font-bold text-white block mt-1" id="bill-res-base">150,00 €</span>
          </div>
          <div>
            <span class="text-xs text-slate-400 block">Geleistete Abschläge (12x)</span>
            <span class="text-xl font-bold text-slate-300 block mt-1" id="bill-res-paid">1.200,00 €</span>
          </div>
        </div>

        <div class="text-center pt-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-300 block" id="bill-res-status-title">Dein Abrechnungsergebnis</span>
          <div class="text-3xl sm:text-4xl font-extrabold tracking-tight mt-1 text-emerald-400" id="bill-res-final">
            0,00 € (Ausgeglichen)
          </div>
        </div>
      </div>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'bdew']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>

<script>
  function initBillCalculator() {
    const kwhIn = document.getElementById('bill-kwh') as HTMLInputElement | null;
    const priceIn = document.getElementById('bill-price') as HTMLInputElement | null;
    const baseIn = document.getElementById('bill-base') as HTMLInputElement | null;
    const paidIn = document.getElementById('bill-prepaid') as HTMLInputElement | null;

    const resCons = document.getElementById('bill-res-consumption');
    const resBase = document.getElementById('bill-res-base');
    const resPaid = document.getElementById('bill-res-paid');
    const resTitle = document.getElementById('bill-res-status-title');
    const resFinal = document.getElementById('bill-res-final');

    if (!kwhIn || !priceIn || !baseIn || !paidIn || !resFinal) return;

    function calc() {
      const kwh = Math.max(0, parseFloat(kwhIn?.value || '0') || 0);
      const priceCt = Math.max(0, parseFloat(priceIn?.value || '0') || 0);
      const baseMonthly = Math.max(0, parseFloat(baseIn?.value || '0') || 0);
      const monthlyPaid = Math.max(0, parseFloat(paidIn?.value || '0') || 0);

      const consCost = kwh * (priceCt / 100);
      const baseCost = baseMonthly * 12;
      const totalCost = consCost + baseCost;
      const totalPaid = monthlyPaid * 12;

      const diff = totalPaid - totalCost; // positive = refund/credit, negative = Nachzahlung

      const fmt = (v: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(v);

      if (resCons) resCons.textContent = fmt(consCost);
      if (resBase) resBase.textContent = fmt(baseCost);
      if (resPaid) resPaid.textContent = fmt(totalPaid);

      if (Math.abs(diff) < 0.01) {
        if (resTitle) resTitle.textContent = 'Abrechnung ausgeglichen';
        if (resFinal) {
          resFinal.textContent = '0,00 €';
          resFinal.className = 'text-3xl sm:text-4xl font-extrabold tracking-tight mt-1 text-slate-200';
        }
      } else if (diff > 0) {
        if (resTitle) resTitle.textContent = 'Erwartetes Guthaben / Rückzahlung:';
        if (resFinal) {
          resFinal.textContent = `+ ${fmt(diff)}`;
          resFinal.className = 'text-3xl sm:text-4xl font-extrabold tracking-tight mt-1 text-emerald-400';
        }
      } else {
        if (resTitle) resTitle.textContent = 'Erwartete Nachzahlung:';
        if (resFinal) {
          resFinal.textContent = `- ${fmt(Math.abs(diff))}`;
          resFinal.className = 'text-3xl sm:text-4xl font-extrabold tracking-tight mt-1 text-rose-400';
        }
      }
    }

    [kwhIn, priceIn, baseIn, paidIn].forEach((el) => el.addEventListener('input', calc));
    calc();
  }

  document.addEventListener('DOMContentLoaded', initBillCalculator);
  initBillCalculator();
</script>
