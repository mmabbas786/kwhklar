---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';
import { getCalculatorSchema, getFaqSchema } from '../lib/structured-data';

const faqs = [
  {
    question: "Wie wird die Jahresstromabrechnung mathematisch exakt berechnet?",
    answer: "Formel: (Jahresverbrauch in kWh × Arbeitspreis in €/kWh) + (12 × monatlicher Grundpreis in €) = Gesamtkosten. Davon wird die Summe aller gezahlten Abschläge (z. B. 12 × Monatsabschlag) abgezogen. Ist das Ergebnis positiv, zahlst du nach. Ist es negativ, erhältst du ein Guthaben."
  },
  {
    question: "Was mache ich, wenn meine berechnete Summe von der Versorgerrechnung abweicht?",
    answer: "Prüfe: 1. Wurde der Zählerstand unterjährig aufgeteilt (z. B. wegen Preiserhöhungen)? 2. Stimmt die Anzahl der gutgeschriebenen Abschläge? 3. Wurden Boni oder Rabatte verrechnet? 4. Weicht der berechnete Arbeitspreis vom Vertragspreis ab?"
  },
  {
    question: "Wie wird der neue monatliche Abschlag ermittelt?",
    answer: "Formel: (Voraussichtlicher Jahresverbrauch in kWh × aktueller Arbeitspreis + 12 × Grundpreis) ÷ 12 Monate. Dein Versorger darf den Abschlag nicht willkürlich über die tatsächlichen Gesamtkosten hinaus erhöhen."
  },
  {
    question: "Warum zahlt man manchmal trotz geringem Verbrauch nach?",
    answer: "Häufige Ursache: Der monatliche Abschlag war im Laufe des Jahres zu niedrig angesetzt (z. B. nur 50 € statt 80 €) oder der Energieversorger hat während des Jahres die Preise erhöht, ohne den Abschlag entsprechend anzupassen."
  },
  {
    question: "Wie viele Abschläge werden im Jahr bezahlt?",
    answer: "Die meisten Stromversorger verlangen 11 oder 12 monatliche Abschläge. Bei 11 Abschlägen wird im Abrechnungsmonat selbst kein regulärer Abschlag eingezogen."
  },
  {
    question: "Wie berechnet man den Stromverbrauch, wenn kein Endzählerstand vorliegt?",
    answer: "Lies deinen Stromzähler sofort selbst ab und trage ihn in das Kundenportal deines Anbieters ein. Verlasse dich niemals auf Schätzungen, da diese häufig zu hoch ausfallen."
  },
  {
    question: "Was ist der Unterschied zwischen Brutto- und Nettobeträgen auf der Rechnung?",
    answer: "Der Nettobetrag enthält nur Erzeugung, Netzentgelte und Umlagen ohne Mehrwertsteuer. Der Bruttobetrag enthält die gesetzliche Umsatzsteuer von 19 % und ist der Betrag, den du als Endverbraucher zahlen musst."
  },
  {
    question: "Wie wirkt sich ein Guthaben auf den nächsten Abschlag aus?",
    answer: "Ein Guthaben wird laut § 40c EnWG entweder auf dein Bankkonto überwiesen oder direkt mit der nächsten fälligen Abschlagszahlung verrechnet."
  },
  {
    question: "Kann ich meinen monatlichen Abschlag nach der Rechnung anpassen lassen?",
    answer: "Ja. Wenn du z. B. sparsamere Geräte gekauft hast oder Personen aus dem Haushalt ausgezogen sind, kannst du über das Online-Kundenportal oder den Kundenservice jederzeit eine Abschlagsreduzierung verlangen."
  },
  {
    question: "Wie berechne ich die Ersparnis durch einen günstigeren Stromanbieter?",
    answer: "Formel: Jahresverbrauch in kWh × (alter Preis ct/kWh - neuer Preis ct/kWh) ÷ 100 + (alter Grundpreis - neuer Grundpreis) = Jährliche Gesamtersparnis in Euro."
  }
];

const calcSchema = getCalculatorSchema(
  'Stromrechnung & Jahresabrechnung Berechnen',
  'Berechne deine Jahresstromrechnung aus Zählerständen, Arbeitspreis, Grundpreis und geleisteten Abschlägen.',
  '/stromrechnung-berechnen'
);
const faqSchema = getFaqSchema(faqs);
const pageSchemas = faqSchema ? [calcSchema, faqSchema] : [calcSchema];

const related = [
  { title: 'Stromrechnung prüfen', href: '/stromrechnung-pruefen', description: 'Rechnung Schritt für Schritt prüfen.' },
  { title: 'Stromrechnung zu hoch?', href: '/stromrechnung-zu-hoch', description: 'Typische Ursachen finden.' },
  { title: 'Musterrechnung Beispiel', href: '/stromrechnung-beispiel', description: 'Annotierte Beispielrechnung.' },
  { title: 'Stromrechnung senken', href: '/stromrechnung-senken', description: 'Kosten und Abschläge senken.' },
];
---

<BaseLayout
  title="Stromrechnung berechnen: Jahresabrechnung & Nachzahlung nachrechnen | kWhKlar"
  description="Berechne deine Stromrechnung selbst: Aus Zählerstand, Arbeitspreis, Grundpreis und Monatsabschlägen. Ermittle Guthaben oder Nachzahlung mit Online-Rechner."
  canonical="https://kwhklar.de/stromrechnung-berechnen"
  jsonLd={pageSchemas}
  breadcrumbs={[
    { name: 'Stromrechnung', path: '/stromrechnung' },
    { name: 'Stromrechnung berechnen', path: '/stromrechnung-berechnen' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Stromrechnung', path: '/stromrechnung' },
        { name: 'Stromrechnung berechnen', path: '/stromrechnung-berechnen' },
      ]}
    />

    <div class="max-w-4xl mb-8">
      <span class="badge-emerald text-xs mb-2">Abrechnungs-Rechner</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Stromrechnung &amp; Jahresabrechnung berechnen
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Rechne deine Stromrechnung Cent-genau nach und prüfe, ob du eine Nachzahlung leisten musst oder ein Guthaben erhältst.
      </p>
    </div>

    <!-- Bill Simulator Form -->
    <div class="my-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-md max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6">Rechnungsdaten eingeben</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="bill-kwh" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Jahresverbrauch in kWh</label>
          <input type="number" id="bill-kwh" value="3000" min="0" step="10" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-base font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20" />
        </div>

        <div>
          <label for="bill-price" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Arbeitspreis (ct/kWh)</label>
          <input type="number" id="bill-price" value="35.0" min="0" step="0.1" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-base font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20" />
        </div>

        <div>
          <label for="bill-base" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Grundpreis pro Monat (€)</label>
          <input type="number" id="bill-base" value="12.50" min="0" step="0.5" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-base font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20" />
        </div>

        <div>
          <label for="bill-prepaid" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Gezahlter monatlicher Abschlag (€)</label>
          <input type="number" id="bill-prepaid" value="100.00" min="0" step="1" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-base font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20" />
        </div>
      </div>

      <!-- Bill Result Card -->
      <div class="mt-8 rounded-2xl bg-gradient-to-br from-slate-900 to-slate-800 p-6 text-white space-y-4 shadow-inner">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pb-4 border-b border-slate-700 text-center">
          <div>
            <span class="text-xs text-slate-400 block">Verbrauchskosten</span>
            <span class="text-xl font-bold text-white block mt-1" id="bill-res-consumption">1.050,00 €</span>
          </div>
          <div>
            <span class="text-xs text-slate-400 block">Grundgebühren (Jahr)</span>
            <span class="text-xl font-bold text-white block mt-1" id="bill-res-base">150,00 €</span>
          </div>
          <div>
            <span class="text-xs text-slate-400 block">Geleistete Abschläge (12x)</span>
            <span class="text-xl font-bold text-slate-300 block mt-1" id="bill-res-paid">1.200,00 €</span>
          </div>
        </div>

        <div class="text-center pt-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block" id="bill-result-title">Abrechnungsergebnis</span>
          <div class="text-4xl font-extrabold text-emerald-400 mt-1" id="bill-result-val">
            0,00 € (Ausgeglichen)
          </div>
          <p class="text-xs text-slate-300 mt-2" id="bill-result-rec">
            Deine geleisteten Abschläge decken die tatsächlichen Gesamtkosten genau ab.
          </p>
        </div>
      </div>
    </div>

    <!-- Main Editorial Content Depth -->
    <div class="my-12 grid grid-cols-1 lg:grid-cols-12 gap-8">
      <article class="lg:col-span-8 space-y-10">
        
        <!-- Section: Billing Formula -->
        <section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-xs">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
            Die mathematische Rechnungsformel
          </h2>
          <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-4">
            Die Abrechnung deines Stromversorgers beruht auf einer festen mathematischen Formel:
          </p>
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 font-mono text-xs sm:text-sm text-emerald-600 dark:text-emerald-400 font-bold mb-4">
            Gesamtkosten = (Verbrauch in kWh × Arbeitspreis in €) + (12 × Grundpreis)<br/>
            Ergebnis = Gesamtkosten - Gezahlte Abschläge
          </div>
        </section>

        <!-- FAQ Section -->
        <FaqSection items={faqs} />
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
          <h3 class="font-bold text-slate-900 dark:text-white text-sm mb-4">Rechnungs-Themen</h3>
          <ul class="space-y-2 text-xs">
            <li><a href="/stromrechnung-pruefen" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromrechnung prüfen Checkliste</a></li>
            <li><a href="/stromrechnung-zu-hoch" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromrechnung zu hoch?</a></li>
            <li><a href="/stromrechnung-beispiel" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Muster-Stromrechnung</a></li>
            <li><a href="/stromanbieter-wechseln" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Stromanbieter wechseln</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'bdew']} />
  </div>
</BaseLayout>

<script>
  const inKwh = document.getElementById('bill-kwh') as HTMLInputElement | null;
  const inPrice = document.getElementById('bill-price') as HTMLInputElement | null;
  const inBase = document.getElementById('bill-base') as HTMLInputElement | null;
  const inPaid = document.getElementById('bill-prepaid') as HTMLInputElement | null;

  const resConsumption = document.getElementById('bill-res-consumption');
  const resBase = document.getElementById('bill-res-base');
  const resPaid = document.getElementById('bill-res-paid');
  const resTitle = document.getElementById('bill-result-title');
  const resVal = document.getElementById('bill-result-val');
  const resRec = document.getElementById('bill-result-rec');

  function calculate() {
    if (!inKwh || !inPrice || !inBase || !inPaid || !resConsumption || !resBase || !resPaid || !resVal || !resRec || !resTitle) return;

    const kwh = parseFloat(inKwh.value) || 0;
    const priceCt = parseFloat(inPrice.value) || 0;
    const baseMonth = parseFloat(inBase.value) || 0;
    const paidMonth = parseFloat(inPaid.value) || 0;

    const costConsumption = (kwh * priceCt) / 100;
    const costBase = baseMonth * 12;
    const totalCost = costConsumption + costBase;
    const totalPaid = paidMonth * 12;
    const diff = totalCost - totalPaid;

    resConsumption.textContent = costConsumption.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    resBase.textContent = costBase.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    resPaid.textContent = totalPaid.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

    const absDiffStr = Math.abs(diff).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    const idealAbschlag = (totalCost / 12).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

    if (diff > 0.5) {
      resTitle.textContent = 'Nachzahlung erforderlich';
      resVal.textContent = `+ ${absDiffStr}`;
      resVal.className = 'text-4xl font-extrabold text-amber-400 mt-1';
      resRec.textContent = `Deine Abschläge waren zu niedrig. Empfohlener neuer Abschlag für das nächste Jahr: ${idealAbschlag} / Monat.`;
    } else if (diff < -0.5) {
      resTitle.textContent = 'Guthaben für dich';
      resVal.textContent = `- ${absDiffStr}`;
      resVal.className = 'text-4xl font-extrabold text-emerald-400 mt-1';
      resRec.textContent = `Du hast zu viel vorausgezahlt! Der Versorger muss dir ${absDiffStr} erstatten. Neuer Richtabschlag: ${idealAbschlag} / Monat.`;
    } else {
      resTitle.textContent = 'Abrechnungsergebnis';
      resVal.textContent = '0,00 € (Ausgeglichen)';
      resVal.className = 'text-4xl font-extrabold text-emerald-400 mt-1';
      resRec.textContent = 'Perfekt! Deine geleisteten Abschläge decken deine Stromkosten exakt ab.';
    }
  }

  inKwh?.addEventListener('input', calculate);
  inPrice?.addEventListener('input', calculate);
  inBase?.addEventListener('input', calculate);
  inPaid?.addEventListener('input', calculate);
</script>
