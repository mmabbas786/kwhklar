---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';

const faqs = [
  {
    question: 'Was ist ein dynamischer Stromtarif?',
    answer: 'Bei einem dynamischen Tarif wird der Arbeitspreis stündlich an die aktuellen Großhandelspreise der Strombörse (EPEX SPOT Day-Ahead) angepasst. Bei viel Wind- und Sonnenenergie sinkt der Preis drastisch (teilweise sogar in den negativen Bereich), während er in den Abendstunden steigen kann.',
  },
  {
    question: 'Welche Hardware benötige ich für dynamische Stromtarife?',
    answer: 'Voraussetzung ist ein intelligentes Messsystem (Smart Meter / iMSys) oder ein digitaler Stromzähler mit Smart-Meter-Gateway / Ausleseadapter, der den Verbrauch stundengenau erfassen und an den Lieferanten übermitteln kann.',
  },
  {
    question: 'Für wen lohnt sich ein dynamischer Tarif am meisten?',
    answer: 'Besonders rentabel sind dynamische Tarife für Besitzer von Elektroautos (zeitgesteuertes Laden bei günstigen Börsenpreisen), Wärmepumpen mit Pufferspeicher oder großen Batteriespeichern.',
  },
];

const related = [
  { title: 'E-Auto Ladekosten', href: '/e-auto/stromkosten', description: 'Günstig laden mit dynamischen Tarifen.' },
  { title: 'Wärmepumpe Stromkosten', href: '/waermepumpe/stromkosten', description: 'Heizstrom optimieren.' },
  { title: 'Strompreis Deutschland', href: '/strompreis', description: 'Tarifmodelle im Überblick.' },
];
---

<BaseLayout
  title="Dynamische Stromtarife: Funktionsweise, Smart Meter & Nutzen | kWhKlar"
  description="Wie funktionieren dynamische Stromtarife? Voraussetzungen, Vor- & Nachteile, Börsenstrompreise (EPEX SPOT) und Einsparpotenziale für Haushalte."
  canonical="https://kwhklar.de/dynamische-stromtarife"
  breadcrumbs={[
    { name: 'Strompreis', path: '/strompreis' },
    { name: 'Dynamische Stromtarife', path: '/dynamische-stromtarife' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Strompreis', path: '/strompreis' },
        { name: 'Dynamische Stromtarife', path: '/dynamische-stromtarife' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-blue text-xs mb-2">Moderne Tarifmodelle</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Dynamische Stromtarife & Börsenstrompreise
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Verstehe, wie zeitvariable und dynamische Stromtarife funktionieren und wie du mit flexiblen Verbrauchern wie E-Auto oder Wärmepumpe von günstigen Börsenstrompreisen profitierst.
      </p>
    </div>

    <!-- Info Article -->
    <article class="prose prose-slate max-w-4xl my-8 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200">
      <h2 class="text-2xl font-bold text-slate-900">Wie funktioniert ein dynamischer Tarif?</h2>
      <p class="text-slate-600 leading-relaxed text-sm">
        Klassische Stromtarife bieten einen festen Arbeitspreis über 12 bis 24 Monate. Dynamische Tarife geben hingegen die stündlichen Preisschwankungen der europäischen Strombörse EPEX SPOT direkt an dich weiter.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
        <div class="rounded-2xl bg-emerald-50/40 dark:bg-emerald-950/20 p-5 border border-emerald-500/30 dark:border-emerald-500/25">
          <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2 flex items-center gap-1.5">
            <span class="text-emerald-500">✓</span> Vorteile
          </h3>
          <ul class="list-disc pl-4 space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
            <li>Günstiger Strom bei viel Wind & Sonne (teilweise unter 15 ct/kWh inkl. Abgaben).</li>
            <li>Enormes Sparpotenzial bei flexiblen Großverbrauchern (E-Auto, Wärmepumpe, Batteriespeicher).</li>
            <li>Volle Transparenz über stündliche Großhandelspreise am Vortag ab 13:00 Uhr.</li>
          </ul>
        </div>

        <div class="rounded-2xl bg-slate-50 dark:bg-slate-900/60 p-5 border border-slate-200 dark:border-slate-800">
          <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2 flex items-center gap-1.5">
            <span class="text-slate-400">ℹ</span> Herausforderungen & Risiken
          </h3>
          <ul class="list-disc pl-4 space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
            <li>Smart Meter (intelligentes Messsystem) zwingend erforderlich.</li>
            <li>Höhere Preise in den Spitzenzeiten am frühen Abend (17:00–20:00 Uhr) oder bei „Dunkelflauten“.</li>
            <li>Erfordert Bereitschaft zur automatisierten oder bewussten Lastverschiebung.</li>
          </ul>
        </div>
      </div>
    </article>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'smard']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
