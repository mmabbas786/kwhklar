---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../components/seo/RelatedLinks.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';
import { electricityPriceData } from '../../data/electricity-price';
import { formatCtPerKwh, formatEuro } from '../../lib/formatters';

const faqs = [
  {
    question: 'Wie hoch ist der aktuelle Strompreis pro kWh in Deutschland?',
    answer: 'Der durchschnittliche Strompreis für Haushaltskunden in Deutschland liegt bei ca. 35,0 Cent pro kWh (Stand 2026 laut Bundesnetzagentur & BDEW). Neukundentarife über Vergleichsportale liegen oft bei 26 bis 30 ct/kWh, während die Grundversorgung ca. 38 bis 43 ct/kWh kostet.',
  },
  {
    question: 'Warum unterscheiden sich Strompreise zwischen Bundesländern und Regionen?',
    answer: 'Der Hauptgrund sind regionale Unterschiede bei den Netzentgelten: In Regionen mit viel Windkraft- und Netzausbau (z.B. im Norden und Osten) fielen Netzentgelte historisch höher aus als im Süden oder in Ballungsräumen.',
  },
];

const related = [
  { title: 'Strompreis Zusammensetzung', href: '/strompreis-zusammensetzung', description: 'Steuern, Netzentgelte & Beschaffung.' },
  { title: 'Strompreis Entwicklung', href: '/strompreis-entwicklung', description: 'Historischer Verlauf 2018–2026.' },
  { title: 'Dynamische Stromtarife', href: '/dynamische-stromtarife', description: 'Börsenstrompreise & Smart Meter.' },
  { title: 'Strompreis pro kWh', href: '/strompreis-pro-kwh', description: 'Kosten je Kilowattstunde im Detail.' },
];
---

<BaseLayout
  title="Strompreis Deutschland: Aktueller Durchschnitt & Entwicklung | kWhKlar"
  description="Aktueller Strompreis in Deutschland (ca. 35 ct/kWh). Zusammensetzung, historische Preisentwicklung, regionale Unterschiede und Spartipps."
  canonical="https://kwhklar.de/strompreis"
  breadcrumbs={[{ name: 'Strompreis', path: '/strompreis' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Strompreis', path: '/strompreis' }]} />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Preisradar Deutschland</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Strompreis in Deutschland: Aktuelle Zahlen & Hintergründe
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Erfahre alles über den aktuellen deutschen Haushaltsstrompreis, die genaue Zusammensetzung aus Steuern, Netzentgelten und Beschaffung sowie die historische Preisentwicklung.
      </p>
    </div>

    <!-- Live Price Banner Card -->
    <div class="my-8 rounded-3xl border border-emerald-200 bg-gradient-to-br from-emerald-500 to-teal-700 p-6 sm:p-8 text-white shadow-md">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-100">Referenzpreis 2026 (BNetzA / BDEW)</span>
          <div class="mt-2 text-4xl sm:text-5xl font-black tracking-tight">
            {formatCtPerKwh(electricityPriceData.currentReferencePrice.valueCtPerKwh)}
          </div>
          <p class="mt-2 text-xs text-emerald-100 max-w-xl">
            {electricityPriceData.currentReferencePrice.scope}. Grundpreis im Schnitt: ca. 12,50 €/Monat ({formatEuro(150)}/Jahr).
          </p>
        </div>

        <div class="rounded-2xl bg-white/10 backdrop-blur-md p-4 border border-white/20 text-xs space-y-1.5 min-w-[240px]">
          <div class="flex justify-between">
            <span class="text-emerald-100">Günstige Neukunden:</span>
            <span class="font-bold text-white">ca. 26–30 ct/kWh</span>
          </div>
          <div class="flex justify-between">
            <span class="text-emerald-100">Bundesdurchschnitt:</span>
            <span class="font-bold text-white">35,0 ct/kWh</span>
          </div>
          <div class="flex justify-between">
            <span class="text-emerald-100">Örtliche Grundversorgung:</span>
            <span class="font-bold text-white">ca. 38–43 ct/kWh</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Composition & Structure -->
    <div class="my-10 grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs space-y-4">
        <h2 class="text-xl font-bold text-slate-900 tracking-tight">Zusammensetzung des Strompreises</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Der Strompreis setzt sich aus drei großen Säulen zusammen:
        </p>

        <div class="space-y-3 pt-2">
          {electricityPriceData.priceComposition.map((item) => (
            <div class="rounded-xl border border-slate-100 bg-slate-50 p-3.5">
              <div class="flex justify-between text-xs font-semibold text-slate-900">
                <span>{item.category}</span>
                <span class="text-emerald-700">{item.sharePercent.toFixed(1)} % ({item.valueCtPerKwh.toFixed(2).replace('.', ',')} ct)</span>
              </div>
              <p class="mt-1 text-[11px] text-slate-500">{item.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Historical Trends -->
      <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs space-y-4">
        <h2 class="text-xl font-bold text-slate-900 tracking-tight">Preisentwicklung seit 2018</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
              <tr>
                <th class="p-2.5">Jahr</th>
                <th class="p-2.5">Ø Preis ct/kWh</th>
                <th class="p-2.5">Marktsituation</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-600">
              {electricityPriceData.historicalTrends.map((h) => (
                <tr class={h.year === 2026 ? 'bg-emerald-50/60 font-semibold text-emerald-950' : ''}>
                  <td class="p-2.5">{h.year}</td>
                  <td class="p-2.5 font-bold">{h.averagePriceCtPerKwh.toFixed(2).replace('.', ',')} ct</td>
                  <td class="p-2.5 text-[11px] text-slate-500">{h.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'bdew', 'destatis', 'smard']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
