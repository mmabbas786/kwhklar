---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversalCalculator from '../components/calculator/UniversalCalculator.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import { getCalculatorSchema } from '../lib/structured-data';

const schema = getCalculatorSchema(
  'Stromkosten pro Woche',
  'Berechne die wöchentlichen Stromkosten für Geräte und Arbeitsplätze mit flexiblen Nutzungstagen.',
  '/stromkosten-pro-woche'
);

const related = [
  { title: 'Stromkosten pro Tag', href: '/stromkosten-pro-tag', description: 'Tägliche Kosten.' },
  { title: 'Stromkosten pro Monat', href: '/stromkosten-pro-monat', description: 'Monatliche Kosten.' },
  { title: 'Stromkostenrechner', href: '/stromkosten-rechner', description: 'Gesamtstromkostenrechner.' },
];
---

<BaseLayout
  title="Stromkosten pro Woche berechnen | kWhKlar"
  description="Berechne deine wöchentlichen Stromkosten für Arbeitsplatz, Gaming-Setups oder Haushaltsgeräte mit flexiblen Nutzungstagen."
  canonical="https://kwhklar.de/stromkosten-pro-woche"
  jsonLd={schema}
  breadcrumbs={[{ name: 'Stromkosten pro Woche', path: '/stromkosten-pro-woche' }]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Stromkosten pro Woche', path: '/stromkosten-pro-woche' }]} />

    <div class="max-w-3xl mb-6">
      <span class="badge-blue text-xs mb-2">Wochenkosten</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Stromkosten pro Woche berechnen
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Ideal für Arbeitsplatz- und Homeoffice-Setups mit 5 Werktagen oder Wochenend-Aktivitäten.
      </p>
    </div>

    <UniversalCalculator
      defaultWatt={150}
      defaultHours={8}
      defaultPriceCt={35.0}
      defaultDaysPerWeek={5}
      title="Wochenkosten-Rechner"
      subtitle="Berechne die wöchentlichen Stromkosten auf Basis von Watt und Nutzungstagen:"
    />

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'bdew']} />
  </div>
</BaseLayout>
