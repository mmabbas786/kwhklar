---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Seite nicht gefunden (404) | kWhKlar"
  description="Die gewünschte Seite konnte leider nicht gefunden werden. Nutze unsere Schnellsuche oder starte direkt mit dem Stromkostenrechner."
  canonical="https://kwhklar.de/404"
  noindex={true}
>
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:px-8">
    <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-800 text-2xl font-black mb-6">
      404
    </div>
    <h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl tracking-tight">
      Seite nicht gefunden
    </h1>
    <p class="mt-3 text-base text-slate-600 leading-relaxed max-w-lg mx-auto">
      Die von dir aufgerufene Adresse existiert leider nicht (mehr) oder wurde verschoben.
    </p>

    <!-- Quick Navigation Links -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition"
      >
        Zur Startseite
      </a>
      <a
        href="/stromkosten-rechner"
        class="rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 transition"
      >
        Zum Stromkostenrechner
      </a>
      <a
        href="/geraete"
        class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-2xs hover:bg-slate-50 transition"
      >
        Geräteübersicht
      </a>
    </div>
  </div>
</BaseLayout>
