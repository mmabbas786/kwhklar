---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../components/seo/RelatedLinks.astro';
import SourceBox from '../../components/trust/SourceBox.astro';
import FaqSection from '../../components/content/FaqSection.astro';
import { getCalculatorSchema, getFaqSchema } from '../../lib/structured-data';

const faqs = [
  {
    question: "Wie hoch ist die Eigenverbrauchsquote mit und ohne Stromspeicher?",
    answer: "Ohne Stromspeicher nutzt ein typischer 4-Personen-Haushalt ca. 25 bis 35 % des erzeugten PV-Stroms direkt im Haus (der Rest wird für 7–8 ct/kWh eingespeist). Mit einem passend dimensionierten Heimspeicher (z. B. 8 bis 10 kWh Kapazität bei einer 10-kWp-Anlage) steigt die Eigenverbrauchsquote auf ca. 65 bis 80 %."
  },
  {
    question: "Warum ist hoher Eigenverbrauch viel lukrativer als die Netzeinspeisung?",
    answer: "Jede selbst verbrauchte Kilowattstunde Solarstrom ersetzt Netzstrom für ca. 35 ct/kWh. Für eingespeisten Strom erhältst du nach dem EEG lediglich rund 7 bis 8 ct/kWh. Die finanzielle Ersparnis durch Selbstverbrauch ist mit ca. 27 ct/kWh fast viermal so hoch wie die Einspeisevergütung."
  },
  {
    question: "Was ist der Unterschied zwischen Eigenverbrauchsquote und Autarkiegrad?",
    answer: "Die Eigenverbrauchsquote gibt an, wie viel Prozent des auf dem Dach erzeugten Solarstroms im eigenen Haus verbraucht werden. Der Autarkiegrad gibt an, wie viel Prozent deines gesamten häuslichen Strombedarfs durch die PV-Anlage gedeckt werden."
  },
  {
    question: "Wie viel Strom erzeugt 1 kWp Photovoltaik in Deutschland pro Jahr?",
    answer: "Je nach Region, Dachneigung und Ausrichtung erzeugt 1 kWp installierte Modulleistung in Deutschland zwischen 900 und 1.100 kWh Solarstrom pro Jahr (Süddeutschland ca. 1.050–1.150 kWh, Norddeutschland ca. 850–950 kWh)."
  },
  {
    question: "Gilt für private Photovoltaikanlagen noch die Mehrwertsteuer?",
    answer: "Nein. Seit dem 1. Januar 2023 gilt nach dem Jahressteuergesetz (JStG 2022) ein Nullsteuersatz (0 % Mehrwertsteuer) auf den Kauf und die Installation von PV-Anlagen und Batteriespeichern für private Wohngebäude."
  },
  {
    question: "Wie groß sollte der Batteriespeicher für ein Einfamilienhaus sein?",
    answer: "Faustregel: 1 kWh nutzbare Speicherkapazität pro 1 kWp PV-Leistung bzw. pro 1.000 kWh Jahresstromverbrauch. Für eine 10-kWp-Anlage mit 4.000 kWh Haushaltsstrom + E-Auto ist ein Speicher mit 8 bis 10 kWh ideal."
  },
  {
    question: "Wie berechnet man die Ersparnis durch PV-Eigenverbrauch mathematisch?",
    answer: "Formel: (Erzeugter PV-Strom in kWh × Eigenverbrauchsanteil × [Netzstrompreis - Gestehungskosten]) + (Einspeisestrom in kWh × Einspeisevergütung) = Jährlicher Gesamtertrag in Euro."
  },
  {
    question: "Muss man auf selbst verbrauchten Solarstrom Steuern oder EEG-Umlage zahlen?",
    answer: "Nein. Die EEG-Umlage auf Eigenverbrauch wurde komplett abgeschafft. Zudem sind private PV-Anlagen bis 30 kWp von der Einkommensteuer auf Einspeiseerträge und Eigenverbrauch dauerhaft befreit."
  },
  {
    question: "Wie viel Ersparnis bringt ein E-Auto oder eine Wärmepumpe bei der PV-Anlage?",
    answer: "Mit Sektorkopplung (E-Auto + Wärmepumpe) steigt der Gesamteigenverbrauch einer 10-kWp-Anlage von ca. 3.000 kWh auf bis zu 5.500–7.000 kWh pro Jahr. Die jährliche Ersparnis gegenüber Netzbezug steigt von ca. 900 Euro auf über 1.800 Euro."
  },
  {
    question: "Wie lange halten moderne PV-Module und Batteriespeicher?",
    answer: "Moderne Glas-Glas-Solarmodule haben Leistungsgarantien von 25 bis 30 Jahren (nach 30 Jahren meist noch über 85 % Leistung). Lithium-Eisenphosphat-Batteriespeicher (LFP) erreichen 6.000 bis 10.000 Ladezyklen, was einer Lebensdauer von 15 bis 20 Jahren entspricht."
  }
];

const calcSchema = getCalculatorSchema(
  'Photovoltaik Eigenverbrauch & Solar-Ersparnis Rechner',
  'Berechne den Eigenverbrauchsanteil, die Einspeisevergütung und die Stromkostenersparnis deiner Dachanlage mit und ohne Batteriespeicher.',
  '/photovoltaik/eigenverbrauch-rechner'
);
const faqSchema = getFaqSchema(faqs);
const pageSchemas = faqSchema ? [calcSchema, faqSchema] : [calcSchema];

const related = [
  { title: 'Balkonkraftwerk Ersparnis', href: '/balkonkraftwerk/stromkosten-sparen', description: 'Steckersolar für Balkon & Terrasse.' },
  { title: 'Wärmepumpe Stromkosten', href: '/waermepumpe/stromkosten', description: 'Heizstrom mit PV kombinieren.' },
  { title: 'E-Auto Ladekosten Rechner', href: '/e-auto/ladekosten-rechner', description: 'Solarstrom ins E-Auto laden.' },
  { title: 'Dynamische Stromtarife', href: '/dynamische-stromtarife', description: 'Börsenpreise & Speicher.' },
];
---

<BaseLayout
  title="Photovoltaik Eigenverbrauch Rechner: Solarstrom & Ersparnis berechnen | kWhKlar"
  description="Berechne Eigenverbrauchsquote, Ersparnis durch Solarstrom und Einspeisevergütung für deine PV-Anlage mit und ohne Stromspeicher mit Online-Rechner."
  canonical="https://kwhklar.de/photovoltaik/eigenverbrauch-rechner"
  jsonLd={pageSchemas}
  breadcrumbs={[
    { name: 'Solar', path: '/balkonkraftwerk/stromkosten-sparen' },
    { name: 'PV Eigenverbrauch Rechner', path: '/photovoltaik/eigenverbrauch-rechner' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Solar & Photovoltaik', path: '/balkonkraftwerk/stromkosten-sparen' },
        { name: 'PV Eigenverbrauch Rechner', path: '/photovoltaik/eigenverbrauch-rechner' },
      ]}
    />

    <div class="max-w-4xl mb-8">
      <span class="badge-emerald text-xs mb-2">Photovoltaik &amp; Speicher</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        PV Eigenverbrauch &amp; Solar-Ersparnis berechnen
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Finde heraus, wie viel teuren Netzstrom du durch deine Dachanlage einsparst und welche Gesamterträge aus Eigenverbrauch und gesetzlicher EEG-Einspeisevergütung entstehen.
      </p>
    </div>

    <!-- PV Rooftop Calculator -->
    <div class="my-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-md max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">Eckdaten deiner PV-Anlage</h2>

          <div>
            <label for="rooftop-kwp" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
              Anlagengröße (kWp)
            </label>
            <input
              type="number"
              id="rooftop-kwp"
              value="10.0"
              min="1"
              max="50"
              step="0.5"
              class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-base font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
            />
            <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 block">Typisches Einfamilienhaus: 8 bis 15 kWp (~8.000–15.000 kWh/Jahr)</span>
          </div>

          <div>
            <label for="rooftop-battery" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
              Batteriespeicher vorhanden?
            </label>
            <select id="rooftop-battery" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-sm font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20">
              <option value="yes" selected>Ja, mit Batteriespeicher (~70 % Eigenverbrauch)</option>
              <option value="no">Nein, ohne Speicher (~30 % Eigenverbrauch)</option>
            </select>
          </div>

          <div>
            <label for="rooftop-price" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
              Aktueller Netzstrompreis (ct/kWh)
            </label>
            <input
              type="number"
              id="rooftop-price"
              value="35.0"
              min="10"
              step="0.5"
              class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-base font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
            />
          </div>
        </div>

        <!-- PV Rooftop Results Display -->
        <div class="rounded-2xl bg-gradient-to-br from-emerald-600 via-teal-700 to-slate-900 p-6 text-white space-y-4 shadow-md">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-200 block">Berechneter Jahresertrag</span>
          <div>
            <span class="text-xs text-emerald-200 block">Geschätzte Solar-Erzeugung</span>
            <span class="text-3xl font-black text-white" id="pv-res-prod">10.000 kWh</span>
          </div>
          <div class="border-t border-emerald-500/40 pt-3">
            <span class="text-xs text-emerald-200 block">Direkter Eigenverbrauch im Haushalt</span>
            <span class="text-2xl font-extrabold text-emerald-100" id="pv-res-self">7.000 kWh (70 %)</span>
          </div>
          <div class="border-t border-emerald-500/40 pt-3">
            <span class="text-xs text-emerald-200 block">Eingesparte Strombezugskosten</span>
            <span class="text-2xl font-bold text-white" id="pv-res-save">2.450,00 €</span>
          </div>
          <div class="border-t border-emerald-500/40 pt-3 text-xs text-emerald-100">
            Zusätzliche EEG-Einspeisevergütung: <strong class="text-white" id="pv-res-feedin">237,00 €</strong><br />
            Gesamtertrag pro Jahr: <strong class="text-emerald-300 text-sm" id="pv-res-total">2.687,00 €</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Editorial Content Depth -->
    <div class="my-12 grid grid-cols-1 lg:grid-cols-12 gap-8">
      <article class="lg:col-span-8 space-y-10">
        
        <!-- FAQ Section -->
        <FaqSection items={faqs} />
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-900 p-6 text-white shadow-md">
          <h3 class="font-bold text-emerald-400 text-sm uppercase tracking-wider mb-3">
            0 % Mehrwertsteuer
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Seit 2023 gilt für private Solaranlagen und Batteriespeicher bis 30 kWp der <strong>Nullsteuersatz</strong> (0 % MwSt.).
          </p>
        </div>

        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
          <h3 class="font-bold text-slate-900 dark:text-white text-sm mb-4">Verwandte Ratgeber</h3>
          <ul class="space-y-2 text-xs">
            <li><a href="/balkonkraftwerk/stromkosten-sparen" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Balkonkraftwerk Strom sparen</a></li>
            <li><a href="/e-auto/ladekosten-rechner" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ E-Auto Solar-Ladekosten</a></li>
            <li><a href="/waermepumpe/stromverbrauch-rechner" class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium block">→ Wärmepumpe mit PV betreiben</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['bnetza', 'uba', 'destatis']} />
  </div>
</BaseLayout>

<script>
  const inKwp = document.getElementById('rooftop-kwp') as HTMLInputElement | null;
  const inBattery = document.getElementById('rooftop-battery') as HTMLSelectElement | null;
  const inPrice = document.getElementById('rooftop-price') as HTMLInputElement | null;

  const resProd = document.getElementById('pv-res-prod');
  const resSelf = document.getElementById('pv-res-self');
  const resSave = document.getElementById('pv-res-save');
  const resFeedin = document.getElementById('pv-res-feedin');
  const resTotal = document.getElementById('pv-res-total');

  function calculate() {
    if (!inKwp || !inBattery || !inPrice || !resProd || !resSelf || !resSave || !resFeedin || !resTotal) return;

    const kwp = parseFloat(inKwp.value) || 0;
    const hasBattery = inBattery.value === 'yes';
    const priceCt = parseFloat(inPrice.value) || 0;

    const totalProdKwh = kwp * 1000;
    const selfShare = hasBattery ? 0.70 : 0.30;
    const selfKwh = totalProdKwh * selfShare;
    const feedinKwh = totalProdKwh - selfKwh;

    const savedGridCost = (selfKwh * priceCt) / 100;
    const feedinRevenue = (feedinKwh * 7.9) / 100;
    const totalBenefit = savedGridCost + feedinRevenue;

    resProd.textContent = Math.round(totalProdKwh).toLocaleString('de-DE') + ' kWh';
    resSelf.textContent = `${Math.round(selfKwh).toLocaleString('de-DE')} kWh (${Math.round(selfShare * 100)} %)`;
    resSave.textContent = savedGridCost.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    resFeedin.textContent = feedinRevenue.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    resTotal.textContent = totalBenefit.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
  }

  inKwp?.addEventListener('input', calculate);
  inBattery?.addEventListener('change', calculate);
  inPrice?.addEventListener('input', calculate);
</script>
