---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../components/seo/RelatedLinks.astro';
import SourceBox from '../components/trust/SourceBox.astro';
import FaqSection from '../components/content/FaqSection.astro';

const faqs = [
  {
    question: 'Welche Maßnahmen senken den Stromverbrauch am schnellsten?',
    answer: '1. Warmwassertemperatur an Durchlauferhitzern auf 38–40 °C begrenzen. 2. Kühlschrank auf 7 °C statt 4 °C stellen. 3. Wäsche bei 30 °C statt 60 °C waschen. 4. Standby-Geräte an schaltbare Steckerleisten hängen. Diese Maßnahmen kosten 0 € und sparen sofort ca. 100 bis 200 € im Jahr.',
  },
];

const related = [
  { title: 'Strom sparen Tipps', href: '/strom-sparen-tipps', description: 'Konkrete Spartipps.' },
  { title: 'Die größten Stromfresser', href: '/stromfresser', description: 'Großgeräte im Fokus.' },
  { title: 'Balkonkraftwerk', href: '/balkonkraftwerk/stromkosten-sparen', description: 'Eigenstrom erzeugen.' },
];
---

<BaseLayout
  title="Stromverbrauch senken: 7 wirksame Maßnahmen für den Haushalt | kWhKlar"
  description="Systematisch den Stromverbrauch senken: Von Sofortmaßnahmen ohne Kosten bis hin zu lohnenden Geräte-Neuanschaffungen und Steckersolar."
  canonical="https://kwhklar.de/stromverbrauch-senken"
  breadcrumbs={[
    { name: 'Sparen', path: '/strom-sparen' },
    { name: 'Stromverbrauch senken', path: '/stromverbrauch-senken' },
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { name: 'Strom sparen', path: '/strom-sparen' },
        { name: 'Stromverbrauch senken', path: '/stromverbrauch-senken' },
      ]}
    />

    <div class="max-w-3xl mb-8">
      <span class="badge-emerald text-xs mb-2">Effizienz-Plan</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Stromverbrauch dauerhaft & systematisch senken
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        So reduzierst du deinen Stromverbrauch strukturiert – aufgeteilt in kostenlose Sofortmaßnahmen, Verhaltensoptimierung und lohnende Investitionen.
      </p>
    </div>

    <article class="prose prose-slate max-w-4xl my-8 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200">
      <h2 class="text-2xl font-bold text-slate-900">3 Stufen zur Verbrauchsreduktion</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-6 text-xs sm:text-sm">
        <div class="rounded-2xl bg-emerald-50/70 p-5 border border-emerald-200">
          <strong class="text-emerald-950 font-bold text-base block mb-2">Stufe 1: 0-Euro-Maßnahmen</strong>
          <ul class="space-y-1.5 text-slate-700">
            <li>• Kühlschrank auf 7 °C stellen</li>
            <li>• Waschtemperatur auf 30 °C senken</li>
            <li>• Spülmaschine voll beladen im Eco-Modus</li>
            <li>• Topfdeckel beim Kochen nutzen</li>
          </ul>
        </div>

        <div class="rounded-2xl bg-blue-50/70 p-5 border border-blue-200">
          <strong class="text-blue-950 font-bold text-base mb-2">Stufe 2: Geringe Investition (&lt; 50 €)</strong>
          <ul class="space-y-1.5 text-slate-700">
            <li>• Schaltbare Steckdosenleisten</li>
            <li>• Sparsamer Sparduschkopf</li>
            <li>• LED-Leuchtmittel einsetzen</li>
            <li>• Zeitschaltuhren für Router/Standby</li>
          </ul>
        </div>

        <div class="rounded-2xl bg-purple-50/70 p-5 border border-purple-200">
          <strong class="text-purple-950 font-bold text-base mb-2">Stufe 3: Großinvestition & Eigenstrom</strong>
          <ul class="space-y-1.5 text-slate-700">
            <li>• Balkonkraftwerk (Steckersolar)</li>
            <li>• Neuer A-Klasse Kühlschrank</li>
            <li>• Wärmepumpentrockner</li>
            <li>• Inverter-Klimaanlage</li>
          </ul>
        </div>
      </div>
    </article>

    <RelatedLinks links={related} />
    <SourceBox sourceIds={['stromspiegel', 'uba']} />
    <FaqSection items={faqs} />
  </div>
</BaseLayout>
